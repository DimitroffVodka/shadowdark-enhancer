# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Build artifacts (none for MVP, but reserve)
dist/
*.tgz
*.zip

# Node (in case we add tooling later)
# No trailing slash on purpose: `node_modules/` matches a directory only, and a
# git worktree has no node_modules of its own, so anyone running ./verify.sh
# there (it looks for node_modules/.bin/eslint at a relative path) tends to
# symlink one — which the slashed form does NOT ignore, and `git add -A` then
# commits as an absolute path pointing at one machine.
node_modules
package-lock.json

# Local development
*.log

# Local working data — never committed. Nothing under data/ has ever been
# tracked, and two things in here must not be:
#   monster-art-mapping.json  generated + install-specific (references the
#     user's own locally-installed art module; regenerated by the Monster Art
#     tool).
#   bestiary-reference.json   a third-party scrape whose entries carry verbatim
#     statblock text. This repo publishes only names, source/page citations,
#     formulas, and parsing structure — no rules text — so it stays local.
data/

# Foundry's persistent-storage folder (manifest: persistentStorage). Written at
# runtime and deliberately preserved across module updates — this is where the
# generated monster-art mapping now lives. Same reason as data/: install-specific,
# never committed. Foundry's installer creates it; the module creates it too when
# the install is manual or symlinked.
storage/

# Claude Code per-project state (session/cache — never commit)
.claude/

# Command Code per-project state — a machine-local permissions allowlist and
# its "taste" preference notes. Same category as .claude/ and .repowise/:
# generated by a local tool, specific to one install, nothing another clone of
# this repo can use.
.commandcode/

# Repowise's local index (wiki.db + WAL/SHM, the *.pkl parse/duplication caches,
# knowledge-graph.json, sessions/sessions.db). Machine-local and rebuildable, and
# the sqlite WAL/SHM files are live handles — committing them is meaningless and
# they are large and constantly rewritten. This ignores only the LOCAL cache; the
# Repowise PR review comments come from the server-side integration and are
# unaffected. Added after a `git add -A` during a conflict resolution swept all
# ten files into a commit.
.repowise/

# Playwright MCP scratch output
.playwright-mcp/

# docs/ tracks only the published manual (wiki/), API.md, and the generated
# FILE-INVENTORY.md. Internal audits, review reports, sweep dumps, the promo
# plan and superpowers plans/specs stay local — never tracked, never shipped.
docs/*
!docs/wiki/
!docs/API.md
!docs/FILE-INVENTORY.md

<div class="ui-shell sde-maps">

  <header class="ui-head">
    <div class="ui-head-text">
      <h2 class="ui-title">{{localize "SDE.importer.maps.title"}}</h2>
      <p class="ui-sub">{{localize "SDE.importer.maps.sub"}}</p>
    </div>
  </header>

  <div class="ui-body">
    {{#unless canUpload}}<div class="ui-note warn"><p><i class="fas fa-circle-info"></i> {{localize "SDE.importer.maps.noUpload"}}</p></div>{{/unless}}
    {{#each groups}}
    <section class="ui-group">
      <h3 class="ui-h">{{title}}</h3>
      <ul class="ui-list">
        {{#each rows}}
        <li class="ui-row sde-maps-row">
          <span class="ui-row-main">
            <span class="ui-row-name">{{title}}</span>
            <span class="ui-row-sub">{{kind}}{{#if line}} · {{line}}{{/if}}</span>
          </span>
          {{#if busy}}<span class="ui-muted"><i class="fas fa-circle-notch fa-spin"></i></span>
          {{else if world}}
          <span class="ui-chip ok"><i class="fas fa-check"></i> {{localize "SDE.importer.maps.inWorld"}}</span>
          {{#if terrain}}<button type="button" class="ui-btn" data-action="terrain" data-id="{{id}}" {{#if locked}}disabled{{/if}} data-tooltip="{{localize "SDE.importer.maps.terrainTip"}}"><i class="fas fa-palette"></i> {{localize "SDE.importer.maps.terrain"}}</button>{{/if}}
          {{#if viewScene}}<button type="button" class="ui-btn" data-action="view" data-scene="{{viewScene}}">{{localize "SDE.importer.maps.view"}}</button>{{/if}}
          {{else if load}}
          <button type="button" class="ui-btn" data-action="load" data-id="{{id}}" {{#if locked}}disabled{{/if}}>{{localize "SDE.importer.maps.load"}}</button>
          {{else if add}}
          <button type="button" class="ui-btn" data-action="addFile" data-id="{{id}}" {{#if locked}}disabled{{/if}}{{#if noUpload}} disabled{{/if}}><i class="fas fa-file-image"></i> {{localize "SDE.importer.maps.addFile"}}</button>
          {{/if}}
        </li>
        {{/each}}
      </ul>
    </section>
    {{/each}}
  </div>

  <footer class="ui-footer">
    <span class="ui-right">
      <button type="button" class="ui-btn ghost" data-action="advanced">{{localize "SDE.importer.maps.advanced"}} <i class="fas fa-chevron-right"></i></button>
    </span>
  </footer>
</div>

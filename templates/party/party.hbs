{{!-- Ported from the existing ApplicationV2 Party sheet, not a replacement design. --}}
<div class="sde-party-body flexcol" data-tokenizer-skip="true">
{{#if picker}}<div class="sde-party-picker"><select data-party-choice aria-label="{{localize 'SDE.party.choose'}}"><option value="">{{localize "SDE.party.choose"}}</option>{{#each parties}}<option value="{{uuid}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select>{{#if isGM}}<button type="button" data-action="create">{{localize "SDE.party.create"}}</button>{{/if}}</div>{{/if}}
{{#if hasParty}}
	<header class="sdp-head">
		<span class="sdp-emblem sdp-emblem-img"><img src="{{actor.img}}" alt="" {{#if canEdit}}data-action="editImage" data-edit="img" data-tooltip="{{actor.name}}"{{/if}}></span>
		<div class="sdp-id">
			<input name="name" type="text" value="{{actor.name}}" placeholder="{{localize 'SDE.party.sheet.extras.name_placeholder'}}" aria-label="{{localize 'SDE.party.sheet.extras.name_placeholder'}}" {{#unless canEdit}}readonly{{/unless}}>
			<div class="sdp-stats">
				<span data-tooltip="{{localize 'SDE.party.sheet.extras.tab.members'}}"><i class="fas fa-users"></i>{{memberCount}}</span>
				<span data-tooltip="{{localize 'SDE.party.sheet.hp'}}"><i class="fas fa-heart"></i>{{partyStats.totalHp}}<small>/{{partyStats.maxHp}}</small></span>
				<span data-tooltip="{{localize 'SDE.party.sheet.ac'}}"><i class="fas fa-shield-halved"></i>{{partyStats.avgAc}}</span>
				<span data-tooltip="{{localize 'SHADOWDARK.sheet.player.level.label'}}"><i class="fas fa-star"></i>{{partyStats.avgLevel}}</span>
			</div>
		</div>
		<div class="sdp-march {{#unless followLeader}}off{{/unless}}">
			<div class="sdp-ctl">
				<label class="sdp-switch" data-tooltip="{{localize 'SDE.party.movement.follow'}}"><input type="checkbox" data-movement-setting="followLeader" {{#if followLeader}}checked{{/if}} {{#unless canEdit}}disabled{{/unless}}><span class="track"></span><span>{{localize "SDE.party.movement.marchingOrder"}}</span></label>
				<div class="sdp-status {{#if march.warn}}warn{{/if}}" role="status"><i class="dot"></i><span>{{march.text}}</span>{{#if canResume}}<button type="button" class="sdp-mini" data-action="resumeFollow">{{localize "SDE.party.movement.resume"}}</button>{{/if}}</div>
			</div>
			<div class="sdp-gridwrap" {{#unless members.length}}{{#if canEdit}}data-drop-members{{/if}}{{/unless}}>
				<div class="sdp-grid" aria-label="{{localize 'SDE.party.movement.marchingOrder'}}">{{#each slots}}<button type="button" class="sdp-slot{{#if leader}} leader{{/if}}" data-formation-slot data-row="{{row}}" data-col="{{col}}" data-uuid="{{uuid}}" {{#if uuid}}data-action="leader" draggable="true"{{/if}} {{#if disabled}}disabled{{/if}} title="{{name}}" aria-label="{{#if name}}{{name}}{{else}}{{localize 'SDE.party.movement.emptySlot'}}{{/if}}">{{#if img}}<img src="{{img}}" alt="">{{/if}}</button>{{/each}}</div>
				{{#if members.length}}{{#if canEdit}}<small class="sdp-caption">{{localize "SDE.party.movement.dragHint"}}<br>{{localize "SDE.party.movement.leadHint"}}</small>{{/if}}{{else}}{{#if canEdit}}<small class="sdp-caption">{{localize "SDE.party.movement.dropHint"}}</small>{{/if}}{{/if}}
			</div>
			{{#if canEdit}}<button type="button" class="sdp-pin" data-action="placeRecall" {{#if movementDisabled}}disabled{{/if}} title="{{movementReason}}" aria-label="{{localize 'SDE.party.movement.placeRecall'}}"><i class="fas fa-location-dot"></i></button>{{/if}}
		</div>
	</header>
<nav class="sdp-tabs" role="tablist">{{#each tabs}}<a class="sdp-tab {{#if active}}active{{/if}}" data-action="partyTab" data-tab="{{key}}" role="tab" aria-selected="{{#if active}}true{{else}}false{{/if}}" tabindex="0"><i class="{{icon}}"></i>{{label}}</a>{{/each}}</nav>
<section class="SD-content-body sdp-body flex1">
{{#if unsupported}}<p>{{localize "SDE.party.sdxNotAdopted"}}</p>{{else}}{{#if unknown}}<p>{{localize "SDE.party.unknownRoster"}}</p>{{else}}
{{#if needsAdoption}}<button type="button" data-action="adopt">{{localize "SDE.party.adopt"}}</button>{{/if}}
{{#if formationReview}}<p>{{localize "SDE.party.movement.review"}}</p>{{/if}}
<div class="tab tab-members {{#if membersTab}}active{{/if}}">
<div class="members-list">{{#each groups}}{{#if rows.length}}<h3 class="sdp-group">{{label}}</h3><div class="sdp-cards">{{#each rows as |member|}}
<article class="sdp-card{{#if member.missing}} missing{{/if}}" data-uuid="{{member.uuid}}" data-member-id="{{member.memberKey}}">
	<img class="sdp-face" src="{{member.img}}" alt="" data-action="member" data-uuid="{{member.uuid}}">
	<div class="sdp-main">
		<div class="sdp-line"><a class="sdp-name" data-action="member" data-uuid="{{member.uuid}}">{{member.name}}</a>{{#if member.className}}<em>{{member.className}}</em>{{/if}}{{#each member.effects as |effect|}}<img class="sdp-fx" src="{{effect.img}}" alt="{{effect.name}}" data-tooltip="{{effect.name}}">{{/each}}</div>
		{{#unless member.missing}}
		<div class="sdp-hp" data-tooltip="{{localize 'SDE.party.sheet.hp'}}"><div class="sdp-hpbar" style="width: {{member.hpPercent}}%"></div><span>{{member.hp.value}} / {{member.hp.max}}</span></div>
		<div class="sdp-chips"><span><b>{{localize "SDE.party.sheet.ac"}}</b> {{member.ac}}</span>{{#unless member.isNPC}}<span><b>{{localize "SDE.party.sheet.level"}}</b> {{member.level}}</span><span data-tooltip="{{localize 'SHADOWDARK.inventory.slots'}}"><b>{{localize "SDE.party.sheet.slots"}}</b> {{member.slots.used}}/{{member.slots.max}}</span><span><b>{{localize "SDE.party.sheet.xp"}}</b> {{member.xp.current}}/{{member.xp.next}}</span>{{/unless}}</div>
		{{#if member.showAbilities}}<div class="sdp-abil">
			<span data-tooltip="{{localize 'SHADOWDARK.ability.str.long'}}">{{localize "SDE.party.sheet.str"}} <b>{{member.abilityLabels.str}}</b></span>
			<span data-tooltip="{{localize 'SHADOWDARK.ability.dex.long'}}">{{localize "SDE.party.sheet.dex"}} <b>{{member.abilityLabels.dex}}</b></span>
			<span data-tooltip="{{localize 'SHADOWDARK.ability.con.long'}}">{{localize "SDE.party.sheet.con"}} <b>{{member.abilityLabels.con}}</b></span>
			<span data-tooltip="{{localize 'SHADOWDARK.ability.int.long'}}">{{localize "SDE.party.sheet.int"}} <b>{{member.abilityLabels.int}}</b></span>
			<span data-tooltip="{{localize 'SHADOWDARK.ability.wis.long'}}">{{localize "SDE.party.sheet.wis"}} <b>{{member.abilityLabels.wis}}</b></span>
			<span data-tooltip="{{localize 'SHADOWDARK.ability.cha.long'}}">{{localize "SDE.party.sheet.cha"}} <b>{{member.abilityLabels.cha}}</b></span>
		</div>{{/if}}
		{{/unless}}
	</div>
	{{#if member.canEdit}}<a class="sdp-remove" data-action="remove" data-uuid="{{member.uuid}}" data-tooltip="{{localize 'SDE.party.sheet.extras.remove_member'}}" aria-label="{{localize 'SDE.party.sheet.extras.remove_member'}}"><i class="fas fa-times"></i></a>{{/if}}
</article>{{/each}}</div>{{/if}}{{/each}}{{#unless members.length}}<div class="sdp-empty {{#if canEdit}}drop{{/if}}"><i class="fas fa-users"></i><p>{{#if canEdit}}{{localize "SDE.party.sheet.dropMembers"}}{{else}}{{localize "SDE.party.noMembers"}}{{/if}}</p></div>{{/unless}}</div>
</div>
<div class="tab tab-inventory {{#if itemsTab}}active{{/if}}"><div class="inventory-grid"><div class="inventory-main"><div class="SD-box"><div class="header"><label>{{#if canEdit}}<a class="fa-solid fa-square-plus" data-action="createItem" title="{{localize 'SDE.party.sheet.newItem'}}"></a>{{/if}}{{localize "SDE.party.items"}}</label><span>{{localize "SDE.party.sheet.slots"}}: {{inventorySlots.used}} / {{inventorySlots.max}}</span></div><div class="content"><ol class="SD-list item-list party-item-list"><li class="header"><div class="item-name">{{localize "SDE.party.sheet.itemName"}}</div><div class="quantity">{{localize "SDE.party.sheet.quantity"}}</div><div class="slots-cost">{{localize "SDE.party.sheet.slots"}}</div><div class="actions"></div></li>
{{#each items}}<li class="item" data-item-id="{{id}}"><img class="item-image" src="{{img}}" alt=""><a class="item-name" data-action="item" data-id="{{id}}">{{name}}</a><div class="quantity">{{#if ../canEdit}}<a data-action="quantity" data-id="{{id}}" data-delta="-1" aria-label="{{localize 'SDE.party.sheet.decrease'}}"><i class="fas fa-minus"></i></a>{{/if}}{{quantity}}{{#if ../canEdit}}<a data-action="quantity" data-id="{{id}}" data-delta="1" aria-label="{{localize 'SDE.party.sheet.increase'}}"><i class="fas fa-plus"></i></a>{{/if}}</div><div class="slots-cost">{{slots}}</div><div class="actions"></div></li>{{else}}<li class="empty-list">{{localize "SDE.party.empty"}}</li>{{/each}}
</ol></div></div></div><div class="inventory-sidebar"><div class="SD-box"><div class="header"><label>{{localize "SDE.party.sheet.treasury"}}</label></div><div class="content"><div class="party-coins-grid">{{#each coins as |value key|}}<label>{{localize (lookup ../coinLabels key)}}</label><input type="number" class="coin-value" data-coin="{{key}}" value="{{value}}" min="0" aria-label="{{localize (lookup ../coinLabels key)}}" {{#unless ../canEdit}}disabled{{/unless}}>{{/each}}</div></div></div></div></div></div>
{{#if isGM}}<div class="tab tab-travel {{#if travelTab}}active{{/if}}"><div class="party-actions sde-party-activities"><button type="button" data-action="camp" aria-pressed="{{campingActive}}"><i class="fas fa-campground"></i> {{localize "SDE.camping.title"}}</button><button type="button" data-action="carouse" aria-pressed="{{carousingActive}}"><i class="fas fa-beer-mug-empty"></i> {{localize "SDE.carousing.title"}}</button></div>{{{activityHTML}}}</div>{{/if}}
<div class="tab tab-quests {{#if questsTab}}active{{/if}}">{{{questHTML}}}</div>
<div class="tab tab-description {{#if descriptionTab}}active{{/if}}"><div class="SD-box description-box"><div class="header"><label>{{localize "SDE.party.sheet.description"}}</label>{{#if canEdit}}<button type="button" data-action="editDescription" title="{{localize 'SDE.party.sheet.edit'}}"><i class="fas fa-edit"></i> {{localize "SDE.party.sheet.edit"}}</button>{{/if}}</div><div class="content description-content">{{#if editingDescription}}<textarea data-party-description rows="8" aria-label="{{localize 'SDE.party.sheet.description'}}">{{description}}</textarea><div class="party-actions"><button type="button" data-action="saveDescription">{{localize "SDE.party.sheet.save"}}</button><button type="button" data-action="cancelDescription">{{localize "SDE.camping.cancel"}}</button></div>{{else}}{{#if descriptionHTML}}{{{descriptionHTML}}}{{else}}<p class="empty-description">{{localize "SDE.party.sheet.noDescription"}}</p>{{/if}}{{/if}}</div></div></div>
{{/if}}{{/if}}</section>{{else}}<p>{{localize "SDE.party.choose"}}</p>{{/if}}</div>

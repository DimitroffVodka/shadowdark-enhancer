<div class="sde-thub sde-importer-hub sde-hub-import" id="sde-hub-import">

  {{!-- ═══ Type selector — the single "what am I importing" control ═══ --}}
  <div class="sde-hub-import-typebar">
    <label for="sde-hub-import-type"><i class="fas fa-filter"></i> {{localize "SDE.importer.type.importing"}}</label>
    <select id="sde-hub-import-type" data-import-type class="sde-hub-import-type-sel" aria-label="{{localize 'SDE.importer.type.aria'}}">
      {{#each importData.typeGroups as |g|}}<optgroup label="{{g.group}}">{{#each g.options as |o|}}<option value="{{o.value}}" {{#if o.selected}}selected{{/if}}>{{o.label}}</option>{{/each}}</optgroup>{{/each}}
    </select>
    {{#if importData.showItemSubtype}}
    <label for="sde-hub-import-subtype" class="sde-hub-import-subtype-label">{{localize "SDE.importer.type.itemType"}}</label>
    <select id="sde-hub-import-subtype" data-import-subtype class="sde-hub-import-type-sel" aria-label="{{localize 'SDE.importer.type.itemTypeAria'}}">
      {{#each importData.itemSubtypeOptions as |o|}}<option value="{{o.value}}" {{#if o.selected}}selected{{/if}}>{{o.label}}</option>{{/each}}
    </select>
    {{/if}}
    {{#if importData.showGenSpec}}
    <label for="sde-hub-import-genspec" class="sde-hub-import-subtype-label"
           data-tooltip="{{localize 'SDE.importer.type.diceTip'}}" data-tooltip-direction="UP">{{localize "SDE.importer.type.dice"}}</label>
    <input id="sde-hub-import-genspec" type="text" data-gen-spec value="{{importData.genSpec}}"
           placeholder="{{localize 'SDE.importer.type.dicePlaceholder'}}" class="sde-hub-import-type-sel sde-hub-import-genspec-input" aria-label="{{localize 'SDE.importer.type.diceAria'}}">
    {{/if}}
  </div>

  {{!-- Seed hint: shown when a Manage-strip "Seed" click pre-filled this box --}}
  {{#if importData.seed}}
  <div class="sde-hub-import-seed">
    <i class="fas fa-bullseye"></i>
    {{localize "SDE.importer.seed.pastingFor"}} <strong>{{importData.seed.name}}</strong>
    {{#if importData.seed.book}}<span class="sde-hub-import-seed-tag"><i class="fas fa-book"></i> {{importData.seed.book}}{{#if importData.seed.page}}{{localize "SDE.importer.seed.page" page=importData.seed.page}}{{/if}}</span>{{/if}}
    {{#if importData.seed.die}}<span class="sde-hub-import-seed-tag">{{importData.seed.die}}</span>{{/if}}
    {{#if importData.seedPdfHref}}<button type="button" data-action="openSourcePdf" data-href="{{importData.seedPdfHref}}" class="sde-hub-import-pdfbtn" title="{{localize 'SDE.importer.seed.openPdfTip'}}"><i class="fas fa-file-pdf"></i> {{localize "SDE.importer.seed.openPdf"}}{{#if importData.seed.page}}{{localize "SDE.importer.seed.atPage" page=importData.seed.page}}{{/if}}</button>
    <button type="button" data-action="hubGrabPdfText" class="sde-hub-import-pdfbtn" title="{{localize 'SDE.importer.seed.grabTextTip'}}"><i class="fas fa-wand-magic-sparkles"></i> {{localize "SDE.importer.seed.grabText"}}{{#if importData.seed.page}}{{localize "SDE.importer.seed.atPage" page=importData.seed.page}}{{/if}}</button>
    {{else}}<button type="button" data-action="hubExtractPdf" class="sde-hub-import-pdfbtn" title="{{localize 'SDE.importer.seed.grabFromPdfTip'}}"><i class="fas fa-wand-magic-sparkles"></i> {{localize "SDE.importer.seed.grabFromPdf"}}</button>{{/if}}
    {{#unless importData.seedResult}}{{localize "SDE.importer.seed.thenParse"}}{{/unless}}
    {{#if importData.seedResult}}
    {{#if importData.seedResult.ok}}
    <span class="sde-thub-stat ok"><i class="fas fa-circle-check"></i>
      {{localize "SDE.importer.seed.parsedOk" name=importData.seedResult.name rows=importData.seedResult.rows formula=importData.seedResult.formula}}</span>
    {{else}}
    <span class="sde-thub-stat miss"><i class="fas fa-triangle-exclamation"></i>
      {{localize "SDE.importer.seed.parsedBad" rows=importData.seedResult.rows formula=importData.seedResult.formula name=importData.seedResult.name}}
      {{#if importData.seedResult.problem}}{{localize "SDE.importer.seed.parsedProblem" problem=importData.seedResult.problem}}
      {{else}}{{localize "SDE.importer.seed.parsedExpected" expected=importData.seedResult.expected}}{{/if}}</span>
    {{/if}}
    {{/if}}
  </div>
  {{/if}}

  {{!-- Paste box --}}
  <label class="sde-hub-import-label" for="sde-hub-import-text">
    {{localize "SDE.importer.paste.label"}}
  </label>
  <textarea id="sde-hub-import-text" data-import-text rows="6" class="sde-hub-import-text"
            placeholder="{{importData.formatExample}}">{{importData.text}}</textarea>

  {{!-- Source label — which book this content is from (folder + per-doc tag) --}}
  <div class="sde-hub-import-sourcebar">
    <label for="sde-hub-import-source"><i class="fas fa-folder-tree"></i> {{localize "SDE.importer.source.label"}}</label>
    <select id="sde-hub-import-source" data-import-source
            class="sde-hub-import-source-input" aria-label="{{localize 'SDE.importer.source.aria'}}">
      {{#each importData.sourceOptions as |o|}}<option value="{{o.value}}" {{#if o.selected}}selected{{/if}}>{{o.label}}</option>{{/each}}
    </select>
  </div>

  {{!-- Controls: Parse / Clear / Import all + a Tools menu for everything else --}}
  <div class="sde-hub-import-controls">
    <button type="button" data-action="hubParse" class="sde-import-primary"><i class="fas fa-wand-magic"></i> {{localize "SDE.importer.btn.parse"}}</button>
    <button type="button" data-action="hubClear" class="sde-import-secondary"><i class="fas fa-eraser"></i> {{localize "SDE.importer.btn.clear"}}</button>
    {{#if importData.showImportAll}}
    <button type="button" data-action="hubCommitAll" class="sde-import-primary">
      <i class="fas fa-file-import"></i> {{localize "SDE.importer.btn.importAll"}}
    </button>
    {{/if}}

    {{!-- Tools: the power-user / one-time-setup actions, tucked away --}}
    <details class="sde-hub-tools">
      <summary class="sde-import-secondary"><i class="fas fa-toolbox"></i> {{localize "SDE.importer.btn.tools"}}</summary>
      {{!-- Two groups: working with your book PDFs, then whole-suite backup. --}}
      <div class="sde-hub-tools-menu" popover="manual">
        <div class="sde-hub-tools-group">
          <button type="button" data-action="hubManageSourcePdfs"
                  title="{{localize 'SDE.importer.tools.sourcePdfsTip'}}">
            <i class="fas fa-file-pdf"></i><span>{{localize "SDE.importer.tools.sourcePdfs"}}</span><small>{{localize "SDE.importer.tools.sourcePdfsSub"}}</small></button>
          <button type="button" data-action="hubExtractPdf"
                  title="{{localize 'SDE.importer.tools.extractTip'}}">
            <i class="fas fa-wand-magic-sparkles"></i><span>{{localize "SDE.importer.tools.extract"}}</span><small>{{localize "SDE.importer.tools.extractSub"}}</small></button>
        </div>
        <div class="sde-hub-tools-group">
          <button type="button" data-action="hubExportBundle"
                  title="{{localize 'SDE.importer.tools.exportTip'}}">
            <i class="fas fa-file-export"></i><span>{{localize "SDE.importer.tools.export"}}</span><small>{{localize "SDE.importer.tools.exportSub"}}</small></button>
          <button type="button" data-action="hubImportBundle"
                  title="{{localize 'SDE.importer.tools.importBundleTip'}}">
            <i class="fas fa-file-arrow-up"></i><span>{{localize "SDE.importer.tools.importBundle"}}</span><small>{{localize "SDE.importer.tools.importBundleSub"}}</small></button>
        </div>
        <div class="sde-hub-tools-group">
          <button type="button" data-action="hubHexMap"
                  class="sde-import-secondary sde-import-tool" title="{{localize 'SDE.importer.tools.hexMapTip'}}">
            <i class="fas fa-map"></i><span>{{localize "SDE.importer.tools.hexMap"}}</span><small>{{localize "SDE.importer.tools.hexMapSub"}}</small></button>
          <button type="button" data-action="hubOpenHexTagger"
                  title="{{localize 'SDE.importer.tools.hexTaggerTip'}}">
            <i class="fas fa-map-location-dot"></i><span>{{localize "SDE.importer.tools.hexTagger"}}</span><small>{{localize "SDE.importer.tools.hexTaggerSub"}}</small></button>
          <button type="button" data-action="hubKeyLocations"
                  title="{{localize 'SDE.importer.tools.keyLocationsTip'}}">
            <i class="fas fa-location-dot"></i><span>{{localize "SDE.importer.tools.keyLocations"}}</span><small>{{localize "SDE.importer.tools.keyLocationsSub"}}</small></button>
        </div>
      </div>
    </details>
  </div>

  <p class="sde-import-note">
    <i class="fas fa-circle-info"></i> {{{localize "SDE.importer.note.offline"}}}
  </p>

  {{!-- ── Downtime unlock ──────────────────────────────────────────────────
        The one type that unlocks a world SETTING instead of creating
        documents: the pasted outcome text is the GM's own book copy. Slot
        labels appear in this preview only — the person reading it has the
        book open — and never in the Manage tree. --}}
  {{#if importData.hasDowntime}}
  <section class="sde-hub-import-section">
    <div class="sde-hub-import-sechead">
      <span class="sde-hub-import-sectitle"><i class="fas fa-mug-hot"></i> {{localize "SDE.importer.downtime.title"}}</span>
      {{#if importData.downtime.result.canCommit}}
      <button type="button" data-action="hubCommitDowntime" class="sde-import-primary sde-hub-import-secbtn">
        <i class="fas fa-unlock"></i> {{localize "SDE.importer.downtime.unlock"}}
      </button>
      {{/if}}
    </div>
    <div class="sde-hub-import-sourcebar">
      <label for="sde-hub-downtime-source"><i class="fas fa-book"></i> {{localize "SDE.importer.downtime.book"}}</label>
      <select id="sde-hub-downtime-source" data-downtime-source
              class="sde-hub-import-source-input" aria-label="{{localize 'SDE.importer.downtime.bookAria'}}">
        {{#each importData.downtime.sourceOptions as |o|}}<option value="{{o.value}}" {{#if o.selected}}selected{{/if}}>{{o.label}}</option>{{/each}}
      </select>
    </div>
    <p class="sde-hub-import-srcnote">
      {{localize "SDE.importer.downtime.pasteFrom" book=importData.downtime.label}}{{#if importData.downtime.pages}}{{localize "SDE.importer.downtime.pages" pages=importData.downtime.pages}}{{/if}}{{localize "SDE.importer.downtime.thenParse"}}
    </p>

    {{!-- sde-dt-hub-preview: a full 25-slot parse plus its warning, unfilled and
          unmatched lists runs far taller than the section, pushing the Unlock
          button out of reach. The extra class bounds THIS preview only — the
          other seven import types keep the unbounded .sde-import-preview. --}}
    {{#if importData.downtime.result}}
    <div class="sde-import-preview sde-dt-hub-preview">
      <p class="sde-hub-import-srcnote">
        <span class="sde-thub-stat {{#if importData.downtime.result.complete}}ok{{else}}part{{/if}}">
          <i class="fas {{#if importData.downtime.result.complete}}fa-circle-check{{else}}fa-triangle-exclamation{{/if}}"></i>
          {{localize "SDE.importer.downtime.matched" filled=importData.downtime.result.filledCount expected=importData.downtime.expected}}
        </span>
      </p>

      {{#if importData.downtime.result.warnings.length}}
      <ul class="sde-import-warnings">
        {{#each importData.downtime.result.warnings as |w|}}
        <li{{#unless w.info}} class="sde-import-flag"{{/unless}}>{{w.text}}</li>
        {{/each}}
      </ul>
      {{/if}}

      {{#if importData.downtime.result.unfilled.length}}
      <p class="sde-hub-import-srcnote">{{localize "SDE.importer.downtime.unfilled"}}</p>
      <ul class="sde-import-warnings">
        {{#each importData.downtime.result.unfilled as |u|}}<li>{{u}}</li>{{/each}}
      </ul>
      {{/if}}

      {{#if importData.downtime.result.unmatched.length}}
      <p class="sde-hub-import-srcnote">{{localize "SDE.importer.downtime.unclaimed"}}</p>
      <ul class="sde-hub-import-skipped-list">
        {{#each importData.downtime.result.unmatched as |b|}}
        <li><strong>DC {{b.dc}}{{#if b.paid}} *{{/if}}</strong> — {{b.text}}</li>
        {{/each}}
      </ul>
      {{/if}}
    </div>
    {{/if}}
  </section>
  {{/if}}

  {{!-- ── Monsters preview ─────────────────────────────────────────────── --}}
  {{#if importData.hasMonsters}}
  <section class="sde-hub-import-section">
    <div class="sde-hub-import-sechead">
      <span class="sde-hub-import-sectitle"><i class="fas fa-dragon"></i> {{localize "SDE.importer.monsters.title" n=importData.monstersCount}}</span>
      <button type="button" data-action="hubCommitMonsters" class="sde-import-primary sde-hub-import-secbtn">
        <i class="fas fa-dragon"></i> {{localize "SDE.importer.monsters.create"}}
      </button>
    </div>
    <p class="sde-hub-import-srcnote">
      <i class="fas fa-folder-tree"></i> {{localize "SDE.importer.source.filingAs"}} <strong>{{#if importData.source}}{{importData.source}}{{else}}{{localize "SDE.importer.source.none"}}{{/if}}</strong>
    </p>
    <div class="sde-import-preview">
      {{#each importData.monsters as |m|}}
      <div class="sde-mimport-card" data-monster-idx="{{m.idx}}">
        <div class="sde-mimport-card-head">
          <input type="text" data-mimport-field="name" value="{{m.draft.name}}"
                 class="sde-import-name sde-mimport-cardname" aria-label="{{localize 'SDE.importer.monsters.nameAria'}}" placeholder="{{localize 'SDE.importer.monsters.nameAria'}}">
          {{#if m.hasWarnings}}
          <span class="sde-mimport-warncount" title="{{localize 'SDE.importer.monsters.flaggedTip' n=m.warnCount}}">
            <i class="fas fa-triangle-exclamation"></i> {{m.warnCount}}
          </span>
          {{/if}}
          <button type="button" data-action="mimportRemoveMonster" class="sde-import-del"
                  aria-label="{{localize 'SDE.importer.monsters.removeAria'}}" title="{{localize 'SDE.importer.monsters.removeTip'}}"><i class="fas fa-xmark"></i></button>
        </div>
        {{#if m.hasWarnings}}
        <ul class="sde-import-warnings">{{#each m.warnings as |w|}}<li>{{w}}</li>{{/each}}</ul>
        {{/if}}
        <div class="sde-mimport-stats">
          <label>{{localize "SDE.importer.monsters.lv"}} <input type="number" data-mimport-field="level" value="{{m.draft.level}}" class="sde-import-num{{#if m.warn.level}} sde-mimport-warn{{/if}}"></label>
          <label>{{localize "SDE.importer.monsters.ac"}} <input type="number" data-mimport-field="ac" value="{{m.draft.ac}}" class="sde-import-num{{#if m.warn.ac}} sde-mimport-warn{{/if}}"></label>
          <label>{{localize "SDE.importer.monsters.hp"}} <input type="number" data-mimport-field="hpValue" value="{{m.draft.hp.value}}" class="sde-import-num{{#if m.warn.hp}} sde-mimport-warn{{/if}}"></label>
          <label class="sde-mimport-hpmax">/ <input type="number" data-mimport-field="hpMax" value="{{m.draft.hp.max}}" class="sde-import-num{{#if m.warn.hp}} sde-mimport-warn{{/if}}" aria-label="{{localize 'SDE.importer.monsters.hpMaxAria'}}"></label>
          <label>{{localize "SDE.importer.monsters.al"}}
            <select data-mimport-field="alignment" class="sde-mimport-sel{{#if m.warn.alignment}} sde-mimport-warn{{/if}}">
              {{#each @root.importData.alignments as |a|}}<option value="{{a}}" {{#if (eq a m.draft.alignment)}}selected{{/if}}>{{a}}</option>{{/each}}
            </select>
          </label>
          <label>{{localize "SDE.importer.monsters.mv"}}
            <select data-mimport-field="move" class="sde-mimport-sel{{#if m.warn.move}} sde-mimport-warn{{/if}}">
              {{#each @root.importData.moveOptions as |mv|}}<option value="{{mv}}" {{#if (eq mv m.draft.move)}}selected{{/if}}>{{mv}}</option>{{/each}}
            </select>
          </label>
          <input type="text" data-mimport-field="moveNote" value="{{m.draft.moveNote}}" class="sde-mimport-movenote" placeholder="{{localize 'SDE.importer.monsters.moveNote'}}" aria-label="{{localize 'SDE.importer.monsters.moveNoteAria'}}">
        </div>
        <div class="sde-mimport-abils{{#if m.warn.abilities}} sde-mimport-warn-row{{/if}}">
          {{#each @root.importData.abilityKeys as |ab|}}
          <label>{{ab.label}} <input type="number" data-mimport-field="{{ab.key}}" value="{{lookup m.draft.abilities ab.key}}" class="sde-import-num"></label>
          {{/each}}
        </div>
        <div class="sde-mimport-spell{{#if m.warn.spellcasting}} sde-mimport-warn-row{{/if}}">
          <span class="sde-mimport-sublabel">{{localize "SDE.importer.monsters.spellcasting"}}</span>
          <label>{{localize "SDE.importer.monsters.ability"}}
            <select data-mimport-field="scAbility" class="sde-mimport-sel">
              {{#each @root.importData.spellAbilities as |sa|}}<option value="{{sa.value}}" {{#if (eq sa.value m.draft.spellcasting.ability)}}selected{{/if}}>{{sa.label}}</option>{{/each}}
            </select>
          </label>
          <label>{{localize "SDE.importer.monsters.bonus"}} <input type="number" data-mimport-field="scBonus" value="{{m.draft.spellcasting.bonus}}" class="sde-import-num"></label>
          <label>{{localize "SDE.importer.monsters.spellsPerRound"}} <input type="number" data-mimport-field="scAttacks" value="{{m.draft.spellcasting.attacks}}" class="sde-import-num"></label>
        </div>
        <div class="sde-mimport-section{{#if m.warn.attacks}} sde-mimport-warn-row{{/if}}">
          <div class="sde-mimport-sechead">
            <span class="sde-mimport-sublabel">{{localize "SDE.importer.monsters.attacks"}}</span>
            <button type="button" data-action="mimportAddAttack" class="sde-import-addrow"><i class="fas fa-plus"></i> {{localize "SDE.importer.monsters.addAttack"}}</button>
            <button type="button" data-action="mimportAddSpecial" class="sde-import-addrow"><i class="fas fa-plus"></i> {{localize "SDE.importer.monsters.addSpecial"}}</button>
          </div>
          {{#each m.actions as |a|}}
          <div class="sde-mimport-attack{{#if a.flagged}} flagged{{/if}}" data-attack-idx="{{@index}}">
            <input type="number" data-mimport-field="aNum" value="{{a.num}}" class="sde-import-num" aria-label="{{localize 'SDE.importer.monsters.attackCountAria'}}" title="{{localize 'SDE.importer.monsters.attackCountTip'}}">
            <input type="text" data-mimport-field="aName" value="{{a.name}}" class="sde-mimport-aname" aria-label="{{localize 'SDE.importer.monsters.attackNameAria'}}" placeholder="{{localize 'SDE.importer.common.name'}}">
            <select data-mimport-field="aType" class="sde-mimport-sel" aria-label="{{localize 'SDE.importer.monsters.attackTypeAria'}}">
              {{#each @root.importData.attackTypes as |ty|}}<option value="{{ty}}" {{#if (eq ty a.type)}}selected{{/if}}>{{ty}}</option>{{/each}}
            </select>
            <input type="number" data-mimport-field="aBonus" value="{{a.bonus}}" class="sde-import-num" aria-label="{{localize 'SDE.importer.monsters.toHitAria'}}" title="{{localize 'SDE.importer.monsters.toHitTip'}}">
            <input type="text" data-mimport-field="aDamage" value="{{a.damage}}" class="sde-mimport-dmg" aria-label="{{localize 'SDE.importer.monsters.damageAria'}}" placeholder="1d6">
            <input type="text" data-mimport-field="aRanges" value="{{join a.ranges}}" class="sde-mimport-ranges" aria-label="{{localize 'SDE.importer.monsters.rangesAria'}}" placeholder="{{localize 'SDE.importer.monsters.rangesPlaceholder'}}">
            <input type="text" data-mimport-field="aDesc" value="{{a.description}}" class="sde-import-rowtext" aria-label="{{localize 'SDE.importer.monsters.riderAria'}}" placeholder="{{localize 'SDE.importer.monsters.riderPlaceholder'}}">
            {{#if a.flagged}}<span class="sde-mimport-flagtag" title="{{a.flagReason}}"><i class="fas fa-triangle-exclamation"></i> {{localize "SDE.importer.common.review"}}</span>{{/if}}
            <button type="button" data-action="mimportRemoveAttack" class="sde-import-del" aria-label="{{localize 'SDE.importer.monsters.removeAttackAria'}}"><i class="fas fa-xmark"></i></button>
          </div>
          {{/each}}
        </div>
        <div class="sde-mimport-section">
          <div class="sde-mimport-sechead">
            <span class="sde-mimport-sublabel">{{localize "SDE.importer.monsters.features"}}</span>
            <button type="button" data-action="mimportAddFeature" class="sde-import-addrow"><i class="fas fa-plus"></i> {{localize "SDE.importer.monsters.addFeature"}}</button>
          </div>
          {{#each m.features as |f|}}
          <div class="sde-mimport-feature{{#if f.flagged}} flagged{{/if}}" data-feature-idx="{{@index}}">
            <input type="text" data-mimport-field="fName" value="{{f.name}}" class="sde-mimport-fname" aria-label="{{localize 'SDE.importer.monsters.featureNameAria'}}" placeholder="{{localize 'SDE.importer.common.name'}}">
            <input type="text" data-mimport-field="fDesc" value="{{f.description}}" class="sde-import-rowtext" aria-label="{{localize 'SDE.importer.monsters.featureTextAria'}}" placeholder="{{localize 'SDE.importer.common.description'}}">
            {{#if f.flagged}}<span class="sde-mimport-flagtag" title="{{f.flagReason}}"><i class="fas fa-triangle-exclamation"></i> {{localize "SDE.importer.common.review"}}</span>{{/if}}
            <button type="button" data-action="mimportRemoveFeature" class="sde-import-del" aria-label="{{localize 'SDE.importer.monsters.removeFeatureAria'}}"><i class="fas fa-xmark"></i></button>
          </div>
          {{/each}}
        </div>
      </div>
      {{/each}}
    </div>
  </section>
  {{/if}}

  {{!-- ── Items preview ────────────────────────────────────────────────── --}}
  {{#if importData.hasItems}}
  <section class="sde-hub-import-section">
    <div class="sde-hub-import-sechead">
      <span class="sde-hub-import-sectitle"><i class="fas fa-gem"></i> {{localize "SDE.importer.items.title" n=importData.itemsCount}}</span>
      <button type="button" data-action="hubCommitItems" class="sde-import-primary sde-hub-import-secbtn">
        <i class="fas fa-gem"></i> {{localize "SDE.importer.items.create"}}
      </button>
    </div>
    <div class="sde-import-preview">
      {{#each importData.items as |it|}}
      <div class="sde-hub-import-item-card" data-item-idx="{{@index}}">
        <div class="sde-hub-import-item-head">
          <input type="text" data-iimport-field="name" value="{{it.draft.name}}"
                 class="sde-import-name sde-hub-import-item-name" aria-label="{{localize 'SDE.importer.items.nameAria'}}" placeholder="{{localize 'SDE.importer.items.nameAria'}}">
          <select data-iimport-field="type" class="sde-hub-import-item-type sde-mimport-sel" aria-label="{{localize 'SDE.importer.items.typeAria'}}">
            {{#each @root.importData.itemTypeOptions as |opt|}}
            <option value="{{opt}}" {{#if (eq opt it.draft.type)}}selected{{/if}}>{{opt}}</option>
            {{/each}}
          </select>
          <button type="button" data-action="iimportRemoveItem" class="sde-import-del"
                  aria-label="{{localize 'SDE.importer.items.removeAria'}}" title="{{localize 'SDE.importer.monsters.removeTip'}}"><i class="fas fa-xmark"></i></button>
        </div>
        <div class="sde-hub-import-item-fields">
          <label class="sde-hub-import-item-field"><span class="sde-hub-import-item-label">{{localize "SDE.importer.items.gp"}}</span>
            <input type="number" data-iimport-field="costGp" value="{{it.draft.cost.gp}}" class="sde-import-num" aria-label="{{localize 'SDE.importer.items.costGpAria'}}"></label>
          <label class="sde-hub-import-item-field"><span class="sde-hub-import-item-label">{{localize "SDE.importer.items.sp"}}</span>
            <input type="number" data-iimport-field="costSp" value="{{it.draft.cost.sp}}" class="sde-import-num" aria-label="{{localize 'SDE.importer.items.costSpAria'}}"></label>
          <label class="sde-hub-import-item-field"><span class="sde-hub-import-item-label">{{localize "SDE.importer.items.cp"}}</span>
            <input type="number" data-iimport-field="costCp" value="{{it.draft.cost.cp}}" class="sde-import-num" aria-label="{{localize 'SDE.importer.items.costCpAria'}}"></label>
          <label class="sde-hub-import-item-field"><span class="sde-hub-import-item-label">{{localize "SDE.importer.items.slots"}}</span>
            <input type="number" data-iimport-field="slots" value="{{it.draft.slots.slots_used}}" class="sde-import-num" aria-label="{{localize 'SDE.importer.items.slotsAria'}}"></label>
        </div>
        {{#if it.statLine}}
        <div class="sde-hub-import-item-stats" title="{{localize 'SDE.importer.items.statLineTip'}}"><i class="fas fa-shield-halved"></i> {{it.statLine}}</div>
        {{/if}}
        <div class="sde-hub-import-item-desc">
          <textarea data-iimport-field="description" rows="2"
                    class="sde-hub-import-item-desc-input" aria-label="{{localize 'SDE.importer.items.descAria'}}"
                    placeholder="{{localize 'SDE.importer.common.descriptionCap'}}">{{it.draft.description}}</textarea>
        </div>
        {{#if it.warnings.length}}
        <ul class="sde-import-warnings">{{#each it.warnings as |w|}}<li>{{w}}</li>{{/each}}</ul>
        {{/if}}
      </div>
      {{/each}}
    </div>
  </section>
  {{/if}}

  {{!-- ── Spells preview ───────────────────────────────────────────────── --}}
  {{#if importData.hasSpells}}
  <section class="sde-hub-import-section">
    <div class="sde-hub-import-sechead">
      <span class="sde-hub-import-sectitle"><i class="fas fa-wand-sparkles"></i> {{localize "SDE.importer.spells.title" n=importData.spellsCount}}</span>
      <button type="button" data-action="hubCommitSpells" class="sde-import-primary sde-hub-import-secbtn">
        <i class="fas fa-wand-sparkles"></i> {{localize "SDE.importer.spells.create"}}
      </button>
    </div>
    <div class="sde-import-preview">
      {{#each importData.spells as |sp|}}
      <div class="sde-hub-import-item-card" data-spell-idx="{{sp.idx}}">
        <div class="sde-hub-import-item-head">
          <input type="text" data-simport-field="name" value="{{sp.draft.name}}"
                 class="sde-import-name sde-hub-import-item-name" aria-label="{{localize 'SDE.importer.spells.nameAria'}}" placeholder="{{localize 'SDE.importer.spells.nameAria'}}">
          {{#if sp.hasWarnings}}
          <span class="sde-mimport-warncount" title="{{localize 'SDE.importer.spells.flaggedTip' n=sp.warnCount}}"><i class="fas fa-triangle-exclamation"></i> {{sp.warnCount}}</span>
          {{/if}}
          <button type="button" data-action="simportRemoveSpell" class="sde-import-del"
                  aria-label="{{localize 'SDE.importer.spells.removeAria'}}" title="{{localize 'SDE.importer.monsters.removeTip'}}"><i class="fas fa-xmark"></i></button>
        </div>
        <div class="sde-hub-import-item-fields">
          <label class="sde-hub-import-item-field"><span class="sde-hub-import-item-label">{{localize "SDE.importer.spells.tier"}}</span>
            <input type="number" min="1" max="5" data-simport-field="tier" value="{{sp.draft.tier}}" class="sde-import-num" aria-label="{{localize 'SDE.importer.spells.tierAria'}}"></label>
          <label class="sde-hub-import-item-field"><span class="sde-hub-import-item-label">{{localize "SDE.importer.spells.class"}}</span>
            <input type="text" data-simport-field="className" value="{{sp.draft.className}}" class="sde-mimport-aname" aria-label="{{localize 'SDE.importer.spells.classAria'}}" placeholder="{{localize 'SDE.importer.spells.classPlaceholder'}}"></label>
          <label class="sde-hub-import-item-field"><span class="sde-hub-import-item-label">{{localize "SDE.importer.spells.range"}}</span>
            <select data-simport-field="range" class="sde-mimport-sel" aria-label="{{localize 'SDE.importer.spells.rangeAria'}}">
              {{#each @root.importData.spellRanges as |rg|}}<option value="{{rg}}" {{#if (eq rg sp.draft.range)}}selected{{/if}}>{{rg}}</option>{{/each}}
            </select></label>
          <label class="sde-hub-import-item-field"><span class="sde-hub-import-item-label">{{localize "SDE.importer.spells.duration"}}</span>
            <select data-simport-field="durationType" class="sde-mimport-sel" aria-label="{{localize 'SDE.importer.spells.durationTypeAria'}}">
              {{#each @root.importData.spellDurationTypes as |dt|}}<option value="{{dt}}" {{#if (eq dt sp.draft.duration.type)}}selected{{/if}}>{{dt}}</option>{{/each}}
            </select>
            <input type="text" data-simport-field="durationValue" value="{{sp.draft.duration.value}}" class="sde-import-num" aria-label="{{localize 'SDE.importer.spells.durationValueAria'}}" title="{{localize 'SDE.importer.spells.durationValueTip'}}"></label>
        </div>
        <div class="sde-hub-import-item-desc">
          <textarea data-simport-field="description" rows="3"
                    class="sde-hub-import-item-desc-input" aria-label="{{localize 'SDE.importer.spells.descAria'}}"
                    placeholder="{{localize 'SDE.importer.common.descriptionCap'}}">{{sp.draft.description}}</textarea>
        </div>
        {{#if sp.warnings.length}}
        <ul class="sde-import-warnings">{{#each sp.warnings as |w|}}<li>{{w}}</li>{{/each}}</ul>
        {{/if}}
      </div>
      {{/each}}
    </div>
  </section>
  {{/if}}

  {{!-- ── Character content import preview ───────────────────────────────── --}}
  {{!-- Title + button label come from context: parsed drafts may be roll
        tables or monsters, which commit to their own compendia, not Items. --}}
  {{#if importData.hasChar}}
  <section class="sde-hub-import-section">
    <div class="sde-hub-import-sechead">
      <span class="sde-hub-import-sectitle"><i class="fas fa-user-plus"></i> {{importData.charsTitle}} ({{importData.charsCount}})</span>
      <button type="button" data-action="hubCommitChar" class="sde-import-primary sde-hub-import-secbtn">
        <i class="fas fa-file-import"></i> {{importData.charsCommitLabel}}
      </button>
    </div>
    <div class="sde-import-preview">
      {{#each importData.chars as |c|}}
      <div class="sde-hub-import-item-card">
        <div class="sde-hub-import-item-head">
          <span class="sde-hub-import-item-name">{{c.name}}</span>
          <span class="sde-hub-monsters-dup-source">{{c.type}}</span>
        </div>
        {{#if c.unit}}
        {{!-- Full class-unit preview: everything the commit will author. --}}
        <div class="sde-class-preview" data-char-idx="{{@index}}">
          <div class="sde-cusheet-head">{{c.name}}</div>
          <div class="sde-cusheet-details">
            <label class="sde-cusheet-field">
              <span class="sde-cusheet-fieldname">{{localize "SDE.importer.cls.hpDie"}}</span>
              <input type="text" data-cu-field="hp" value="{{c.unit.hp}}" aria-label="{{localize 'SDE.importer.cls.hpDieAria'}}">
            </label>
            <label class="sde-cusheet-field">
              <span class="sde-cusheet-fieldname">{{localize "SDE.importer.cls.scAbility"}}</span>
              <select data-cu-field="scAbility" aria-label="{{localize 'SDE.importer.cls.scAbilityAria'}}">
                {{#each c.unit.scOptions as |o|}}<option value="{{o.value}}"{{#if o.selected}} selected{{/if}}>{{o.label}}</option>{{/each}}
              </select>
            </label>
            {{#if c.unit.isCaster}}
            <label class="sde-cusheet-field" title="{{localize 'SDE.importer.cls.spellListTip'}}">
              <span class="sde-cusheet-fieldname">{{localize "SDE.importer.cls.spellList"}}</span>
              <select data-cu-field="spellList" aria-label="{{localize 'SDE.importer.cls.spellListAria'}}">
                {{#each c.unit.spellListOptions as |o|}}<option value="{{o.value}}"{{#if o.selected}} selected{{/if}}>{{o.label}}</option>{{/each}}
              </select>
            </label>
            {{/if}}
          </div>

          <details class="sde-class-preview-block" open>
            <summary>{{localize "SDE.importer.common.descriptionCap"}}</summary>
            <textarea data-cu-field="flavor" rows="2" class="sde-cu-area" aria-label="{{localize 'SDE.importer.cls.flavorAria'}}">{{c.unit.flavor}}</textarea>
          </details>

          <details class="sde-class-preview-block" open>
            <summary>{{localize "SDE.importer.cls.equipment"}}</summary>
            <div class="sde-cusheet-cols">
              <div class="sde-cusheet-box">
                <h5>{{localize "SDE.importer.cls.weapons"}}</h5>
                <input type="text" data-cu-field="weapons" value="{{c.unit.weaponsText}}" class="sde-cu-text" placeholder="{{localize 'SDE.importer.common.typeHere'}}" title="{{localize 'SDE.importer.cls.weaponsTip'}}">
              </div>
              <div class="sde-cusheet-box">
                <h5>{{localize "SDE.importer.cls.armor"}}</h5>
                <input type="text" data-cu-field="armor" value="{{c.unit.armorText}}" class="sde-cu-text" placeholder="{{localize 'SDE.importer.common.typeHere'}}" title="{{localize 'SDE.importer.cls.armorTip'}}">
              </div>
              <div class="sde-cusheet-box">
                <h5>{{localize "SDE.importer.cls.options"}}</h5>
                <label class="sde-cusheet-check">{{localize "SDE.importer.cls.allWeapons"}} <input type="checkbox" data-cu-field="allWeapons" {{#if c.unit.allWeapons}}checked{{/if}}></label>
                <label class="sde-cusheet-check">{{localize "SDE.importer.cls.allMelee"}} <input type="checkbox" data-cu-field="allMeleeWeapons" {{#if c.unit.allMeleeWeapons}}checked{{/if}}></label>
                <label class="sde-cusheet-check">{{localize "SDE.importer.cls.allRanged"}} <input type="checkbox" data-cu-field="allRangedWeapons" {{#if c.unit.allRangedWeapons}}checked{{/if}}></label>
                <label class="sde-cusheet-check">{{localize "SDE.importer.cls.allArmor"}} <input type="checkbox" data-cu-field="allArmor" {{#if c.unit.allArmor}}checked{{/if}}></label>
              </div>
            </div>
          </details>

          <details class="sde-class-preview-block" open>
            <summary>{{localize "SDE.importer.cls.languages"}}</summary>
            <div class="sde-cusheet-cols">
              <div class="sde-cusheet-box">
                <h5>{{localize "SDE.importer.cls.fixed"}}</h5>
                <input type="text" data-cu-field="langFixed" value="{{c.unit.langFixed}}" class="sde-cu-text" placeholder="{{localize 'SDE.importer.common.typeHere'}}">
              </div>
              <div class="sde-cusheet-box">
                <h5>{{localize "SDE.importer.cls.options"}}</h5>
                <label class="sde-cusheet-check">{{localize "SDE.importer.cls.addCommon"}} <input type="number" min="0" data-cu-field="langCommon" value="{{c.unit.langCommon}}" class="sde-cu-num" aria-label="{{localize 'SDE.importer.cls.addCommonAria'}}"></label>
                <label class="sde-cusheet-check">{{localize "SDE.importer.cls.addRare"}} <input type="number" min="0" data-cu-field="langRare" value="{{c.unit.langRare}}" class="sde-cu-num" aria-label="{{localize 'SDE.importer.cls.addRareAria'}}"></label>
              </div>
            </div>
          </details>

          <details class="sde-class-preview-block" open>
            <summary>{{localize "SDE.importer.cls.features" n=c.unit.features.length}}</summary>
            <div class="sde-cu-features">
              {{#each c.unit.features as |f|}}
              <div class="sde-cu-featrow" data-cu-feat="{{@index}}">
                <input type="text" data-cu-field="featName" value="{{f.name}}" class="sde-cu-featname" aria-label="{{localize 'SDE.importer.monsters.featureNameAria'}}">
                <input type="text" data-cu-field="featText" value="{{f.text}}" class="sde-cu-text" aria-label="{{localize 'SDE.importer.cls.featTextAria'}}">
                <button type="button" data-action="cuFeatDel" class="sde-cu-btn sde-cu-btn-del" title="{{localize 'SDE.importer.cls.featDelTip'}}"><i class="fas fa-trash"></i></button>
              </div>
              {{/each}}
              <button type="button" data-action="cuFeatAdd" class="sde-cu-btn" title="{{localize 'SDE.importer.cls.featAddTip'}}"><i class="fas fa-plus"></i> {{localize "SDE.importer.cls.feature"}}</button>
            </div>
          </details>

          {{#if c.unit.stage1}}
          <p class="sde-class-preview-flavor"><i class="fas fa-circle-info"></i> {{{localize "SDE.importer.cls.stage1"}}}</p>
          {{/if}}

          {{#unless c.unit.stage1}}
          <details class="sde-class-preview-block" open>
            <summary>{{localize "SDE.importer.cls.talentTable"}}{{#if c.unit.table}} ({{c.unit.table.formula}}){{else}}{{localize "SDE.importer.cls.noneFound"}}{{/if}}</summary>
            {{#unless c.unit.table}}
            <p class="sde-class-preview-flavor">{{localize "SDE.importer.cls.noTable"}}</p>
            {{/unless}}
            {{#if c.unit.table}}
            <table class="sde-class-preview-table">
              {{#each c.unit.table.rows as |r|}}
              <tr data-cu-row="{{@index}}">
                <td class="sde-class-preview-range">
                  <input type="text" data-cu-field="range" value="{{r.range}}" class="sde-cu-range" aria-label="{{localize 'SDE.importer.cls.rangeAria'}}" title="{{localize 'SDE.importer.cls.rangeTip'}}">
                </td>
                <td>
                  <input type="text" data-cu-field="text" value="{{r.text}}" class="sde-cu-text" aria-label="{{localize 'SDE.importer.cls.effectAria'}}">
                  {{#if r.isChoice}}
                  <div class="sde-class-preview-opts">
                    {{#each r.options as |o|}}
                    <span class="sde-cu-optwrap" data-cu-opt="{{@index}}">
                      <input type="text" data-cu-field="option" value="{{o}}" class="sde-cu-opt" aria-label="{{localize 'SDE.importer.cls.optionAria'}}">
                      <button type="button" data-action="cuOptDel" class="sde-cu-btn sde-cu-btn-del" title="{{localize 'SDE.importer.cls.optDelTip'}}"><i class="fas fa-xmark"></i></button>
                    </span>
                    {{/each}}
                    <button type="button" data-action="cuOptAdd" class="sde-cu-btn" title="{{localize 'SDE.importer.cls.optAddTip'}}"><i class="fas fa-plus"></i> {{localize "SDE.importer.cls.option"}}</button>
                    <button type="button" data-action="cuRowMerge" class="sde-cu-btn" title="{{localize 'SDE.importer.cls.mergeTip'}}">{{localize "SDE.importer.cls.merge"}}</button>
                  </div>
                  {{else if r.grand}}
                  <div class="sde-class-preview-opts"><span class="sde-class-opt sde-class-opt-grand">{{localize "SDE.importer.cls.grand"}}</span></div>
                  {{else}}
                  <div class="sde-class-preview-opts">
                    <button type="button" data-action="cuRowSplit" class="sde-cu-btn" title="{{localize 'SDE.importer.cls.splitTip'}}">{{localize "SDE.importer.cls.split"}}</button>
                  </div>
                  {{/if}}
                </td>
                <td class="sde-cu-rowdel">
                  <button type="button" data-action="cuRowDel" class="sde-cu-btn sde-cu-btn-del" title="{{localize 'SDE.importer.cls.rowDelTip'}}"><i class="fas fa-trash"></i></button>
                </td>
              </tr>
              {{/each}}
            </table>
            {{/if}}
            <div class="sde-class-preview-opts sde-cu-addrow">
              <button type="button" data-action="cuRowAdd" class="sde-cu-btn" title="{{localize 'SDE.importer.cls.rowAddTip'}}"><i class="fas fa-plus"></i> {{localize "SDE.importer.cls.row"}}</button>
              {{#if c.unit.table}}
              <label class="sde-cu-formula">{{localize "SDE.importer.cls.formula"}} <input type="text" data-cu-field="tblFormula" value="{{c.unit.table.formula}}" class="sde-cu-num" aria-label="{{localize 'SDE.importer.cls.formulaAria'}}"></label>
              {{/if}}
            </div>
          </details>
          {{/unless}}

          {{#if c.unit.isCaster}}
          <details class="sde-class-preview-block" open>
            <summary>{{localize "SDE.importer.monsters.spellcasting"}}</summary>
            <textarea data-cu-field="scText" rows="2" class="sde-cu-area" aria-label="{{localize 'SDE.importer.cls.scTextAria'}}">{{c.unit.scText}}</textarea>
            {{#unless c.unit.stage1}}
            {{#if c.unit.spellsKnown.length}}
            <div class="sde-cu-spellsknown" title="{{localize 'SDE.importer.cls.spellsKnownTip'}}">
              {{#each c.unit.spellsKnown as |r|}}<span class="sde-class-opt">{{localize "SDE.importer.cls.spellsKnownRow" level=r.level cells=r.cells}}</span>{{/each}}
            </div>
            {{/if}}
            {{/unless}}
          </details>
          {{/if}}

          {{#unless c.unit.stage1}}
          <details class="sde-class-preview-block" open>
            <summary>{{localize "SDE.importer.cls.titles" n=c.unit.titles.length}}</summary>
            <table class="sde-class-preview-table sde-cu-titles">
              {{#if c.unit.titles.length}}
              <tr class="sde-cu-titlehead"><th>{{localize "SDE.importer.cls.levels"}}</th><th>{{localize "SDE.importer.cls.lawful"}}</th><th>{{localize "SDE.importer.cls.chaotic"}}</th><th>{{localize "SDE.importer.cls.neutral"}}</th><th></th></tr>
              {{/if}}
              {{#each c.unit.titles as |t|}}
              <tr data-cu-title="{{@index}}">
                <td class="sde-class-preview-range"><input type="text" data-cu-field="titleRange" value="{{t.range}}" class="sde-cu-range" aria-label="{{localize 'SDE.importer.cls.levelRangeAria'}}"></td>
                <td><input type="text" data-cu-field="titleLawful" value="{{t.lawful}}" class="sde-cu-text" aria-label="{{localize 'SDE.importer.cls.lawfulAria'}}"></td>
                <td><input type="text" data-cu-field="titleChaotic" value="{{t.chaotic}}" class="sde-cu-text" aria-label="{{localize 'SDE.importer.cls.chaoticAria'}}"></td>
                <td><input type="text" data-cu-field="titleNeutral" value="{{t.neutral}}" class="sde-cu-text" aria-label="{{localize 'SDE.importer.cls.neutralAria'}}"></td>
                <td class="sde-cu-rowdel"><button type="button" data-action="cuTitleDel" class="sde-cu-btn sde-cu-btn-del" title="{{localize 'SDE.importer.cls.bandDelTip'}}"><i class="fas fa-trash"></i></button></td>
              </tr>
              {{/each}}
            </table>
            <button type="button" data-action="cuTitleAdd" class="sde-cu-btn sde-cu-addrow" title="{{localize 'SDE.importer.cls.bandAddTip'}}"><i class="fas fa-plus"></i> {{localize "SDE.importer.cls.band"}}</button>
          </details>
          {{/unless}}

          {{#if c.unit.warnings.length}}
          <details class="sde-class-preview-block sde-class-preview-notes" open>
            <summary>{{localize "SDE.importer.cls.reviewNotes" n=c.unit.warnings.length}}</summary>
            <ul class="sde-import-warnings">
              {{#each c.unit.warnings as |w|}}<li>{{w}}</li>{{/each}}
            </ul>
          </details>
          {{/if}}
        </div>
        {{else if c.supplement}}
        {{!-- Stage-2 supplement: attach parsed tables/titles/spells to a class. --}}
        <div class="sde-class-preview sde-class-supplement" data-char-idx="{{@index}}">
          <label class="sde-cusheet-field">
            <span class="sde-cusheet-fieldname">{{localize "SDE.importer.sup.attachTo"}}</span>
            <select data-supplement-attach aria-label="{{localize 'SDE.importer.sup.attachAria'}}">
              {{#each c.supplement.attachOptions as |o|}}<option value="{{o.value}}"{{#if o.selected}} selected{{/if}}>{{o.label}}</option>{{/each}}
            </select>
          </label>
          {{#if c.supplement.hasTable}}
          <details class="sde-class-preview-block" open>
            <summary>{{localize "SDE.importer.sup.talentTable" n=c.supplement.tableRows}}</summary>
          </details>
          {{/if}}
          {{!-- Titles: always editable — paste a TITLES block above to fill, or add/edit bands by hand. --}}
          <details class="sde-class-preview-block" open>
            <summary>{{localize "SDE.importer.cls.titles" n=c.supplement.titles.length}}</summary>
            <p class="sde-class-preview-flavor">{{{localize "SDE.importer.sup.titlesHint"}}}</p>
            <table class="sde-class-preview-table sde-cu-titles">
              {{#if c.supplement.titles.length}}
              <tr class="sde-cu-titlehead"><th>{{localize "SDE.importer.cls.levels"}}</th><th>{{localize "SDE.importer.cls.lawful"}}</th><th>{{localize "SDE.importer.cls.chaotic"}}</th><th>{{localize "SDE.importer.cls.neutral"}}</th><th></th></tr>
              {{/if}}
              {{#each c.supplement.titles as |t|}}
              <tr data-cu-title="{{@index}}">
                <td class="sde-class-preview-range"><input type="text" data-cu-field="titleRange" value="{{t.range}}" class="sde-cu-range" aria-label="{{localize 'SDE.importer.cls.levelRangeAria'}}"></td>
                <td><input type="text" data-cu-field="titleLawful" value="{{t.lawful}}" class="sde-cu-text" aria-label="{{localize 'SDE.importer.cls.lawfulAria'}}"></td>
                <td><input type="text" data-cu-field="titleChaotic" value="{{t.chaotic}}" class="sde-cu-text" aria-label="{{localize 'SDE.importer.cls.chaoticAria'}}"></td>
                <td><input type="text" data-cu-field="titleNeutral" value="{{t.neutral}}" class="sde-cu-text" aria-label="{{localize 'SDE.importer.cls.neutralAria'}}"></td>
                <td class="sde-cu-rowdel"><button type="button" data-action="cuTitleDel" class="sde-cu-btn sde-cu-btn-del" title="{{localize 'SDE.importer.cls.bandDelTip'}}"><i class="fas fa-trash"></i></button></td>
              </tr>
              {{/each}}
            </table>
            <button type="button" data-action="cuTitleAdd" class="sde-cu-btn sde-cu-addrow" title="{{localize 'SDE.importer.cls.bandAddTip'}}"><i class="fas fa-plus"></i> {{localize "SDE.importer.cls.band"}}</button>
          </details>
          {{#if c.supplement.spellsKnown.length}}
          <details class="sde-class-preview-block" open>
            <summary>{{localize "SDE.importer.sup.spellsKnown"}}</summary>
            <div class="sde-cu-spellsknown">{{#each c.supplement.spellsKnown as |r|}}<span class="sde-class-opt">{{localize "SDE.importer.cls.spellsKnownRow" level=r.level cells=r.cells}}</span>{{/each}}</div>
          </details>
          {{/if}}
          {{#if c.supplement.extraTables.length}}
          <details class="sde-class-preview-block" open>
            <summary>{{localize "SDE.importer.sup.extraTables" n=c.supplement.extraTables.length}}</summary>
            <div class="sde-cu-spellsknown">{{#each c.supplement.extraTables as |t|}}<span class="sde-class-opt">{{localize "SDE.importer.sup.tableRows" name=t.name rows=t.rows}}</span>{{/each}}</div>
          </details>
          {{/if}}
          {{#if c.supplement.warnings.length}}
          <details class="sde-class-preview-block sde-class-preview-notes" open>
            <summary>{{localize "SDE.importer.cls.reviewNotes" n=c.supplement.warnings.length}}</summary>
            <ul class="sde-import-warnings">{{#each c.supplement.warnings as |w|}}<li>{{w}}</li>{{/each}}</ul>
          </details>
          {{/if}}
        </div>
        {{else}}
        <div class="sde-hub-import-item-desc">{{c.preview}}</div>
        {{#if c.meta}}
        <div class="sde-hub-import-item-meta">
          <div class="sde-hub-import-metarow"><i class="fas fa-language"></i> <strong>{{localize "SDE.importer.cls.languages"}}:</strong> {{c.meta.languages}}</div>
          <div class="sde-hub-import-metarow" title="{{c.meta.talentText}}"><i class="fas fa-star"></i> <strong>{{localize "SDE.importer.cls.ancestryTalent"}}:</strong> {{c.meta.talent}}{{#if c.meta.talentText}} — {{c.meta.talentText}}{{/if}}</div>
        </div>
        {{/if}}
        {{/if}}
      </div>
      {{/each}}
    </div>
  </section>
  {{/if}}

  {{!-- ── Boats preview ────────────────────────────────────────────────── --}}
  {{#if importData.hasBoats}}
  <section class="sde-hub-import-section">
    <div class="sde-hub-import-sechead">
      <span class="sde-hub-import-sectitle"><i class="fas fa-sailboat"></i> {{localize "SDE.importer.boats.title" n=importData.boats.length}}</span>
      <button type="button" data-action="hubCommitBoats" class="sde-import-primary sde-hub-import-secbtn">
        <i class="fas fa-anchor"></i> {{localize "SDE.importer.boats.create"}}
      </button>
    </div>
    <div class="sde-import-preview">
      <table class="sde-import-boats">
        <thead><tr><th>{{localize "SDE.importer.common.nameCap"}}</th><th>{{localize "SDE.importer.boats.cost"}}</th><th>{{localize "SDE.importer.boats.speed"}}</th><th>{{localize "SDE.importer.monsters.ac"}}</th><th>{{localize "SDE.importer.monsters.hp"}}</th><th>{{localize "SDE.importer.boats.slots"}}</th><th>{{localize "SDE.importer.boats.properties"}}</th></tr></thead>
        <tbody>
          {{#each importData.boats as |b|}}
          <tr>
            <td>{{b.name}}</td><td>{{localize "SDE.importer.boats.gp" cost=b.cost}}</td><td>{{b.speed}}</td>
            <td>{{b.ac}}</td><td>{{b.hp}}</td><td>{{b.gearSlots}}</td><td>{{b.props}}</td>
          </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  </section>
  {{/if}}

  {{!-- ── Hex crawl hand-off (after a hex-key commit) ──────────────────── --}}
  {{#if importData.hexCrawlDone}}
  <section class="sde-hub-import-section">
    <div class="sde-hub-import-sechead">
      <span class="sde-hub-import-sectitle"><i class="fas fa-map-location-dot"></i> {{localize "SDE.importer.hex.filed" title=importData.hexCrawlDone.title}}</span>
      {{#if importData.hexPinScene}}
      <button type="button" data-action="hubPinHexes" data-uuid="{{importData.hexCrawlDone.uuid}}" class="sde-import-primary sde-hub-import-secbtn" title="{{localize 'SDE.importer.hex.pinTip'}}">
        <i class="fas fa-map-pin"></i> {{localize "SDE.importer.hex.pinOn" scene=importData.hexPinScene}}
      </button>
      {{/if}}
      <button type="button" data-action="hubHexDataset" data-uuid="{{importData.hexCrawlDone.uuid}}" class="sde-import-secondary sde-hub-import-secbtn">
        {{#if importData.hexViaExtras}}<i class="fas fa-paper-plane"></i> {{localize "SDE.importer.hex.sendExtras"}}{{else}}<i class="fas fa-download"></i> {{localize "SDE.importer.hex.download"}}{{/if}}
      </button>
    </div>
    <p class="sde-hub-import-srcnote">
      {{#if importData.hexPinScene}}{{{localize "SDE.importer.hex.pinNote"}}} {{else}}{{{localize "SDE.importer.hex.noSceneNote"}}} {{/if}}
      {{#if importData.hexViaExtras}}{{{localize "SDE.importer.hex.extrasNote"}}}{{else}}{{{localize "SDE.importer.hex.downloadNote"}}}{{/if}}
    </p>
  </section>
  {{/if}}

  {{!-- ── Hex key preview ──────────────────────────────────────────────── --}}
  {{#if importData.hasHexes}}
  <section class="sde-hub-import-section">
    <div class="sde-hub-import-sechead">
      <span class="sde-hub-import-sectitle"><i class="fas fa-map-location-dot"></i> {{localize "SDE.importer.hex.title" n=importData.hexCount}}</span>
      <button type="button" data-action="hubCommitHexes" class="sde-import-primary sde-hub-import-secbtn">
        <i class="fas fa-book-open"></i> {{localize "SDE.importer.hex.create"}}
      </button>
    </div>
    <div class="sde-hub-import-sourcebar">
      <label for="sde-hub-hex-title"><i class="fas fa-map"></i> {{localize "SDE.importer.hex.crawl"}}</label>
      <input type="text" id="sde-hub-hex-title" data-hex-title class="sde-hub-import-source-input"
             value="{{importData.hexTitle}}" placeholder="{{localize 'SDE.importer.hex.titlePlaceholder'}}"
             aria-label="{{localize 'SDE.importer.hex.titleAria'}}">
    </div>
    <p class="sde-hub-import-srcnote">
      {{localize "SDE.importer.hex.filedUnder"}} <strong>{{#if importData.source}}{{importData.source}}{{else}}{{localize "SDE.importer.hex.custom"}}{{/if}}</strong>
      {{localize "SDE.importer.hex.filedRest"}}
    </p>
    {{#if importData.hexSummaryCount}}
    <p class="sde-hub-import-srcnote">
      <i class="fas fa-table-list"></i> {{localize "SDE.importer.hex.summaryRows" n=importData.hexSummaryCount}}
    </p>
    {{/if}}
    {{#if importData.hexes.length}}
    <div class="sde-import-preview">
      <table class="sde-import-hexes">
        <thead><tr><th>{{localize "SDE.importer.hex.hex"}}</th><th>{{localize "SDE.importer.common.nameCap"}}</th><th>{{localize "SDE.importer.hex.lines"}}</th><th></th></tr></thead>
        <tbody>
          {{#each importData.hexes as |h|}}
          <tr{{#if h.warn}} class="sde-mimport-warn-row"{{/if}}>
            <td>{{h.num}}</td><td>{{h.name}}</td><td>{{h.lines}}</td>
            <td>{{#each h.warnings as |w|}}<span class="sde-import-flag">{{w}}</span>{{/each}}</td>
          </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
    {{/if}}
  </section>
  {{/if}}

  {{!-- ── Tables preview ───────────────────────────────────────────────── --}}
  {{#if importData.hasTables}}
  <section class="sde-hub-import-section">
    <div class="sde-hub-import-sechead">
      <span class="sde-hub-import-sectitle"><i class="fas fa-table-list"></i> {{localize "SDE.importer.tables.title" n=importData.tablesCount}}</span>
      <button type="button" data-action="hubCommitTables" class="sde-import-primary sde-hub-import-secbtn">
        <i class="fas fa-table-list"></i> {{localize "SDE.importer.tables.create"}}
      </button>
    </div>
    <div class="sde-import-preview">
      {{#each importData.tables as |tbl|}}
      <div class="sde-import-table" data-table-idx="{{@index}}">
        <div class="sde-import-table-head">
          <input type="text" data-import-field="name" value="{{tbl.name}}" aria-label="{{localize 'SDE.importer.tables.nameAria'}}" placeholder="{{localize 'SDE.importer.tables.nameAria'}}" class="sde-import-name">
          <input type="text" data-import-field="formula" value="{{tbl.formula}}" aria-label="{{localize 'SDE.importer.tables.formulaAria'}}" class="sde-import-formula">
          <label class="sde-import-repl" data-tooltip="{{localize 'SDE.importer.tables.replacementTip'}}" data-tooltip-direction="UP">
            <input type="checkbox" data-import-field="replacement" {{#if tbl.replacement}}checked{{/if}}> {{localize "SDE.importer.tables.replacement"}}
          </label>
          <label class="sde-import-repl" data-tooltip="{{localize 'SDE.importer.tables.folderTip'}}" data-tooltip-direction="UP"><i class="fas fa-folder"></i> {{localize "SDE.importer.tables.folder"}}</label>
          <select data-import-field="category" class="sde-import-cat" aria-label="{{localize 'SDE.importer.tables.folderAria'}}" data-tooltip="{{localize 'SDE.importer.tables.folderTip'}}" data-tooltip-direction="UP">
            {{#each @root.importData.categoryOptions as |opt|}}
            <option value="{{opt.id}}" {{#if (eq opt.id tbl.category)}}selected{{/if}}>{{opt.label}}</option>
            {{/each}}
          </select>
          {{#if (eq tbl.category "custom")}}
          <input type="text" data-import-field="customLabel" value="{{tbl.customLabel}}" class="sde-import-customcat" aria-label="{{localize 'SDE.importer.tables.customAria'}}" placeholder="{{localize 'SDE.importer.tables.customPlaceholder'}}">
          {{/if}}
          <button type="button" data-action="hubCommitTables" class="sde-import-primary"><i class="fas fa-plus"></i> {{localize "SDE.importer.btn.create"}}</button>
        </div>
        {{#if tbl.bestEffort}}
        <p class="sde-import-flag"><i class="fas fa-triangle-exclamation"></i> {{localize "SDE.importer.tables.bestEffort"}}</p>
        {{/if}}
        {{#if tbl.warnings.length}}
        <ul class="sde-import-warnings">{{#each tbl.warnings as |w|}}<li>{{w}}</li>{{/each}}</ul>
        {{/if}}
        <div class="sde-import-rows">
          {{#each tbl.rows as |row|}}
          <div class="sde-import-row" data-row-idx="{{@index}}">
            <input type="number" data-import-field="min" value="{{row.min}}" aria-label="{{localize 'SDE.importer.tables.minAria'}}" class="sde-import-num">
            <span class="sde-import-dash">–</span>
            <input type="number" data-import-field="max" value="{{row.max}}" aria-label="{{localize 'SDE.importer.tables.maxAria'}}" class="sde-import-num">
            <input type="text" data-import-field="text" value="{{row.text}}" aria-label="{{localize 'SDE.importer.tables.resultAria'}}" class="sde-import-rowtext">
            {{#if row.link}}
            <span class="sde-import-link" data-tooltip="{{localize 'SDE.importer.tables.linkTip'}}"><i class="fas fa-link"></i> {{row.link.name}}</span>
            <button type="button" data-action="importUnlinkRow" aria-label="{{localize 'SDE.importer.tables.unlinkAria'}}" class="sde-import-unlink"><i class="fas fa-link-slash"></i></button>
            {{/if}}
            <button type="button" data-action="importDeleteRow" aria-label="{{localize 'SDE.importer.tables.delRowAria'}}" class="sde-import-del"><i class="fas fa-xmark"></i></button>
          </div>
          {{/each}}
        </div>
        <button type="button" data-action="importAddRow" class="sde-import-addrow"><i class="fas fa-plus"></i> {{localize "SDE.importer.tables.addRow"}}</button>
      </div>
      {{/each}}
    </div>
  </section>
  {{/if}}

  {{!-- ── Generators preview (roll-all compound tables) ────────────────── --}}
  {{#if importData.hasGenerators}}
  <section class="sde-hub-import-section">
    <div class="sde-hub-import-sechead">
      <span class="sde-hub-import-sectitle"><i class="fas fa-dice-d6"></i>
        {{#if importData.cartesianMode}}{{localize "SDE.importer.gen.cartesianTitle" n=importData.generatorsCount}}{{else}}{{localize "SDE.importer.gen.title" n=importData.generatorsCount}}{{/if}}</span>
      <button type="button" data-action="hubCommitGenerators" class="sde-import-primary sde-hub-import-secbtn">
        <i class="fas fa-dice-d6"></i> {{#if importData.cartesianMode}}{{localize "SDE.importer.tables.create"}}{{else}}{{localize "SDE.importer.gen.create"}}{{/if}}
      </button>
    </div>
    {{#if importData.cartesianMode}}
    <p class="sde-import-note">
      <i class="fas fa-circle-info"></i> {{{localize "SDE.importer.gen.cartesianNote" total=importData.cartesianTotal}}}
    </p>
    {{else}}
    <p class="sde-import-note">
      <i class="fas fa-circle-info"></i> {{{localize "SDE.importer.gen.note"}}}
    </p>
    {{/if}}
    <div class="sde-import-preview">
      {{#each importData.generators as |gen|}}
      <div class="sde-import-gen" data-gen-idx="{{gen.idx}}">
        <div class="sde-import-gen-head">
          <input type="text" data-gen-field="name" value="{{gen.name}}" aria-label="{{localize 'SDE.importer.gen.nameAria'}}" placeholder="{{localize 'SDE.importer.gen.nameAria'}}" class="sde-import-name">
          <label class="sde-import-repl" data-tooltip="{{localize 'SDE.importer.gen.dieTip'}}" data-tooltip-direction="UP">
            <i class="fas fa-dice"></i> <input type="text" data-gen-field="formula" value="{{gen.formula}}" aria-label="{{localize 'SDE.importer.tables.formulaAria'}}" class="sde-import-formula">
          </label>
          <label class="sde-import-repl" data-tooltip="{{localize 'SDE.importer.gen.joinTip'}}" data-tooltip-direction="UP">
            {{localize "SDE.importer.gen.join"}} <input type="text" data-gen-field="separator" value="{{gen.separator}}" aria-label="{{localize 'SDE.importer.gen.separatorAria'}}" class="sde-import-gen-sep">
          </label>
          <button type="button" data-action="hubCommitGenerators" class="sde-import-primary"><i class="fas fa-plus"></i> {{localize "SDE.importer.btn.create"}}</button>
        </div>
        {{#if gen.isCartesian}}
        <p class="sde-import-cartesian-note">
          <i class="fas fa-table-cells"></i> {{{localize "SDE.importer.gen.expands" rows=gen.expandRowsLabel math=gen.expandMath formula=gen.expandFormula}}}
        </p>
        {{/if}}
        {{#if gen.hasWarnings}}
        <ul class="sde-import-warnings">{{#each gen.warnings as |w|}}<li>{{w}}</li>{{/each}}</ul>
        {{/if}}
        <div class="sde-import-gen-gridwrap">
          <table class="sde-import-gen-grid">
            <thead>
              <tr>
                <th class="sde-import-gen-facehead">{{localize "SDE.importer.gen.dieHead"}}</th>
                {{#each gen.columns as |col|}}
                <th data-col-idx="{{col.idx}}">
                  <input type="text" data-gen-field="label" data-col-idx="{{col.idx}}" value="{{col.label}}" aria-label="{{localize 'SDE.importer.gen.colLabelAria'}}" placeholder="{{localize 'SDE.importer.gen.colPlaceholder' n=col.idx}}" class="sde-import-gen-label">
                  <button type="button" data-action="genRemoveColumn" class="sde-import-del" aria-label="{{localize 'SDE.importer.gen.removeColAria'}}" title="{{localize 'SDE.importer.gen.removeColTip'}}"><i class="fas fa-xmark"></i></button>
                </th>
                {{/each}}
                <th class="sde-import-gen-addcolcell">
                  <button type="button" data-action="genAddColumn" class="sde-import-addrow" aria-label="{{localize 'SDE.importer.gen.addColAria'}}" title="{{localize 'SDE.importer.gen.addColTip'}}"><i class="fas fa-plus"></i></button>
                </th>
              </tr>
            </thead>
            <tbody>
              {{#each gen.faces as |frow|}}
              <tr data-face-row="{{frow.face}}">
                <td class="sde-import-gen-face">{{frow.face}}</td>
                {{#each frow.cells as |cell|}}
                <td>
                  <input type="text" data-gen-field="cell" data-col-idx="{{cell.colIdx}}" data-face="{{frow.face}}" value="{{cell.text}}" aria-label="{{localize 'SDE.importer.gen.cellAria'}}" class="sde-import-gen-cell">
                </td>
                {{/each}}
                <td class="sde-import-gen-rowdel">
                  <button type="button" data-action="genDeleteRow" class="sde-import-del" aria-label="{{localize 'SDE.importer.tables.delRowAria'}}" title="{{localize 'SDE.importer.gen.delFaceTip'}}"><i class="fas fa-xmark"></i></button>
                </td>
              </tr>
              {{/each}}
            </tbody>
          </table>
        </div>
        <button type="button" data-action="genAddRow" class="sde-import-addrow"><i class="fas fa-plus"></i> {{localize "SDE.importer.gen.addFace"}}</button>
      </div>
      {{/each}}
    </div>
  </section>
  {{/if}}

  {{!-- ── Skipped (always visible — nothing silently dropped) ──────────── --}}
  {{#if importData.skippedCount}}
  <section class="sde-hub-import-section sde-hub-import-skipped-section">
    <div class="sde-hub-import-sechead">
      <span class="sde-hub-import-sectitle sde-hub-import-sectitle-skipped">
        <i class="fas fa-filter-circle-xmark"></i> {{localize "SDE.importer.skipped.title" n=importData.skippedCount}}
      </span>
    </div>
    <ul class="sde-hub-import-skipped-list">
      {{#each importData.skipped as |s|}}<li><strong>{{s.name}}</strong> — {{s.reason}}</li>{{/each}}
    </ul>
  </section>
  {{/if}}

  {{!-- ═══ Manage / cleanup (collapsible, lazy) ═══ --}}
  <details class="sde-hub-manage" data-manage{{#if manageExpanded}} open{{/if}}>
    <summary class="sde-hub-manage-summary">
      <i class="fas fa-screwdriver-wrench"></i> {{localize "SDE.importer.manage.title"}}
      <span class="sde-hub-manage-hint">{{localize "SDE.importer.manage.hint"}}</span>
    </summary>

    {{#if manage}}
    <div class="sde-hub-manage-body">

      {{!-- Import review tree: Character Content · Spells · Monsters · Items --}}
      <section class="sde-mtree">
        <div class="sde-mtree-topbar">
          <p class="sde-hub-manage-hint sde-mtree-legend">
            <i class="fas fa-circle-check"></i> {{localize "SDE.importer.manage.legendPresent"}} ·
            <i class="fas fa-file-import"></i> {{{localize "SDE.importer.manage.legendMissing"}}}
          </p>
          <div class="sde-mtree-tools">
            <div class="sde-mtree-filter" role="group" aria-label="{{localize 'SDE.importer.manage.filterAria'}}">
              <button type="button" class="sde-mtree-filterbtn{{#if manage.filterAll}} is-on{{/if}}"
                      data-action="manageFilter" data-filter="all" title="{{localize 'SDE.importer.manage.showAllTip'}}">{{localize "SDE.importer.manage.showAll"}}</button>
              <button type="button" class="sde-mtree-filterbtn{{#if manage.filterLocked}} is-on{{/if}}"
                      data-action="manageFilter" data-filter="locked" title="{{localize 'SDE.importer.manage.lockedTip'}}">
                <i class="fas fa-file-import"></i> {{localize "SDE.importer.manage.locked"}}</button>
              <button type="button" class="sde-mtree-filterbtn{{#if manage.filterImported}} is-on{{/if}}"
                      data-action="manageFilter" data-filter="imported" title="{{localize 'SDE.importer.manage.importedTip'}}">
                <i class="fas fa-circle-check"></i> {{localize "SDE.importer.manage.imported"}}</button>
            </div>
            <input type="search" class="sde-mtree-search" data-manage-search value="{{manage.search}}"
                   placeholder="{{localize 'SDE.importer.manage.searchPlaceholder'}}" aria-label="{{localize 'SDE.importer.manage.searchAria'}}"
                   title="{{localize 'SDE.importer.manage.searchTip'}}">
            <button type="button" class="sde-mtree-toolbtn" data-action="manageExpandAll" title="{{localize 'SDE.importer.manage.expandTip'}}">
              <i class="fas fa-angles-down"></i> {{localize "SDE.importer.manage.expandAll"}}
            </button>
            <button type="button" class="sde-mtree-toolbtn" data-action="manageCollapseAll" title="{{localize 'SDE.importer.manage.collapseTip'}}">
              <i class="fas fa-angles-up"></i> {{localize "SDE.importer.manage.collapseAll"}}
            </button>
            {{#if manage.runnableTotal}}
            <button type="button" class="sde-mtree-toolbtn sde-mtree-batchbtn" data-action="batchImport"
                    {{#if batch}}disabled{{/if}}
                    title="{{localize 'SDE.importer.manage.batchTip'}}">
              <i class="fas fa-wand-magic-sparkles"></i> {{localize "SDE.importer.manage.batch" n=manage.runnableTotal}}
            </button>
            {{else if manage.lockedTotal}}
            <span class="sde-mtree-batchnote" title="{{localize 'SDE.importer.manage.noPdfTip'}}">
              <i class="fas fa-file-pdf"></i> {{localize "SDE.importer.manage.noPdf"}}
            </span>
            {{/if}}
          </div>
        </div>

        {{!-- Batch run progress — live while "Import everything" is running --}}
        {{#if batch}}
        <div class="sde-mtree-batchbar" role="status" aria-live="polite">
          <div class="sde-mtree-batchbar-track">
            <div class="sde-mtree-batchbar-fill" style="width: {{batch.percent}}%"></div>
          </div>
          <span class="sde-mtree-batchbar-text">
            {{#if batch.cancelled}}{{localize "SDE.importer.manage.stopping"}}{{else}}{{localize "SDE.importer.manage.importing"}}{{/if}}
            {{batch.done}} / {{batch.total}}{{#if batch.current}} — {{batch.current}}{{/if}}
          </span>
          <button type="button" class="sde-mtree-toolbtn" data-action="batchCancel"
                  {{#if batch.cancelled}}disabled{{/if}} title="{{localize 'SDE.importer.manage.stopTip'}}">
            <i class="fas fa-stop"></i> {{localize "SDE.importer.manage.stop"}}
          </button>
        </div>
        {{/if}}
        {{#if manage.filterEmpty}}
        <p class="sde-import-empty sde-mtree-filter-empty">
          {{#if manage.searching}}<i class="fas fa-magnifying-glass"></i> {{localize "SDE.importer.manage.noMatch" search=manage.search}}{{#unless manage.filterAll}}{{localize "SDE.importer.manage.noMatchFilter"}}{{/unless}}{{localize "SDE.importer.manage.noMatchClear"}}
          {{else if manage.filterLocked}}<i class="fas fa-circle-check"></i> {{localize "SDE.importer.manage.allImported"}}
          {{else}}<i class="fas fa-file-import"></i> {{{localize "SDE.importer.manage.noneImported"}}}{{/if}}
        </p>
        {{/if}}
        {{#each manage.tree as |node|}}
          {{> sdeTreeNode node=node}}
        {{/each}}
      </section>

      {{!-- Monster duplicates (dedup is separate from the census tree) --}}
      {{#if manage.monstersData.hasDuplicates}}
      <section class="sde-hub-monsters-dups">
        <h3 class="sde-hub-monsters-section-title"><i class="fas fa-copy"></i> {{localize "SDE.importer.dups.monsters" n=manage.monstersData.duplicateCount}}</h3>
        <div class="sde-hub-monsters-dup-cards">
          {{#each manage.monstersData.duplicateGroups as |group|}}
          <div class="sde-hub-monsters-dup-card" data-group-key="{{group.key}}">
            <p class="sde-hub-monsters-dup-name">{{group.key}}</p>
            <ul class="sde-hub-monsters-dup-members">
              {{#each group.members as |m|}}
              <li class="sde-hub-monsters-dup-member">
                <label class="sde-hub-monsters-dup-label">
                  <input type="radio" name="keep-{{@../index}}" value="{{m.uuid}}" {{#if @first}}checked{{/if}}>
                  <span class="sde-hub-monsters-dup-member-name">{{m.name}}</span>
                  <span class="sde-hub-monsters-dup-member-meta">
                    {{#if m.source}}<span class="sde-hub-monsters-dup-source">{{m.source}}</span>{{/if}}
                    {{#if m.date}}<span class="sde-hub-monsters-dup-date" title="{{localize 'SDE.importer.dups.lastModified'}}">{{m.date}}</span>{{/if}}
                  </span>
                </label>
              </li>
              {{/each}}
            </ul>
            <button type="button" class="sde-hub-monsters-cull-btn" data-action="monsterCullGroup" data-group-key="{{group.key}}">
              <i class="fas fa-trash-can"></i> {{localize "SDE.importer.dups.cull"}}
            </button>
          </div>
          {{/each}}
        </div>
      </section>
      {{/if}}

      {{!-- Item duplicates (dedup is separate from the census tree) --}}
      {{#if manage.itemsData.hasDuplicates}}
      <section class="sde-hub-monsters-dups">
        <h3 class="sde-hub-monsters-section-title"><i class="fas fa-copy"></i> {{localize "SDE.importer.dups.items" n=manage.itemsData.duplicateCount}}</h3>
        <div class="sde-hub-monsters-dup-cards">
          {{#each manage.itemsData.duplicateGroups as |group|}}
          <div class="sde-hub-monsters-dup-card" data-group-key="{{group.key}}">
            <p class="sde-hub-monsters-dup-name">{{group.key}}</p>
            <ul class="sde-hub-monsters-dup-members">
              {{#each group.members as |m|}}
              <li class="sde-hub-monsters-dup-member">
                <label class="sde-hub-monsters-dup-label">
                  <input type="radio" name="keep-item-{{@../index}}" value="{{m.uuid}}" {{#if @first}}checked{{/if}}>
                  <span class="sde-hub-monsters-dup-member-name">{{m.name}}</span>
                  <span class="sde-hub-monsters-dup-member-meta">
                    {{#if m.source}}<span class="sde-hub-monsters-dup-source">{{m.source}}</span>{{/if}}
                    {{#if m.date}}<span class="sde-hub-monsters-dup-date" title="{{localize 'SDE.importer.dups.lastModified'}}">{{m.date}}</span>{{/if}}
                  </span>
                </label>
              </li>
              {{/each}}
            </ul>
            <button type="button" class="sde-hub-monsters-cull-btn" data-action="itemCullGroup" data-group-key="{{group.key}}">
              <i class="fas fa-trash-can"></i> {{localize "SDE.importer.dups.cull"}}
            </button>
          </div>
          {{/each}}
        </div>
      </section>
      {{/if}}

    </div>
    {{else}}
    <p class="sde-hub-manage-loading"><i class="fas fa-circle-info"></i> {{localize "SDE.importer.manage.loading"}}</p>
    {{/if}}
  </details>

</div>

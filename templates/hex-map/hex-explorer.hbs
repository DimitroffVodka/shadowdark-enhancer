<div class="ui-shell">
{{#if isGM}}
  <header class="ui-head">
    {{#if artSrc}}<button type="button" class="ui-art hx-art" data-action="showArt" title="{{localize 'SDE.hexExplorer.showArt'}}" aria-label="{{localize 'SDE.hexExplorer.showArt'}}"><svg class="hx-pic" viewBox="215 150 500 505" aria-hidden="true"><image href="{{artSrc}}" width="932" height="810"/></svg></button>{{else}}<div class="ui-art hx-art"><i class="fa-solid fa-hexagon"></i></div>{{/if}}
    <div class="ui-head-text"><h2 class="ui-title">{{number}}</h2><p class="ui-sub">{{sceneName}}</p></div>
    <div class="ui-stats">
      <div class="ui-stat"><span class="ui-label">{{localize "SDE.hexExplorer.terrain"}}</span><span class="ui-value">{{terrain}}</span></div>
      <div class="ui-stat"><span class="ui-label">{{localize "SDE.hexExplorer.enter"}}</span><span class="ui-value">{{enter}}</span></div>
      {{#if region}}<div class="ui-stat"><span class="ui-label">{{localize "SDE.hexExplorer.region"}}</span><span class="ui-value">{{region}}</span></div>{{/if}}
    </div>
  </header>
  <div class="ui-body sde-hex-explorer-body">
    <p class="ui-note info">{{localize "SDE.hexExplorer.hint"}}</p>

    <section class="ui-card">
      <label class="ui-field"><span class="ui-label">{{localize "SDE.hexExplorer.terrain"}}</span><select name="terrain" required>{{#each terrainOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}<option value="__other">{{localize "SDE.hexMap.label.otherOption"}}</option></select></label>
      <input name="terrainOther" value="" placeholder="{{localize 'SDE.hexMap.label.otherTerrain'}}" aria-label="{{localize 'SDE.hexMap.label.otherTerrainAria'}}" hidden>
      <label class="ui-field"><span class="ui-label">{{localize "SDE.hexExplorer.locationTitle"}}</span><input name="title" value="{{title}}"></label>
    </section>

    {{#if tileSection}}<section class="ui-card hx-tile">
      <h3 class="ui-h">{{localize "SDE.hexExplorer.tile.title"}}</h3>
      <p class="ui-muted">{{tileNote}}</p>
      {{#unless tileKeyed}}
      <div class="ui-inline">
        <button type="button" class="ui-btn" data-action="tileReroll"><i class="fa-solid fa-dice"></i> {{localize "SDE.hexExplorer.tile.another"}}</button>
        <button type="button" class="ui-btn" data-action="tileChoose" aria-expanded="{{#if tilePickerOpen}}true{{else}}false{{/if}}"><i class="fa-solid fa-table-cells-large"></i> {{localize "SDE.hexExplorer.tile.choose"}}</button>
      </div>
      {{#if tilePickerOpen}}
      <label class="ui-field"><span class="ui-label">{{localize "SDE.hexExplorer.tile.tilesOf"}}</span><select name="tileTerrain">{{#each tileTerrains}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
      <div class="hx-tile-grid">{{#each tileChoices}}<button type="button" class="hx-tile-opt{{#if current}} current{{/if}}" data-action="tileSet" data-src="{{src}}" title="{{name}}" aria-label="{{name}}" aria-pressed="{{#if current}}true{{else}}false{{/if}}"><svg class="hx-pic" viewBox="215 150 500 505" aria-hidden="true"><image href="{{src}}" width="932" height="810"/></svg></button>{{else}}<p class="ui-muted">{{localize "SDE.hexExplorer.tile.none"}}</p>{{/each}}</div>
      {{/if}}
      {{/unless}}
      {{#if bakeAvailable}}<div class="hx-bake">
        <p class="ui-muted">{{localize "SDE.hexExplorer.bake.hint"}}</p>
        <button type="button" class="ui-btn" data-action="bakeMap"><i class="fa-solid fa-fire-burner"></i> {{localize "SDE.hexExplorer.bake.button"}}</button>
      </div>{{/if}}
    </section>{{/if}}

    {{#if keyedSection}}<section class="ui-card">
      <h3 class="ui-h">{{localize "SDE.hexExplorer.keyedPages"}}</h3>
      {{#each keyed}}<div class="ui-row">
        <div class="ui-row-main"><span>{{title}}</span></div>
        <button type="button" class="ui-icon" data-action="openPage" data-uuid="{{uuid}}" title="{{localize 'SDE.hexExplorer.openPage'}}" aria-label="{{localize 'SDE.hexExplorer.openPage'}}"><i class="fa-solid fa-book-open"></i></button>
      </div>{{else}}<p class="ui-muted">{{keyedNote}}</p>{{/each}}
    </section>{{/if}}

    {{#if questSection}}<section class="ui-card">
      <h3 class="ui-h">{{localize "SDE.hexExplorer.quests"}}</h3>
      {{#each quests}}<div class="ui-row">
        <div class="ui-row-main"><span>{{name}}</span><span class="ui-row-sub">{{status}}</span></div>
        <button type="button" class="ui-icon" data-action="openQuest" data-uuid="{{uuid}}" title="{{localize 'SDE.hexExplorer.openQuest'}}" aria-label="{{localize 'SDE.hexExplorer.openQuest'}}"><i class="fa-solid fa-scroll"></i></button>
        <button type="button" class="ui-icon danger" data-action="unlinkQuest" data-uuid="{{uuid}}" title="{{localize 'SDE.hexExplorer.unlinkQuest'}}" aria-label="{{localize 'SDE.hexExplorer.unlinkQuest'}}"><i class="fa-solid fa-link-slash"></i></button>
      </div>{{else}}<p class="ui-muted">{{localize "SDE.hexExplorer.noQuests"}}</p>{{/each}}
      {{#if questChoices.length}}<div class="ui-inline">
        <select name="questPick" aria-label="{{localize 'SDE.hexExplorer.pickQuest'}}">{{#each questChoices}}<option value="{{uuid}}">{{name}} ({{status}}){{where}}</option>{{/each}}</select>
        <button type="button" class="ui-btn" data-action="linkQuest"><i class="fa-solid fa-link"></i> {{localize "SDE.hexExplorer.linkQuest"}}</button>
      </div>{{/if}}
    </section>{{/if}}

    <section class="ui-card">
      <h3 class="ui-h">{{localize "SDE.hexExplorer.encounters"}}</h3>
      <div class="ui-row hx-enc">
        <div class="ui-row-main"><span>{{#if encounter.uuid}}{{encounter.name}}{{else}}{{localize "SDE.hexExplorer.enc.noName"}}{{/if}}</span><span class="ui-row-sub">{{encounter.note}}</span></div>
        <button type="button" class="ui-btn" data-action="rollEncounter" {{#unless encounter.uuid}}disabled{{/unless}}><i class="fa-solid fa-dice"></i> {{localize "SDE.hexExplorer.enc.roll"}}</button>
        <button type="button" class="ui-icon" data-action="openEncounterTable" {{#unless encounter.uuid}}disabled{{/unless}} title="{{localize 'SDE.hexExplorer.enc.open'}}" aria-label="{{localize 'SDE.hexExplorer.enc.open'}}"><i class="fa-solid fa-table-list"></i></button>
      </div>
    </section>

    <section class="ui-card" data-drop="arrival">
      <h3 class="ui-h">{{localize "SDE.hexExplorer.arrival"}}</h3>
      <label class="ui-field"><span class="ui-label">{{localize "SDE.hexExplorer.arrivalTable"}}</span><input name="rollTable" value="{{rollTable}}" placeholder="{{localize 'SDE.hexExplorer.arrivalDrop'}}"></label>
      {{#if arrivalName}}<p class="ui-muted">{{arrivalName}}</p>{{/if}}
      <div class="ui-inline">
        <label class="ui-field"><span class="ui-label">{{localize "SDE.hexExplorer.arrivalChance"}}</span><input type="number" name="rollTableChance" min="0" max="100" step="5" value="{{rollTableChance}}"></label>
        <label class="ui-chip ui-check"><input type="checkbox" name="rollTableFirstOnly" {{checked rollTableFirstOnly}}> {{localize "SDE.hexExplorer.arrivalFirstOnly"}}</label>
      </div>
    </section>

    <section class="ui-card">
      <h3 class="ui-h">{{localize "SDE.hexExplorer.lines"}}</h3>
      <div class="hx-flags">
        {{#each lineRows}}<div class="hx-line">
          <label class="ui-chip ui-check"><input type="checkbox" name="{{type}}" {{checked checked}}> {{label}}</label>
        </div>{{/each}}
      </div>
    </section>

    <section class="ui-card">
      <h3 class="ui-h">{{localize "SDE.hexExplorer.features"}}</h3>
      {{#each features}}<div class="ui-card raised" data-row="feature" data-index="{{index}}">
        <div class="hx-pair">
          <label class="ui-field"><span class="ui-label">{{localize "SDE.hexExplorer.type"}}</span><input data-field="type" value="{{type}}"></label>
          <label class="ui-field"><span class="ui-label">{{localize "SDE.hexExplorer.name"}}</span><input data-field="name" value="{{name}}"></label>
        </div>
        <label class="ui-field"><span class="ui-label">{{localize "SDE.hexExplorer.uuid"}}</span><input data-field="uuid" value="{{uuid}}"></label>
        <div class="ui-inline">
          <label class="ui-chip ui-check"><input type="checkbox" data-field="discovered" {{checked discovered}}> {{localize "SDE.hexExplorer.disclosed"}}</label>
          <button type="button" class="ui-icon danger ui-right" data-action="remove" title="{{localize 'SDE.hexExplorer.remove'}}" aria-label="{{localize 'SDE.hexExplorer.remove'}}"><i class="fa-solid fa-trash"></i></button>
        </div>
      </div>{{/each}}
      <div><button type="button" class="ui-btn" data-action="addFeature"><i class="fa-solid fa-plus"></i> {{localize "SDE.hexExplorer.addFeature"}}</button></div>
    </section>

    <section class="ui-card">
      <h3 class="ui-h">{{localize "SDE.hexExplorer.notes"}}</h3>
      {{#each notes}}<div class="ui-card raised" data-row="note" data-index="{{index}}">
        <label class="ui-field"><span class="ui-label">{{localize "SDE.hexExplorer.note"}}</span><textarea data-field="text">{{text}}</textarea></label>
        <div class="ui-inline">
          <label class="ui-chip ui-check"><input type="checkbox" data-field="visible" {{checked visible}}> {{localize "SDE.hexExplorer.publicNote"}}</label>
          <label class="ui-chip ui-check"><input type="checkbox" data-field="location" {{checked location}}> {{localize "SDE.hexFog.locationNote"}}</label>
          <button type="button" class="ui-icon danger ui-right" data-action="remove" title="{{localize 'SDE.hexExplorer.remove'}}" aria-label="{{localize 'SDE.hexExplorer.remove'}}"><i class="fa-solid fa-trash"></i></button>
        </div>
      </div>{{/each}}
      <div><button type="button" class="ui-btn" data-action="addNote"><i class="fa-solid fa-plus"></i> {{localize "SDE.hexExplorer.addNote"}}</button></div>
    </section>

    <section class="ui-card" data-drop="links">
      <h3 class="ui-h">{{localize "SDE.hexExplorer.links"}}</h3>
      {{#each links}}<div class="ui-card raised" data-row="link" data-index="{{index}}">
        <label class="ui-field"><span class="ui-label">{{localize "SDE.hexExplorer.name"}}</span><input data-field="label" value="{{label}}"></label>
        <label class="ui-field"><span class="ui-label">{{localize "SDE.hexExplorer.uuid"}}</span><input data-field="uuid" value="{{uuid}}"></label>
        <div class="ui-inline">
          <label class="ui-chip ui-check"><input type="checkbox" data-field="visible" {{checked visible}}> {{localize "SDE.hexExplorer.disclosed"}}</label>
          <label class="ui-chip ui-check"><input type="checkbox" data-field="share" {{checked share}}> {{localize "SDE.hexExplorer.linkShare"}}</label>
          <button type="button" class="ui-icon" data-action="openPage" data-uuid="{{uuid}}" title="{{localize 'SDE.hexExplorer.openLink'}}" aria-label="{{localize 'SDE.hexExplorer.openLink'}}"><i class="fa-solid fa-book-open"></i></button>
          <button type="button" class="ui-icon danger ui-right" data-action="remove" title="{{localize 'SDE.hexExplorer.remove'}}" aria-label="{{localize 'SDE.hexExplorer.remove'}}"><i class="fa-solid fa-trash"></i></button>
        </div>
        {{#if warn}}<div class="ui-note warn"><i class="fa-solid fa-triangle-exclamation"></i> {{localize "SDE.hexExplorer.linkWarn"}}</div>{{/if}}
      </div>{{/each}}
      <p class="ui-muted">{{localize "SDE.hexExplorer.dropLink"}}</p>
      <div><button type="button" class="ui-btn" data-action="addLink"><i class="fa-solid fa-plus"></i> {{localize "SDE.hexExplorer.addLink"}}</button></div>
    </section>

    <section class="ui-card">
      <h3 class="ui-h">{{localize "SDE.hexExplorer.discovery"}}</h3>
      <div class="hx-flags">
        <label class="ui-chip ui-check"><input type="checkbox" name="revealed" {{checked revealed}}> {{localize "SDE.hexExplorer.revealed"}}</label>
        <label class="ui-chip ui-check"><input type="checkbox" name="visited" {{checked visited}}> {{localize "SDE.hexExplorer.visited"}}</label>
      </div>
      <label class="ui-field"><span class="ui-label">{{localize "SDE.hexExplorer.keyed"}}</span><select name="location">
        <option value="auto" {{#if locationAuto}}selected{{/if}}>{{localize "SDE.hexExplorer.auto"}}</option>
        <option value="show" {{#if locationShow}}selected{{/if}}>{{localize "SDE.hexExplorer.show"}}</option>
        <option value="hide" {{#if locationHide}}selected{{/if}}>{{localize "SDE.hexExplorer.hide"}}</option>
      </select></label>
    </section>
  </div>
  <footer class="ui-footer"><div class="ui-right"><button type="button" class="ui-btn primary" data-action="save" {{#if saving}}disabled{{/if}}><i class="fa-solid fa-floppy-disk"></i> {{localize "SDE.hexExplorer.save"}}</button></div></footer>
{{/if}}
  {{#if tilePickerOpen}}<div class="hx-tile-zoom" hidden aria-hidden="true"><svg class="hx-pic" viewBox="215 150 500 505"><image width="932" height="810"/></svg><span class="hx-tile-zoom-name"></span></div>{{/if}}
</div>

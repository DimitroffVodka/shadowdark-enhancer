{{!-- Session Recap: 5 tabs (History moves to the footer; it is the same changeTab action). Same context and data-* as templates/session-recap.hbs. --}}
<div class="ui-shell">

  <header class="ui-head">
    <div class="ui-head-text">
      <p class="ui-label">{{sessionStatusLabel}}</p>
      <h2 class="ui-title">{{sessionDisplayName}}</h2>
      <div class="ui-inline sr-stats">{{#each sessionStats}}<span class="ui-chip">{{label}}</span>{{/each}}</div>
    </div>
  </header>

  <nav class="ui-tabs">
    <button type="button" class="ui-tab {{#if tab.overview}}active{{/if}}" data-action="changeTab" data-tab="overview"><i class="fas fa-chart-pie"></i> {{localize "SDE.sessionRecap.ui.overview"}}</button>
    <button type="button" class="ui-tab {{#if tab.combat}}active{{/if}}" data-action="changeTab" data-tab="combat"><i class="fas fa-khanda"></i> {{localize "SDE.sessionRecap.discord.combat"}}</button>
    <button type="button" class="ui-tab {{#if tab.loot}}active{{/if}}" data-action="changeTab" data-tab="loot"><i class="fas fa-coins"></i> {{localize "SDE.sessionRecap.discord.loot"}}</button>
    <button type="button" class="ui-tab {{#if tab.xp}}active{{/if}}" data-action="changeTab" data-tab="xp"><i class="fas fa-star"></i> {{localize "SDE.sessionRecap.ui.xpRenown"}}</button>
    <button type="button" class="ui-tab {{#if tab.downtime}}active{{/if}}" data-action="changeTab" data-tab="downtime"><i class="fas fa-mug-hot"></i> {{localize "SDE.sessionRecap.ui.downtimeCarousing"}}</button>
  </nav>

  <div class="ui-body">
    {{#if isViewingHistory}}
    <div class="ui-note info sr-viewing">
      <span><i class="fas fa-eye"></i> {{localize "SDE.sessionRecap.ui.viewing"}} <strong>{{viewingSession.name}}</strong></span>
      <button type="button" class="ui-btn" data-action="backToCurrent"><i class="fas fa-arrow-left"></i> {{localize "SDE.sessionRecap.ui.backToCurrent"}}</button>
    </div>
    {{/if}}

    {{#if tab.overview}}
      {{#if hasEncounterChecks}}<div class="ui-note"><i class="fas fa-dice-d6"></i> {{encounterSummary}}</div>{{/if}}
      {{#if hasPlayerSummaries}}
      <section class="ui-group">
        <h3 class="ui-h">{{localize "SDE.sessionRecap.ui.theParty"}}</h3>
        <div class="sr-grid">
          {{#each playerSummaries}}
          <article class="ui-card">
            <h4 class="ui-card-name">{{name}}</h4>
            <div class="ui-pairs sr-pairs">
              <div class="ui-pair"><span class="ui-label">{{localize "SDE.sessionRecap.ui.kills"}}</span><span class="ui-value">{{kills}}</span></div>
              <div class="ui-pair"><span class="ui-label">{{localize "SDE.sessionRecap.ui.dealt"}}</span><span class="ui-value">{{damageDealt}}</span></div>
              <div class="ui-pair"><span class="ui-label">{{localize "SDE.sessionRecap.ui.taken"}}</span><span class="ui-value">{{damageTaken}}</span></div>
              <div class="ui-pair"><span class="ui-label">{{localize "SDE.sessionRecap.discord.xp"}}</span><span class="ui-value">{{totalXp}}</span></div>
            </div>
          </article>
          {{/each}}
        </div>
      </section>
      {{else}}
      <div class="ui-empty"><i class="fas fa-scroll"></i><span>{{localize "SDE.sessionRecap.ui.noActivity"}}</span></div>
      {{/if}}
    {{/if}}

    {{#if tab.combat}}
      {{#unless hasDamageLog}}<div class="ui-note info"><i class="fas fa-info-circle"></i> {{{localize "SDE.sessionRecap.ui.damageLogNotice"}}}</div>{{/unless}}
      {{#if hasCombats}}
      <section class="ui-group">
        {{#each combats}}
        <article class="ui-card {{#if expanded}}raised{{/if}}">
          <div class="ui-card-head sr-click" data-action="toggleEncounter" data-index="{{index}}">
            <i class="fas {{#if expanded}}fa-chevron-down{{else}}fa-chevron-right{{/if}} ui-muted"></i>
            <h4 class="ui-card-name">{{label}}</h4>
            <span class="ui-card-sub">{{localize "SDE.sessionRecap.discord.rounds" n=rounds}}{{#if duration}} ({{duration}}){{/if}}</span>
            <span class="ui-chip gold">{{localize "SDE.sessionRecap.ui.defeatedOf" defeated=totalDefeated total=totalEnemies}}</span>
          </div>
          {{#if expanded}}
          <div class="ui-inline">
            {{#each enemies}}<span class="ui-chip {{#unless defeated}}sel{{/unless}}">{{#if defeated}}<i class="fas fa-skull ui-muted"></i> <span class="sr-down">{{name}}</span>{{#if killedBy}} <em class="ui-muted">({{killedBy}})</em>{{/if}}{{else}}{{name}}{{/if}}</span>{{/each}}
          </div>
          {{/if}}
        </article>
        {{/each}}
      </section>
      {{else}}
      <div class="ui-empty"><i class="fas fa-khanda"></i><span>{{localize "SDE.sessionRecap.ui.noCombats"}}</span></div>
      {{/if}}

      {{#if hasPlayerStats}}
      <section class="ui-group">
        <h3 class="ui-h">{{localize "SDE.sessionRecap.ui.rollStats"}}</h3>
        <div class="sr-wrap"><table class="ui-table">
          <thead><tr><th>{{localize "SDE.sessionRecap.ui.player"}}</th><th class="num">{{localize "SDE.sessionRecap.ui.hitRate"}}</th><th class="num">{{localize "SDE.sessionRecap.ui.nat20"}}</th><th class="num">{{localize "SDE.sessionRecap.ui.nat1"}}</th><th class="num">{{localize "SDE.sessionRecap.ui.avgD20"}}</th><th class="num">{{localize "SDE.sessionRecap.ui.checks"}}</th><th class="num">{{localize "SDE.sessionRecap.ui.dealt"}}</th><th class="num">{{localize "SDE.sessionRecap.ui.taken"}}</th><th class="num">{{localize "SDE.sessionRecap.ui.kills"}}</th></tr></thead>
          <tbody>{{#each playerStatsTable}}<tr><td><strong>{{name}}</strong></td><td class="num">{{hitRate}}</td><td class="num">{{nat20s}}</td><td class="num">{{nat1s}}</td><td class="num">{{avgD20}}</td><td class="num">{{saveRate}}</td><td class="num">{{damageDealt}}</td><td class="num">{{damageTaken}}</td><td class="num">{{kills}}</td></tr>{{/each}}</tbody>
        </table></div>
      </section>
      {{/if}}
    {{/if}}

    {{#if tab.loot}}
      {{#if hasLoot}}
      <div class="ui-list">
        {{#each lootEntries}}
        <div class="ui-row {{#if unclaimed}}sr-unclaimed{{/if}}">
          <span class="ui-tag">{{time}}</span>
          <span class="sr-icon">{{{iconHtml}}}</span>
          <div class="ui-row-main"><span class="ui-row-name">{{detail}}</span><span class="ui-row-sub">{{player}}</span></div>
          {{#if source}}<span class="ui-chip">{{source}}</span>{{/if}}
        </div>
        {{/each}}
      </div>
      {{else}}
      <div class="ui-empty"><i class="fas fa-coins"></i><span>{{localize "SDE.sessionRecap.ui.noLoot"}}</span></div>
      {{/if}}

      {{#if hasMerchant}}
      <section class="ui-group">
        <h3 class="ui-h">{{localize "SDE.sessionRecap.ui.merchant"}}</h3>
        <div class="ui-cols-2">
        {{#if purchases.length}}
        <article class="ui-card">
          <div class="ui-card-head"><i class="fas fa-shopping-bag ui-muted"></i><h4 class="ui-card-name">{{localize "SDE.sessionRecap.discord.purchases"}}</h4></div>
          {{#each purchases}}
          <div class="ui-row-main"><div class="ui-card-head"><span class="ui-row-name ui-grow">{{player}}</span><span class="ui-row-meta">{{subtotal}}</span></div>
            {{#each items}}<span class="ui-row-sub">{{item}}{{qtyLabel}} - {{price}}</span>{{/each}}</div>
          {{/each}}
        </article>
        {{/if}}
        {{#if sales.length}}
        <article class="ui-card">
          <div class="ui-card-head"><i class="fas fa-hand-holding-usd ui-muted"></i><h4 class="ui-card-name">{{localize "SDE.sessionRecap.discord.sales"}}</h4></div>
          {{#each sales}}
          <div class="ui-row-main"><div class="ui-card-head"><span class="ui-row-name ui-grow">{{player}}</span><span class="ui-row-meta">{{subtotal}}</span></div>
            {{#each items}}<span class="ui-row-sub">{{item}}{{qtyLabel}} - {{price}}{{#if ratio}} ({{ratio}}){{/if}}</span>{{/each}}</div>
          {{/each}}
        </article>
        {{/if}}
        </div>
      </section>
      {{/if}}
    {{/if}}

    {{#if tab.xp}}
      {{#if hasXp}}
      <section class="ui-group"><div class="ui-cols-2">
        {{#each xpPlayers}}
        <article class="ui-card">
          <div class="ui-card-head"><h4 class="ui-card-name">{{player}}</h4><span class="ui-chip gold">{{localize "SDE.sessionRecap.discord.totalXp" n=total}}</span></div>
          <div class="ui-list sr-flat">{{#each awards}}<div class="ui-row"><span class="ui-tag">{{time}}</span><span class="ui-row-main">{{label}}</span><span class="ui-row-meta">+{{totalXp}} XP</span></div>{{/each}}</div>
        </article>
        {{/each}}
      </div></section>
      {{else}}
      <div class="ui-empty"><i class="fas fa-star"></i><span>{{localize "SDE.sessionRecap.ui.noXp"}}</span></div>
      {{/if}}

      {{#if hasRenown}}
      <section class="ui-group">
        <h3 class="ui-h"><span><i class="fas fa-crown"></i> {{localize "SDE.sessionRecap.discord.renown"}}</span></h3>
        <div class="ui-cols-2">
        {{#each renownPlayers}}
        <article class="ui-card">
          <div class="ui-card-head"><h4 class="ui-card-name">{{player}}</h4><span class="ui-chip gold">{{localize "SDE.sessionRecap.ui.net" net=net}}</span></div>
          <div class="ui-list sr-flat">{{#each changes}}<div class="ui-row"><span class="ui-tag">{{time}}</span><span class="ui-row-main">{{text}}</span></div>{{/each}}</div>
        </article>
        {{/each}}
        </div>
      </section>
      {{/if}}
    {{/if}}

    {{#if tab.downtime}}
      {{#if hasDowntime}}
      <section class="ui-group"><div class="ui-cols-2">
        {{#each downtimePlayers}}
        <article class="ui-card">
          <div class="ui-card-head"><i class="fas fa-mug-hot ui-muted"></i><h4 class="ui-card-name">{{player}}</h4><span class="ui-chip">{{localize "SDE.sessionRecap.ui.attempts"}}: {{subtotal}}</span></div>
          <div class="ui-list sr-flat">{{#each rows}}<div class="ui-row"><div class="ui-row-main"><span class="ui-row-name sr-plain">{{#if time}}{{time}} - {{/if}}{{text}}</span>{{#if effect}}<span class="ui-row-sub">{{effect}}</span>{{/if}}</div></div>{{/each}}</div>
        </article>
        {{/each}}
      </div></section>
      {{else}}
      <div class="ui-empty"><i class="fas fa-mug-hot"></i><span>{{localize "SDE.sessionRecap.ui.noDowntime"}}</span></div>
      {{/if}}

      {{#if hasCarousing}}
      <section class="ui-group">
        <h3 class="ui-h"><span><i class="fas fa-beer-mug-empty"></i> {{localize "SDE.sessionRecap.discord.carousing"}}</span></h3>
        {{#each carousing}}
        <article class="ui-card">
          <div class="ui-card-head"><h4 class="ui-card-name">{{heading}}</h4>{{#if tier}}<span class="ui-chip">{{tier}}</span>{{/if}}<span class="ui-chip">{{localize "SDE.sessionRecap.ui.carousers"}}: {{subtotal}}</span></div>
          <div class="ui-list sr-flat">
            {{#each rows}}<div class="ui-row"><div class="ui-row-main"><span class="ui-row-name sr-plain">{{text}}{{#if player}} <span class="ui-muted">({{player}})</span>{{/if}}</span>
              {{#each benefits}}<span class="ui-row-sub">{{localize "SDE.sessionRecap.discord.benefit" text=this}}</span>{{/each}}
              {{#each mishaps}}<span class="ui-row-sub">{{localize "SDE.sessionRecap.discord.mishap" text=this}}</span>{{/each}}
              {{#if applied}}<span class="ui-row-sub">{{applied}}</span>{{/if}}
              {{#if pending}}<span class="ui-row-sub">{{localize "SDE.sessionRecap.discord.notApplied"}}</span>{{/if}}</div></div>{{/each}}
          </div>
        </article>
        {{/each}}
      </section>
      {{/if}}

      {{#if hasRumors}}
      <section class="ui-group">
        <h3 class="ui-h"><span><i class="fas fa-comments"></i> {{localize "SDE.sessionRecap.discord.rumors"}}</span></h3>
        <div class="ui-list">{{#each rumors}}<div class="ui-row"><span class="ui-tag">{{time}}</span><div class="ui-row-main"><span class="ui-row-name sr-plain">{{text}}</span>{{#if region}}<span class="ui-row-sub">{{region}}</span>{{/if}}</div></div>{{/each}}</div>
      </section>
      {{/if}}
    {{/if}}

    {{#if tab.history}}
      {{#if hasHistory}}
      <div class="ui-list">
        {{#each historyEntries}}
        <div class="ui-row sr-click" data-action="viewSession" data-session-id="{{id}}">
          <div class="ui-row-main"><span class="ui-row-name">{{name}}</span><span class="ui-row-sub">{{localize "SDE.sessionRecap.ui.historyMeta" duration=duration combats=combatCount defeated=enemiesDefeated loot=lootCount}}</span></div>
          {{#if ../isGM}}<button type="button" class="ui-icon danger" data-action="deleteSession" data-session-id="{{id}}"><i class="fas fa-trash"></i></button>{{/if}}
        </div>
        {{/each}}
      </div>
      {{else}}
      <div class="ui-empty"><i class="fas fa-book"></i><span>{{localize "SDE.sessionRecap.ui.noHistory"}}</span></div>
      {{/if}}
    {{/if}}
  </div>

  <footer class="ui-footer">
    <button type="button" class="ui-btn {{#unless tab.history}}ghost{{/unless}}" data-action="changeTab" data-tab="history"><i class="fas fa-book"></i> {{localize "SDE.sessionRecap.ui.history"}}</button>
    {{#if isGM}}{{#unless isViewingHistory}}<button type="button" class="ui-btn danger" data-action="clearSession"><i class="fas fa-trash"></i> {{localize "SDE.sessionRecap.dialog.clearTitle"}}</button>{{/unless}}{{/if}}
    <div class="ui-right"><button type="button" class="ui-btn primary" data-action="copyDiscord"><i class="fab fa-discord"></i> {{localize "SDE.sessionRecap.ui.copyDiscord"}}</button></div>
  </footer>
</div>

<div class="sde-class-importer sde-item-builder">

  <div class="sde-ci-head">
    <div class="sde-ci-title"><i class="fa-solid fa-boxes-stacked"></i> {{localize "SDE.importer.itemBuilder.title"}}</div>
    <div class="sde-ci-headright">
      <span class="sde-ci-buildlabel">{{localize "SDE.importer.itemBuilder.building"}}</span>
      <span class="sde-ci-chip{{#if itemCount}} sde-ci-chip-on{{/if}}">{{typeLabel}}{{#if itemCount}} · {{itemCount}}{{/if}}</span>
      <button type="button" data-action="ibStartOver" class="sde-cu-btn" title="{{localize 'SDE.importer.itemBuilder.startOverTip'}}"><i class="fas fa-rotate-left"></i> {{localize "SDE.importer.itemBuilder.startOver"}}</button>
    </div>
  </div>

  <div class="sde-ib-fields">
    <label class="sde-ci-sourcefield">
      <span class="sde-ci-fieldname">{{localize "SDE.importer.source.label"}}</span>
      <input type="text" data-ib-source list="sde-ib-sources" value="{{source}}" placeholder="{{localize 'SDE.importer.itemBuilder.sourcePlaceholder'}}">
      <datalist id="sde-ib-sources">{{#each sourceList as |s|}}<option value="{{s}}"></option>{{/each}}</datalist>
    </label>
    <label class="sde-ci-sourcefield">
      <span class="sde-ci-fieldname">{{localize "SDE.charBuilder.gear.type"}}</span>
      <select data-ib-type class="sde-mimport-sel">
        {{#each gearTypes as |g|}}<option value="{{g.value}}" {{#if g.selected}}selected{{/if}}>{{g.label}}</option>{{/each}}
      </select>
    </label>
  </div>

  {{!-- ── Stage 1 · Table ─────────────────────────────────────────────── --}}
  <div class="sde-ci-stage">
    <div class="sde-ci-stagehead">{{localize "SDE.importer.itemBuilder.stage1"}} <span class="sde-ci-status">{{localize "SDE.importer.itemBuilder.stage1Status"}}</span></div>
    <p class="sde-ci-note">{{{localize "SDE.importer.itemBuilder.stage1Note"}}}</p>
    <textarea data-ib-table class="sde-ci-paste sde-ci-bodypaste" placeholder="{{localize 'SDE.importer.itemBuilder.tablePlaceholder'}}">{{tableText}}</textarea>
    <div class="sde-ci-bodybtns">
      {{#if tablePage}}<button type="button" data-action="ibGrabTable" class="sde-cu-btn" title="{{localize 'SDE.importer.itemBuilder.grabTableTip'}}"><i class="fas fa-wand-magic-sparkles"></i> {{localize "SDE.importer.itemBuilder.grabTable" page=tablePage}}</button>{{/if}}
      <button type="button" data-action="ibParseTable" class="sde-cu-btn"><i class="fas fa-eye"></i> {{localize "SDE.importer.itemBuilder.parseTable"}}</button>
      {{#if tablePdf}}<button type="button" data-action="ibOpenPdf" data-href="{{tablePdf}}" data-title="{{localize 'SDE.importer.itemBuilder.pdfTitleTable' type=typeLabel page=tablePage}}" class="sde-cu-btn"><i class="fas fa-file-pdf"></i> {{localize "SDE.importer.itemBuilder.openPdf" page=tablePage}}</button>{{/if}}
    </div>
    {{#if systemDupeCount}}<p class="sde-ci-note sde-ci-note-info"><i class="fas fa-circle-check"></i> {{localize "SDE.importer.itemBuilder.systemDupes" n=systemDupeCount}} {{#each systemDupes as |n|}}<code>{{n}}</code> {{/each}}</p>{{/if}}
    {{#if droppedCount}}<p class="sde-ci-note sde-ci-note-info"><i class="fas fa-broom"></i> {{localize "SDE.importer.itemBuilder.dropped" n=droppedCount}} {{#each dropped as |d|}}<code title="{{d.reason}}">{{d.text}}</code> {{/each}}</p>{{/if}}
  </div>

  {{!-- ── Stage 2 · Descriptions ──────────────────────────────────────── --}}
  <div class="sde-ci-stage">
    <div class="sde-ci-stagehead">{{localize "SDE.importer.itemBuilder.stage2"}} <span class="sde-ci-status">{{#if itemCount}}{{localize "SDE.importer.itemBuilder.stage2Filled" filled=withDesc total=itemCount}}{{else}}{{localize "SDE.importer.itemBuilder.stage2Empty"}}{{/if}}</span></div>
    <p class="sde-ci-note">{{{localize "SDE.importer.itemBuilder.stage2Note"}}}</p>
    <textarea data-ib-desc class="sde-ci-paste sde-ci-bodypaste" placeholder="{{localize 'SDE.importer.itemBuilder.descPlaceholder'}}">{{descText}}</textarea>
    <div class="sde-ci-bodybtns">
      {{#if descPage}}<button type="button" data-action="ibGrabDesc" class="sde-cu-btn" title="{{localize 'SDE.importer.itemBuilder.grabDescTip'}}"><i class="fas fa-wand-magic-sparkles"></i> {{localize "SDE.importer.itemBuilder.grabDesc" page=descPage}}</button>{{/if}}
      <button type="button" data-action="ibMatchDesc" class="sde-cu-btn"><i class="fas fa-link"></i> {{localize "SDE.importer.itemBuilder.matchDesc"}}</button>
      {{#if descPdf}}<button type="button" data-action="ibOpenPdf" data-href="{{descPdf}}" data-title="{{localize 'SDE.importer.itemBuilder.pdfTitleDesc' type=typeLabel page=descPage}}" class="sde-cu-btn"><i class="fas fa-file-pdf"></i> {{localize "SDE.importer.itemBuilder.openPdf" page=descPage}}</button>{{/if}}
    </div>
    <p class="sde-ci-note sde-ci-note-info"><i class="fas fa-circle-info"></i> {{localize "SDE.importer.itemBuilder.stage2Hint"}}</p>
  </div>

  {{!-- ── Combined items — reviewable/editable ────────────────────────── --}}
  {{#if itemCount}}
  <div class="sde-ci-stagehead">{{localize "SDE.importer.items.title" n=itemCount}}{{#if needDesc}} · <span class="sde-ci-status">{{localize "SDE.importer.itemBuilder.needDesc" n=needDesc}}</span>{{/if}}</div>
  <table class="sde-class-preview-table sde-ib-items">
    <tr class="sde-cu-titlehead"><th>{{localize "SDE.importer.common.nameCap"}}</th><th>{{localize "SDE.importer.boats.cost"}}</th><th>{{localize "SDE.importer.boats.slots"}}</th><th>{{localize "SDE.importer.common.descriptionCap"}}</th><th></th></tr>
    {{#each items as |it|}}
    <tr data-ib-row="{{it.idx}}" class="{{#unless it.hasDesc}}sde-ci-talent-unwired{{/unless}}">
      <td><input type="text" data-ib-field="name" value="{{it.name}}" class="sde-cu-text" aria-label="{{localize 'SDE.importer.items.nameAria'}}">
        {{#if it.stats}}<div class="sde-ci-status">{{it.stats}}</div>{{/if}}
        {{#if it.flag}}<div class="sde-ci-status" title="{{it.flag}}"><i class="fas fa-triangle-exclamation"></i> {{localize "SDE.importer.common.review"}}</div>{{/if}}
      </td>
      <td><input type="text" data-ib-field="cost" value="{{it.cost}}" class="sde-cu-range" aria-label="{{localize 'SDE.importer.boats.cost'}}"></td>
      <td class="sde-ib-slots">{{it.slots}}</td>
      <td><input type="text" data-ib-field="description" value="{{it.description}}" class="sde-cu-text" placeholder="{{#unless it.hasDesc}}{{localize 'SDE.importer.itemBuilder.noDescPlaceholder'}}{{/unless}}" aria-label="{{localize 'SDE.importer.common.descriptionCap'}}"></td>
      <td class="sde-cu-rowdel"><button type="button" data-action="ibRowDel" class="sde-cu-btn sde-cu-btn-del" title="{{localize 'SDE.importer.items.removeAria'}}"><i class="fas fa-trash"></i></button></td>
    </tr>
    {{/each}}
  </table>
  {{/if}}

  {{!-- ── Stage 3 · Combine & create ──────────────────────────────────── --}}
  <div class="sde-ci-footer">
    <span class="sde-ci-pending">
      {{#if itemCount}}{{localize "SDE.importer.itemBuilder.ready" n=itemCount type=typeLabel filled=withDesc}}{{else}}{{localize "SDE.importer.itemBuilder.readyEmpty"}}{{/if}}
      {{#if report}} · <i class="fas fa-circle-check"></i> {{localize "SDE.importer.itemBuilder.reportCreated" n=report.created}}{{#if report.replaced}}{{localize "SDE.importer.itemBuilder.reportUpdated" n=report.replaced}}{{/if}}{{/if}}
    </span>
    <button type="button" data-action="ibCreate" class="sde-import-primary"{{#unless itemCount}} disabled{{/unless}}><i class="fas fa-circle-plus"></i> {{localize "SDE.importer.itemBuilder.createN" n=itemCount}}</button>
  </div>

</div>

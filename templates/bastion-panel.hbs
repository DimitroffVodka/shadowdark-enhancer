<div class="sde-bp">
  {{#if gm}}
  <div class="sde-bp-toolbar">
    <button type="button" data-action="newBastion"><i class="fa-solid fa-plus"></i> {{localize "SDE.bastion.panel.new"}}</button>
  </div>
  {{/if}}

  {{#if cards.length}}
  <div class="sde-bp-cards">
    {{#each cards}}
    <article class="sde-bp-card {{#if breached}}breached{{/if}}">
      <img class="art" src="{{img}}" alt="" data-action="openSheet" data-id="{{id}}" />
      <div class="body">
        <header>
          <strong data-action="openSheet" data-id="{{id}}">{{name}}</strong>
          <span>{{typeName}}</span>
        </header>
        <p class="line">{{line}}</p>
        <div class="hp" role="img" aria-label="{{localize 'SDE.bastion.stat.hp'}} {{hp}} / {{maxHp}}">
          <i style="width: {{hpPct}}%"></i><span>{{localize "SDE.bastion.stat.hp"}} {{hp}} / {{maxHp}}</span>
        </div>
        <div class="figs">
          <span>{{localize "SDE.bastion.stat.treasury"}}: {{treasury}} {{localize "SDE.bastion.gp"}}</span>
          <span>{{localize "SDE.bastion.stat.upgrades"}}: {{used}} / {{slots}}</span>
        </div>
        <div class="built">
          {{#each built}}<svg viewBox="0 0 512 512"><title>{{name}}</title><rect width="512" height="512" fill="#85A478"/><use href="#b-{{id}}" width="512" height="512"/></svg>{{/each}}
          {{#each building}}<svg class="faint" viewBox="0 0 512 512"><title>{{name}}</title><rect width="512" height="512" fill="#85A478"/><use href="#b-{{id}}" width="512" height="512"/></svg>{{/each}}
        </div>
        <footer>
          <button type="button" data-action="openSheet" data-id="{{id}}">{{localize "SDE.bastion.panel.open"}}</button>
          {{#if ../gm}}
          <button type="button" data-action="deposit" data-id="{{id}}"><i class="fa-solid fa-coins"></i> {{localize "SDE.bastion.fund.deposit"}}</button>
          <button type="button" data-action="withdraw" data-id="{{id}}"><i class="fa-solid fa-hand-holding-dollar"></i> {{localize "SDE.bastion.fund.withdraw"}}</button>
          {{/if}}
        </footer>
      </div>
    </article>
    {{/each}}
  </div>
  {{else}}
  <p class="sde-bp-empty">{{empty}}</p>
  {{/if}}
</div>

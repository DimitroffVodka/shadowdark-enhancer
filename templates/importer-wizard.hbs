<div class="sde-wiz" data-page="{{page}}">

  <header class="sde-wiz-head">
    <div class="sde-wiz-titles">
      <h2 class="sde-wiz-title">{{title}}</h2>
      <p class="sde-wiz-sub">{{subtitle}}</p>
    </div>
    <ol class="sde-wiz-dots" aria-label="{{stepLabel}}">
      {{#each dots}}<li class="{{#if current}}is-current{{/if}}{{#if done}} is-done{{/if}}"></li>{{/each}}
    </ol>
  </header>

  <div class="sde-wiz-body">

    {{#if isWelcome}}
    <div class="sde-wiz-card">
      <p>{{#if update}}{{update.lead}}{{else}}{{localize "SDE.importer.wizard.welcome.what"}}{{/if}}</p>
    </div>
    <div class="sde-wiz-card">
      <h3>{{localize "SDE.importer.wizard.welcome.needTitle"}}</h3>
      <ul class="sde-wiz-list">
        <li><i class="fas fa-file-pdf"></i> {{localize "SDE.importer.wizard.welcome.needBooks"}}</li>
        <li><i class="fas fa-map"></i> {{localize "SDE.importer.wizard.welcome.needMaps"}}</li>
      </ul>
      <p class="sde-wiz-muted">{{localize "SDE.importer.wizard.welcome.safe"}}</p>
    </div>
    {{/if}}

    {{#if isKeep}}
    <label class="sde-wiz-opt{{#if keepOnce}} is-picked{{/if}}">
      <input type="radio" name="keep" value="once" data-action="setKeep" {{#if keepOnce}}checked{{/if}}>
      <span><strong>{{localize "SDE.importer.wizard.keep.once"}}</strong><small>{{localize "SDE.importer.wizard.keep.onceHelp"}}</small></span>
    </label>
    <label class="sde-wiz-opt{{#unless keepOnce}} is-picked{{/unless}}">
      <input type="radio" name="keep" value="keep" data-action="setKeep" {{#unless keepOnce}}checked{{/unless}}>
      <span><strong>{{localize "SDE.importer.wizard.keep.keep"}}</strong><small>{{keepHelp}}</small></span>
    </label>
    <p class="sde-wiz-muted">{{localize "SDE.importer.wizard.keep.maps"}}</p>
    {{#if forgeNote}}<div class="sde-wiz-card sde-wiz-note"><i class="fas fa-circle-info"></i><p>{{forgeNote}}</p></div>{{/if}}
    {{/if}}

    {{#if isBooks}}
    <div class="sde-wiz-drop" data-dropzone>
      <i class="fas fa-file-pdf"></i>
      <p>{{localize "SDE.importer.wizard.books.drop"}}</p>
      <button type="button" class="sde-import-primary" data-action="choose">{{localize "SDE.importer.wizard.choose"}}</button>
      <input type="file" multiple accept=".pdf,.zip,application/pdf,application/zip" hidden data-picker>
    </div>
    <p class="sde-wiz-count"><strong>{{books.have}}</strong> {{localize "SDE.importer.wizard.books.ofTotal" total=books.total}}</p>
    {{#if notice}}<div class="sde-wiz-card sde-wiz-note"><i class="fas fa-circle-info"></i><p>{{notice}}</p></div>{{/if}}
    <ul class="sde-wiz-files">
      {{#each books.rows}}
      <li class="sde-wiz-file{{#if added}} is-added{{/if}}">
        <i class="fas {{#if added}}fa-circle-check{{else}}fa-circle{{/if}}"></i>
        <span class="sde-wiz-file-name">{{title}}{{#if fileName}}<small>{{fileName}}</small>{{/if}}</span>
        <span class="sde-wiz-file-size">{{size}}</span>
        {{#if added}}<button type="button" class="sde-wiz-x" data-action="remove" data-kind="book" data-id="{{id}}" aria-label="{{../removeLabel}}"><i class="fas fa-xmark"></i></button>{{/if}}
      </li>
      {{/each}}
    </ul>
    {{/if}}

    {{#if isMaps}}
    <div class="sde-wiz-drop" data-dropzone>
      <i class="fas fa-map"></i>
      <p>{{localize "SDE.importer.wizard.maps.drop"}}</p>
      <button type="button" class="sde-import-primary" data-action="choose">{{localize "SDE.importer.wizard.choose"}}</button>
      <input type="file" multiple accept="image/*,.zip,application/zip" hidden data-picker>
    </div>
    <p class="sde-wiz-count"><strong>{{maps.have}}</strong> {{localize "SDE.importer.wizard.maps.ofTotal" total=maps.total}}</p>
    {{#if notice}}<div class="sde-wiz-card sde-wiz-note"><i class="fas fa-circle-info"></i><p>{{notice}}</p></div>{{/if}}
    {{#each maps.groups}}
    <section class="sde-wiz-group{{#if open}} is-open{{/if}}">
      <button type="button" class="sde-wiz-group-head" data-action="toggleGroup" data-id="{{src}}" aria-expanded="{{#if open}}true{{else}}false{{/if}}">
        <i class="fas {{#if open}}fa-chevron-down{{else}}fa-chevron-right{{/if}}"></i>
        <span>{{title}}</span><em>{{have}} / {{rows.length}}</em>
      </button>
      {{#if open}}
      <ul class="sde-wiz-files">
        {{#each rows}}
        <li class="sde-wiz-file{{#if added}} is-added{{/if}}">
          <i class="fas {{#if added}}fa-circle-check{{else}}fa-circle{{/if}}"></i>
          <span class="sde-wiz-file-name">{{title}}{{#if fileName}}<small>{{fileName}}</small>{{/if}}{{#if extra}}<small class="sde-wiz-extra">{{../../extraLabel}}</small>{{/if}}</span>
          <span class="sde-wiz-file-size">{{size}}</span>
          {{#if fileName}}<button type="button" class="sde-wiz-x" data-action="remove" data-kind="map" data-id="{{id}}" aria-label="{{../../removeLabel}}"><i class="fas fa-xmark"></i></button>{{/if}}
        </li>
        {{/each}}
      </ul>
      {{/if}}
    </section>
    {{/each}}
    {{/if}}

    {{#if isCheck}}
    {{#if check.running}}
    <div class="sde-wiz-card sde-wiz-run">
      <div class="sde-wiz-bar" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{check.pct}}"><span style="width:{{check.pct}}%"></span></div>
      <p class="sde-wiz-muted">{{check.label}}</p>
    </div>
    {{else}}
    <div class="sde-wiz-card">
      <p class="sde-wiz-count"><strong>{{check.ready}}</strong> {{localize "SDE.importer.wizard.check.readyOf" total=check.total}}</p>
    </div>
    {{#each check.problems}}
    <div class="sde-wiz-card sde-wiz-problem">
      <div class="sde-wiz-problem-head"><i class="fas fa-triangle-exclamation"></i><strong>{{title}}</strong></div>
      <p>{{why}}</p>
      <div class="sde-wiz-actions">
        {{#each fixes}}<button type="button" class="sde-import-secondary" data-action="fix" data-fix="{{id}}" data-kind="{{../kind}}" data-target="{{../id}}">{{label}}</button>{{/each}}
      </div>
    </div>
    {{/each}}
    {{#each check.warnings}}
    <div class="sde-wiz-card sde-wiz-note"><i class="fas fa-circle-info"></i><p><strong>{{title}}</strong> {{why}}</p></div>
    {{/each}}
    {{/if}}
    {{/if}}

    {{#if isReady}}
    <label class="sde-wiz-opt{{#if everything}} is-picked{{/if}}">
      <input type="radio" name="choice" value="everything" data-action="setChoice" {{#if everything}}checked{{/if}}>
      <span><strong>{{localize "SDE.importer.wizard.ready.everything"}}</strong><small>{{ready.summary}}</small></span>
    </label>
    <label class="sde-wiz-opt{{#unless everything}} is-picked{{/unless}}">
      <input type="radio" name="choice" value="custom" data-action="setChoice" {{#unless everything}}checked{{/unless}}>
      <span><strong>{{localize "SDE.importer.wizard.ready.custom"}}</strong><small>{{localize "SDE.importer.wizard.ready.customHelp"}}</small></span>
    </label>
    {{#if ready.hexNote}}
    <div class="sde-wiz-card sde-wiz-note">
      <i class="fas fa-map"></i>
      <div>
        <strong>{{localize "SDE.importer.wizard.hex.title"}}</strong>
        <p>{{localize "SDE.importer.wizard.hex.body"}}</p>
        <ol class="sde-wiz-steps">
          <li>{{localize "SDE.importer.wizard.hex.step1"}}</li>
          <li>{{localize "SDE.importer.wizard.hex.step2"}}</li>
          <li>{{localize "SDE.importer.wizard.hex.step3"}}</li>
        </ol>
      </div>
    </div>
    {{/if}}
    {{/if}}

    {{#if isImport}}
    <div class="sde-wiz-card sde-wiz-run">
      <div class="sde-wiz-pct">{{run.pct}}<small>%</small></div>
      <div class="sde-wiz-bar" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{run.pct}}"><span style="width:{{run.pct}}%"></span></div>
      <p class="sde-wiz-muted">{{run.phase}}</p>
    </div>
    {{/if}}

    {{#if isDone}}
    <div class="sde-wiz-card">
      <div class="sde-wiz-stats">
        <div><span class="sde-wiz-label">{{localize "SDE.importer.wizard.done.imported"}}</span><strong>{{done.imported}}</strong></div>
        <div><span class="sde-wiz-label">{{localize "SDE.importer.wizard.done.already"}}</span><strong>{{done.already}}</strong></div>
        <div><span class="sde-wiz-label">{{localize "SDE.importer.wizard.done.attention"}}</span><strong>{{done.attention}}</strong></div>
      </div>
    </div>
    {{#each done.items}}
    <div class="sde-wiz-card sde-wiz-problem">
      <div class="sde-wiz-problem-head"><i class="fas fa-triangle-exclamation"></i><strong>{{title}}</strong></div>
      <p>{{why}}</p>
    </div>
    {{/each}}
    {{#if done.hexMaps.length}}
    <div class="sde-wiz-card sde-wiz-note">
      <i class="fas fa-map"></i>
      <div>
        <strong>{{localize "SDE.importer.wizard.done.hexTitle"}}</strong>
        <p>{{localize "SDE.importer.wizard.done.hexBody"}}</p>
        <div class="sde-wiz-actions">
          {{#each done.hexMaps}}<button type="button" class="sde-import-secondary" data-action="openHex" data-id="{{id}}">{{label}}</button>{{/each}}
        </div>
      </div>
    </div>
    {{/if}}
    {{/if}}

  </div>

  <footer class="sde-wiz-foot">
    <a class="sde-wiz-advanced" data-action="advanced" role="button" tabindex="0">{{localize "SDE.importer.wizard.advanced"}}</a>
    <span class="sde-wiz-buttons">
      {{#if foot.back}}<button type="button" class="sde-import-secondary" data-action="back">{{localize "SDE.importer.wizard.back"}}</button>{{/if}}
      {{#if foot.next}}<button type="button" class="sde-import-primary" data-action="next" {{#if foot.next.disabled}}disabled title="{{foot.next.reason}}"{{/if}}>{{foot.next.label}}</button>{{/if}}
      {{#if foot.cancel}}<button type="button" class="sde-import-secondary" data-action="cancel">{{foot.cancel}}</button>{{/if}}
    </span>
  </footer>
</div>

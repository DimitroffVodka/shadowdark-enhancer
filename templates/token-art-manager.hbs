<section class="sde-tam">

  <header class="sde-tam-head">
    <details class="sde-tam-blurb" data-remember="blurb" {{#if blurbOpen}}open{{/if}}>
      <summary class="sde-tam-blurb-title">{{localize "SDE.tokenArt.manager.howItWorks"}}</summary>
      {{{localize "SDE.tokenArt.manager.blurb"}}}
    </details>
    <div class="sde-tam-actions">
      <button type="button" data-action="apply" class="sde-tam-apply">
        <i class="fa-solid fa-wand-magic-sparkles"></i> {{#if enabled}}{{localize "SDE.tokenArt.manager.applyUpdate"}}{{else}}{{localize "SDE.tokenArt.manager.apply"}}{{/if}}
      </button>
      <button type="button" data-action="reskinPlaced" title="{{localize 'SDE.tokenArt.manager.reskinTip'}}">
        <i class="fa-solid fa-street-view"></i> {{localize "SDE.tokenArt.dialog.reskinPlaced"}}
      </button>
      <button type="button" data-action="resetAll" title="{{localize 'SDE.tokenArt.manager.resetTip'}}">
        <i class="fa-solid fa-rotate-left"></i> {{localize "SDE.tokenArt.manager.resetPicks"}}
      </button>
      {{#if enabled}}
      <button type="button" data-action="turnOff" title="{{localize 'SDE.tokenArt.manager.turnOffTip'}}">
        <i class="fa-solid fa-power-off"></i> {{localize "SDE.tokenArt.dialog.turnOff"}}
      </button>
      {{/if}}
      <button type="button" data-action="refresh" title="{{localize 'SDE.tokenArt.manager.refreshTip'}}">
        <i class="fa-solid fa-arrows-rotate"></i>
      </button>
    </div>
  </header>

  <div class="sde-tam-folders">
    <div class="sde-tam-folders-head">
      <div class="sde-tam-sources-title">{{localize "SDE.tokenArt.manager.foldersTitle"}} <span class="sde-tam-dim">{{localize "SDE.tokenArt.manager.foldersNote"}}</span></div>
      <button type="button" data-action="folderAdd" class="sde-tam-folder-add"><i class="fa-solid fa-plus"></i> {{localize "SDE.tokenArt.manager.addFolder"}}</button>
    </div>
    {{#each folders}}
    <div class="sde-tam-folder" data-folder="{{@index}}">
      <div class="sde-tam-folder-name">{{label}}</div>
      <code class="sde-tam-folder-path">{{path}}</code>
      <button type="button" data-action="folderEdit" data-folder="{{@index}}" title="{{localize 'SDE.tokenArt.manager.editFolder'}}"><i class="fa-solid fa-pen"></i></button>
      <button type="button" data-action="folderRemove" data-folder="{{@index}}" title="{{localize 'SDE.tokenArt.manager.removeFolder'}}"><i class="fa-solid fa-trash"></i></button>
    </div>
    {{else}}
    <div class="sde-tam-folder-empty">{{localize "SDE.tokenArt.manager.foldersEmpty"}}</div>
    {{/each}}
  </div>

  <details class="sde-tam-sources" data-remember="sources" {{#if sourcesOpen}}open{{/if}}>
    <summary class="sde-tam-sources-title">{{localize "SDE.tokenArt.manager.sourcePriority"}}
      <span class="sde-tam-dim">· {{localize "SDE.tokenArt.manager.sourcesNote" count=sourceCount}}</span>
    </summary>
    {{#each sources}}
    <div class="sde-tam-source" draggable="true" data-source="{{id}}" title="{{localize 'SDE.tokenArt.manager.dragTip'}}">
      <i class="fa-solid fa-grip-vertical sde-tam-grip" aria-hidden="true"></i>
      <div class="sde-tam-rank">
        <button type="button" data-action="sourceUp" data-source="{{id}}" {{#if isFirst}}disabled{{/if}} title="{{localize 'SDE.tokenArt.manager.higher'}}"><i class="fa-solid fa-caret-up"></i></button>
        <button type="button" data-action="sourceDown" data-source="{{id}}" {{#if isLast}}disabled{{/if}} title="{{localize 'SDE.tokenArt.manager.lower'}}"><i class="fa-solid fa-caret-down"></i></button>
      </div>
      <div class="sde-tam-source-name">
        {{label}}
        <span class="sde-tam-dim">· {{localize "SDE.tokenArt.manager.available" count=count}}{{#if kind}} · {{kind}}{{/if}}</span>
      </div>
      <div class="sde-tam-source-used" title="{{localize 'SDE.tokenArt.manager.usedTip'}}">{{used}}</div>
    </div>
    {{/each}}
  </details>

  <div class="sde-tam-toolbar">
    <input type="text" name="filter" placeholder="{{localize 'SDE.tokenArt.manager.filterPlaceholder'}}" value="{{filter}}" autocomplete="off">
    <label class="sde-tam-toggle">
      <input type="checkbox" name="conflicts" {{#if conflictsOnly}}checked{{/if}}> {{localize "SDE.tokenArt.manager.conflictsOnly"}}
    </label>
    <span class="sde-tam-count">{{shown}} / {{total}}</span>
  </div>

  <div class="sde-tam-list">
    {{#each rows}}
    <div class="sde-tam-row {{#if isOverride}}is-override{{/if}}" data-name="{{name}}" data-multi="{{#if multi}}1{{/if}}">
      <div class="sde-tam-name">
        {{name}}
        {{#if imported}}<span class="sde-tam-imported" title="{{localize 'SDE.tokenArt.manager.importedTip'}}">{{localize "SDE.tokenArt.manager.imported"}}</span>{{/if}}
        {{#if isOverride}}<i class="fa-solid fa-thumbtack" title="{{localize 'SDE.tokenArt.manager.overriddenTip'}}" data-action="clearRow" data-monster="{{id}}"></i>{{/if}}
      </div>
      <div class="sde-tam-opts">
        {{#if pick}}
        <div class="sde-tam-opt sde-tam-pick is-chosen" title="{{localize 'SDE.tokenArt.manager.handPicked' label=pick.label file=pick.file}}">
          <img src="/{{pick.thumb}}" loading="lazy" alt="">
          <i class="fa-solid fa-hand-pointer sde-tam-check"></i>
        </div>
        {{/if}}
        {{#each options}}
        <button type="button" class="sde-tam-opt {{#if chosen}}is-chosen{{/if}}" data-action="choose" data-monster="{{../id}}" data-source="{{source}}" title="{{label}}{{#if ring}} · {{localize 'SDE.tokenArt.manager.ring'}}{{/if}}">
          <img src="/{{thumb}}" loading="lazy" alt="{{label}}">
          {{#if chosen}}<i class="fa-solid fa-check sde-tam-check"></i>{{/if}}
        </button>
        {{/each}}
        {{#unless hasOptions}}{{#unless pick}}<span class="sde-tam-nomatch">{{localize "SDE.tokenArt.manager.noMatch"}}</span>{{/unless}}{{/unless}}
        <button type="button" class="sde-tam-browse" data-action="browse" data-monster="{{id}}" data-name="{{name}}" title="{{localize 'SDE.tokenArt.manager.browseTip'}}">
          <i class="fa-solid fa-images"></i> {{localize "SDE.tokenArt.manager.browse"}}
        </button>
      </div>
    </div>
    {{/each}}
    {{#unless rows.length}}<div class="sde-tam-empty">{{localize "SDE.tokenArt.manager.noRows"}}</div>{{/unless}}
  </div>

  <div class="sde-tam-browser" hidden data-monster="">
    <div class="sde-tam-browser-head">
      <span class="sde-tam-browser-title">{{localize "SDE.tokenArt.browser.chooseArt"}}</span>
      <div class="sde-tam-browser-searchwrap">
        <input type="search" class="sde-tam-browser-search" placeholder="{{localize 'SDE.tokenArt.browser.filterPlaceholder'}}" autocomplete="off">
        <button type="button" class="sde-tam-browser-clear" title="{{localize 'SDE.tokenArt.browser.clearSearch'}}" hidden><i class="fa-solid fa-xmark"></i></button>
      </div>
      <label class="sde-tam-browser-zoomwrap" title="{{localize 'SDE.tokenArt.browser.zoomTip'}}">
        <i class="fa-solid fa-magnifying-glass-minus sde-tam-dim"></i>
        <input type="range" class="sde-tam-browser-zoom" min="40" max="320" step="8" value="56">
        <i class="fa-solid fa-magnifying-glass-plus sde-tam-dim"></i>
      </label>
      <span class="sde-tam-browser-count sde-tam-dim"></span>
      <button type="button" class="sde-tam-browser-close" data-action="browserClose"><i class="fa-solid fa-xmark"></i> {{localize "SDE.tokenArt.dialog.close"}}</button>
    </div>
    <div class="sde-tam-browser-grid"></div>
    <div class="sde-tam-browser-status"><span class="sde-tam-dim">{{localize "SDE.tokenArt.manager.hoverIdle"}}</span></div>
  </div>

</section>

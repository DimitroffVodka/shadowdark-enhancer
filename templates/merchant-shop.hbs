<div class="ui-shell">
  <header class="ui-head">
    <div class="ui-art ms-art"><i class="fas fa-shop"></i></div>
    <div class="ui-head-text"><h2 class="ui-title">{{shopName}}</h2></div>
    <div class="ui-stats">
      {{#if hasActor}}
      <div class="ui-stat"><span class="ui-label">{{actorName}}</span><span class="ui-value ms-wallet"><i class="fas fa-coins"></i> {{walletDetail}}</span></div>
      {{else}}
      <span class="ui-chip off"><i class="fas fa-user-slash"></i> {{localize "SDE.merchant.noCharacter"}}</span>
      {{/if}}
    </div>
    <div class="ms-tools">
      {{#each tabs}}{{#if (eq id "log")}}<button type="button" class="ui-icon sdems-tab-btn {{#if active}}on{{/if}}" data-tab="{{id}}" title="{{label}}" aria-label="{{label}}"><i class="fas {{icon}}"></i></button>{{else if (eq id "manage")}}<button type="button" class="ui-icon sdems-tab-btn {{#if active}}on{{/if}}" data-tab="{{id}}" title="{{label}}" aria-label="{{label}}"><i class="fas {{icon}}"></i></button>{{/if}}{{/each}}
    </div>
  </header>

  <nav class="ui-tabs">
    {{#each tabs}}{{#if (eq id "log")}}{{else if (eq id "manage")}}{{else}}
    <button type="button" class="ui-tab sdems-tab-btn {{#if active}}active{{/if}}" data-tab="{{id}}"><i class="fas {{icon}}"></i> {{label}}</button>
    {{/if}}{{/each}}
  </nav>

  <div class="ui-body">

    {{#if (eq tab "buy")}}
    <div class="ui-inline ms-filters">
      <div class="ui-search ui-grow"><i class="fa-solid fa-magnifying-glass"></i><input type="text" class="sdems-search-input" placeholder="{{localize 'SDE.merchant.searchItems'}}" value="{{searchFilter}}"></div>
      <select class="sdems-category-select ms-select">
        <option value="all">{{localize "SDE.merchant.allCategories"}}</option>
        {{#each categories}}<option value="{{this}}" {{#if (eq this ../categoryFilter)}}selected{{/if}}>{{this}}</option>{{/each}}
      </select>
    </div>
    {{#if inventoryCount}}
    {{#each inventorySections}}
    <section class="ui-group sdems-shop-section {{#if collapsed}}sdems-section-collapsed{{/if}}" data-section="{{key}}">
      <h3 class="ui-h sdems-section-header" data-section-toggle="{{key}}" role="button" tabindex="0" aria-expanded="{{#if collapsed}}false{{else}}true{{/if}}">
        <span><i class="fas fa-chevron-down ms-caret"></i> {{label}}</span><small>{{count}}</small>
      </h3>
      <div class="ui-list ms-section-body">
        {{#each items}}
        <div class="ui-row sdems-item-row ms-row ms-r-buy {{#if outOfStock}}ms-out{{/if}} {{#unless canAfford}}ms-poor{{/unless}}" data-shop-item-id="{{id}}">
          <img src="{{img}}" alt="">
          <div class="ui-row-main"><span class="ui-row-name ms-name" title="{{name}}">{{name}}</span><span class="ui-row-sub">{{category}}</span></div>
          <span class="ui-row-meta">{{priceDisplay}}</span>
          <span class="ui-chip ms-stock" title="{{#if outOfStock}}{{localize 'SDE.merchant.stockOut'}}{{else if unlimited}}{{localize 'SDE.merchant.stockUnlimited'}}{{else}}{{localize 'SDE.merchant.stockRemaining' n=stockDisplay}}{{/if}}">{{stockDisplay}}</span>
          <div class="ui-inline sdems-item-actions ms-actions">
            <input type="number" class="sdems-qty-input ui-num-in" value="1" min="1" max="99" aria-label="{{localize 'SDE.merchant.btn.buy'}}">
            <button type="button" class="ui-btn sdems-buy-btn" {{#unless canAfford}}disabled{{/unless}}><i class="fas fa-cart-plus"></i> {{localize "SDE.merchant.btn.buy"}}</button>
          </div>
        </div>
        {{/each}}
      </div>
    </section>
    {{/each}}
    {{else}}
    <div class="ui-empty"><i class="fa-solid fa-shop-slash"></i><span>{{localize "SDE.merchant.noItems"}}</span></div>
    {{/if}}
    {{/if}}

    {{#if (eq tab "catalog")}}
    <div class="ui-inline ms-filters">
      <select class="sdems-catalog-pack ms-select">
        <option value="all" {{#if (eq catalogPack "all")}}selected{{/if}}>{{localize "SDE.merchant.allPacks"}}</option>
        {{#each catalogPacks}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
      </select>
      {{#if showFolderFilter}}
      <select class="sdems-catalog-folder ms-select">
        <option value="all" {{#if (eq catalogFolder "all")}}selected{{/if}}>{{localize "SDE.merchant.allFolders"}}</option>
        {{#each catalogFolders}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}
      </select>
      {{/if}}
      <select class="sdems-catalog-sort ms-select">
        <option value="name" {{#if (eq catalogSort "name")}}selected{{/if}}>{{localize "SDE.merchant.sort.name"}}</option>
        <option value="value-asc" {{#if (eq catalogSort "value-asc")}}selected{{/if}}>{{localize "SDE.merchant.sort.valueAsc"}}</option>
        <option value="value-desc" {{#if (eq catalogSort "value-desc")}}selected{{/if}}>{{localize "SDE.merchant.sort.valueDesc"}}</option>
      </select>
      <div class="ui-search ui-grow ms-wide"><i class="fa-solid fa-magnifying-glass"></i><input type="text" class="sdems-catalog-search" placeholder="{{localize 'SDE.merchant.searchItems'}}" value="{{catalogSearch}}"></div>
    </div>
    {{#if catalogItems.length}}
    <div class="ui-list">
      {{#each catalogItems}}
      <div class="ui-row sdems-item-row ms-row ms-r-cat {{#unless canAfford}}ms-poor{{/unless}}" data-item-uuid="{{uuid}}">
        <img src="{{img}}" alt="">
        <div class="ui-row-main"><span class="ui-row-name ms-name" title="{{name}}">{{name}}</span><span class="ui-row-sub"><span class="ui-tag">{{packLabel}}</span>{{#if folderName}} <span class="ui-tag">{{folderName}}</span>{{/if}}</span></div>
        <span class="ui-row-meta">{{priceDisplay}}</span>
        <div class="ui-inline sdems-item-actions ms-actions">
          <input type="number" class="sdems-qty-input ui-num-in" value="1" min="1" max="99" aria-label="{{localize 'SDE.merchant.btn.buy'}}">
          <button type="button" class="ui-btn sdems-catalog-buy-btn" {{#unless canAfford}}disabled{{/unless}}><i class="fas fa-cart-plus"></i> {{localize "SDE.merchant.btn.buy"}}</button>
        </div>
      </div>
      {{/each}}
    </div>
    {{else}}
    <div class="ui-empty"><i class="fa-solid fa-book-open"></i><span>{{localize "SDE.merchant.noMatches"}}</span></div>
    {{/if}}
    {{/if}}

    {{#if (eq tab "gamble")}}
    <div class="ui-note info"><i class="fas fa-dice"></i> {{localize "SDE.merchant.gambleIntro"}}</div>
    {{#if gambleOptions.length}}
    <div class="ui-list">
      {{#each gambleOptions}}
      <div class="ui-row ms-row ms-r-gamble {{#unless canAfford}}ms-poor{{/unless}}" data-gamble-id="{{id}}">
        <div class="ui-row-main"><span class="ui-row-name ms-name" title="{{name}}">{{name}}</span></div>
        <span class="ui-row-meta">{{costDisplay}}</span>
        <button type="button" class="ui-btn sdems-gamble-btn" {{#unless canAfford}}disabled{{/unless}}><i class="fas fa-dice"></i> {{localize "SDE.merchant.btn.gamble"}}</button>
      </div>
      {{/each}}
    </div>
    {{else}}
    <div class="ui-empty"><i class="fa-solid fa-dice"></i><span>{{localize "SDE.merchant.noGamble"}}</span></div>
    {{/if}}
    {{/if}}

    {{#if (eq tab "sell")}}
    <div class="ui-inline ms-sellhead">
      <h3 class="ui-h ui-grow">{{localize "SDE.merchant.yourEquipment"}} <small>{{localize "SDE.merchant.sellRatioLabel"}} {{sellRatio}}%</small></h3>
      {{#if hasJunk}}<button type="button" class="ui-btn sdems-sell-all-junk"><i class="fas fa-trash-can"></i> {{localize "SDE.merchant.btn.sellAllJunk"}}</button>{{/if}}
    </div>
    {{#if sellItems.length}}
    <div class="ui-list">
      {{#each sellItems}}
      <div class="ui-row sdems-item-row ms-row ms-r-sell {{#if isJunk}}ms-junk{{/if}}" data-item-id="{{id}}">
        <img src="{{img}}" alt="">
        <div class="ui-row-main"><span class="ui-row-name ms-name" title="{{name}}">{{#if isJunk}}<i class="fas fa-trash-can ms-junk-ic"></i> {{/if}}{{name}}{{#if (gt quantity 1)}} ×{{quantity}}{{/if}}</span><span class="ui-row-sub">{{localize "SDE.merchant.valueLabel" cost=costDisplay}}</span></div>
        <span class="ui-row-meta ms-sell">{{sellPriceDisplay}}</span>
        <div class="ui-inline sdems-item-actions ms-actions">
          <input type="number" class="sdems-qty-input ui-num-in" value="1" min="1" max="{{quantity}}" aria-label="{{localize 'SDE.merchant.btn.sell'}}">
          <button type="button" class="ui-btn sdems-sell-btn"><i class="fas fa-coins"></i> {{localize "SDE.merchant.btn.sell"}}</button>
        </div>
      </div>
      {{/each}}
    </div>
    {{else}}
    <div class="ui-empty"><i class="fa-solid fa-box-open"></i><span>{{localize "SDE.merchant.nothingToSell"}}</span></div>
    {{/if}}
    {{/if}}

    {{#if (eq tab "log")}}
    <div class="ui-inline">
      <button type="button" class="ui-btn sdems-copy-discord"><i class="fab fa-discord"></i> {{localize "SDE.merchant.btn.shopLog"}}</button>
      <button type="button" class="ui-btn sdems-copy-session"><i class="fab fa-discord"></i> {{localize "SDE.merchant.btn.sessionSummary"}}</button>
      {{#if isGM}}<button type="button" class="ui-btn danger ui-right sdems-clear-log"><i class="fas fa-trash"></i> {{localize "SDE.merchant.btn.clearLog"}}</button>{{/if}}
    </div>
    {{#if logEntries.length}}
    <div class="ui-list">
      {{#each logEntries}}
      <div class="ui-row ms-log">
        <i class="fas {{#if isGamble}}fa-dice{{else}}{{#if isBuy}}fa-cart-shopping{{else}}fa-coins{{/if}}{{/if}} ms-log-ic {{#if isBuy}}buy{{else}}sell{{/if}}"></i>
        <div class="ui-row-main"><span class="ui-row-name">{{item}}{{qtyStr}}</span><span class="ui-row-sub">{{player}} · {{#if isBuy}}{{localize "SDE.merchant.log.bought"}}{{else}}{{localize "SDE.merchant.log.sold"}}{{/if}} · {{time}}</span></div>
        <span class="ui-row-meta">{{priceDisplay}}</span>
      </div>
      {{/each}}
    </div>
    {{else}}
    <div class="ui-empty"><i class="fa-solid fa-clipboard-list"></i><span>{{localize "SDE.merchant.noTransactions"}}</span></div>
    {{/if}}
    {{/if}}

    {{#if (eq tab "manage")}}
    <section class="ui-card">
      <div class="ui-cols-2">
        <label class="ui-field ms-span"><span class="ui-label">{{localize "SDE.merchant.manage.shopName"}}</span><input type="text" class="sdems-shop-name-input" value="{{shopName}}"></label>
        <label class="ui-field"><span class="ui-label">{{localize "SDE.merchant.manage.buyMarkup"}}</span><input type="number" class="sdems-markup-input" value="{{buyMultiplier}}" min="10" max="500" step="10"><span class="ui-sub">{{localize "SDE.merchant.manage.markupHint"}}</span></label>
        <label class="ui-field"><span class="ui-label">{{localize "SDE.merchant.manage.sellRatio"}}</span><input type="number" class="sdems-ratio-input" value="{{sellRatio}}" min="0" max="100" step="5"></label>
      </div>
      <label class="ui-check"><input type="checkbox" class="sdems-catalog-toggle" {{#if catalogEnabled}}checked{{/if}}> <span><strong>{{localize "SDE.merchant.manage.playerCatalog"}}</strong> <span class="ui-muted">{{localize "SDE.merchant.manage.catalogToggle"}}</span></span></label>
      <label class="ui-check"><input type="checkbox" class="sdems-gamble-toggle" {{#if gambleEnabled}}checked{{/if}}> <span><strong>{{localize "SDE.merchant.manage.gambleTable"}}</strong> <span class="ui-muted">{{localize "SDE.merchant.manage.gambleToggle"}}</span></span></label>
    </section>

    <section class="ui-card">
      <div class="ui-label">{{localize "SDE.merchant.manage.inventorySource"}}</div>
      <div class="ui-inline">
        <label class="ui-check"><input type="radio" class="sdems-mode-radio" name="sdems-mode" value="compendium" {{#if (eq mode "compendium")}}checked{{/if}}> {{localize "SDE.merchant.manage.modeCompendium"}}</label>
        <label class="ui-check"><input type="radio" class="sdems-mode-radio" name="sdems-mode" value="actor" {{#if (eq mode "actor")}}checked{{/if}}> {{localize "SDE.merchant.manage.modeActor"}}</label>
      </div>
      {{#if (eq mode "actor")}}
      <select class="sdems-actor-select">
        <option value="">{{localize "SDE.merchant.manage.selectActor"}}</option>
        {{#each npcActors}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}} ({{type}})</option>{{/each}}
      </select>
      {{/if}}
      {{#if (eq mode "compendium")}}
      <div class="ui-label">{{localize "SDE.merchant.manage.savedMerchants"}}</div>
      <div class="ui-inline ms-saved">
        <select class="sdems-load-config-select">
          <option value="">{{localize "SDE.merchant.manage.selectMerchant"}}</option>
          {{#each savedConfigs}}<option value="{{@key}}">{{this.name}}</option>{{/each}}
        </select>
        <button type="button" class="ui-btn sdems-load-merchant-btn"><i class="fas fa-upload"></i> {{localize "SDE.merchant.manage.load"}}</button>
        <button type="button" class="ui-icon danger sdems-delete-merchant-btn" title="{{localize 'SDE.merchant.manage.delete'}}" aria-label="{{localize 'SDE.merchant.manage.delete'}}"><i class="fas fa-trash"></i></button>
      </div>
      {{/if}}
    </section>

    {{#if (eq mode "compendium")}}
    <section class="ui-group">
      <h3 class="ui-h">{{localize "SDE.merchant.manage.shopInventory"}} <small>{{inventory.length}}</small></h3>
      <div class="ui-note sdems-drop-zone"><i class="fas fa-cloud-arrow-down"></i> {{localize "SDE.merchant.manage.dropZone"}}</div>
      {{#if inventory.length}}
      <div class="ui-list">
        {{#each inventory}}
        <div class="ui-row ms-edit" data-shop-item-id="{{id}}">
          <img src="{{img}}" alt="">
          <div class="ui-row-main"><span class="ui-row-name ms-name" title="{{name}}">{{name}}</span></div>
          <div class="ms-price">
            <label class="ms-coin"><input type="number" class="sdems-price-gold" value="{{cost.gp}}" min="0" title="{{localize 'SDE.merchant.manage.gold'}}" aria-label="{{localize 'SDE.merchant.manage.gold'}}"><span>{{localize "SDE.merchant.manage.gp"}}</span></label>
            <label class="ms-coin"><input type="number" class="sdems-price-silver" value="{{cost.sp}}" min="0" title="{{localize 'SDE.merchant.manage.silver'}}" aria-label="{{localize 'SDE.merchant.manage.silver'}}"><span>{{localize "SDE.merchant.manage.sp"}}</span></label>
            <label class="ms-coin"><input type="number" class="sdems-price-copper" value="{{cost.cp}}" min="0" title="{{localize 'SDE.merchant.manage.copper'}}" aria-label="{{localize 'SDE.merchant.manage.copper'}}"><span>{{localize "SDE.merchant.manage.cp"}}</span></label>
            <label class="ms-coin"><input type="number" class="sdems-stock-input" value="{{stock}}" min="-1" title="{{localize 'SDE.merchant.manage.stockTip'}}" aria-label="{{localize 'SDE.merchant.manage.stockTip'}}"><i class="fas fa-boxes-stacked"></i></label>
          </div>
          <button type="button" class="ui-icon danger sdems-remove-item-btn" title="{{localize 'SDE.merchant.manage.removeFromShop'}}" aria-label="{{localize 'SDE.merchant.manage.removeFromShop'}}"><i class="fas fa-xmark"></i></button>
        </div>
        {{/each}}
      </div>
      {{/if}}
    </section>

    <section class="ui-group">
      <h3 class="ui-h">{{localize "SDE.merchant.manage.addFromCompendium"}}</h3>
      <div class="ui-inline ms-filters">
        <select class="sdems-pack-select ms-select">
          {{#each compendiumPacks}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
        </select>
        <div class="ui-search ui-grow"><i class="fa-solid fa-magnifying-glass"></i><input type="text" class="sdems-comp-search" placeholder="{{localize 'SDE.merchant.manage.filter'}}" value="{{compendiumFilter}}"></div>
      </div>
      <div class="ui-list ms-comp">
        {{#each compendiumItems}}
        <div class="ui-row"><img src="{{img}}" alt=""><div class="ui-row-main"><span class="ui-row-name ms-name" title="{{name}}">{{name}}</span></div>
          <button type="button" class="ui-icon sdems-add-item-btn" data-uuid="{{uuid}}" title="{{localize 'SDE.merchant.manage.addToShop'}}" aria-label="{{localize 'SDE.merchant.manage.addToShop'}}"><i class="fas fa-plus"></i></button></div>
        {{/each}}
      </div>
    </section>
    {{/if}}

    <details class="ui-details">
      <summary>{{localize "SDE.merchant.manage.gambleOptions"}} <span class="ui-chip">{{gambleOptions.length}}</span></summary>
      <div class="ui-details-body">
        <div class="ui-list">
          {{#each gambleOptions}}
          <div class="ui-row ms-edit" data-gamble-config-id="{{id}}">
            <div class="ui-row-main"><span class="ui-row-name ms-name" title="{{name}}">{{name}}</span></div>
            <div class="ms-price">
              <label class="ms-coin"><input type="number" class="sdems-gamble-cost-gold" value="{{cost.gp}}" min="0" title="{{localize 'SDE.merchant.manage.gold'}}" aria-label="{{localize 'SDE.merchant.manage.gold'}}"><span>{{localize "SDE.merchant.manage.gp"}}</span></label>
              <label class="ms-coin"><input type="number" class="sdems-gamble-cost-silver" value="{{cost.sp}}" min="0" title="{{localize 'SDE.merchant.manage.silver'}}" aria-label="{{localize 'SDE.merchant.manage.silver'}}"><span>{{localize "SDE.merchant.manage.sp"}}</span></label>
            </div>
            <button type="button" class="ui-icon danger sdems-gamble-remove-btn" title="{{localize 'SDE.merchant.manage.remove'}}" aria-label="{{localize 'SDE.merchant.manage.remove'}}"><i class="fas fa-xmark"></i></button>
          </div>
          {{/each}}
        </div>
        <div class="ui-inline ms-filters">
          <input type="text" class="sdems-gamble-new-name ui-grow" placeholder="{{localize 'SDE.merchant.manage.displayName'}}">
          <select class="sdems-gamble-new-source ms-select">
            {{#each gambleSources}}<optgroup label="{{label}}">{{#each options}}<option value="{{id}}">{{label}}</option>{{/each}}</optgroup>{{/each}}
          </select>
          <input type="number" class="sdems-gamble-new-gold ui-num-in" value="5" min="0" placeholder="{{localize 'SDE.merchant.manage.gpCost'}}" aria-label="{{localize 'SDE.merchant.manage.gpCost'}}">
          <button type="button" class="ui-btn sdems-gamble-add-btn"><i class="fas fa-plus"></i> {{localize "SDE.merchant.manage.add"}}</button>
        </div>
      </div>
    </details>
    {{/if}}

  </div>

  {{#if (eq tab "manage")}}
  <footer class="ui-footer">
    <button type="button" class="ui-btn ghost sdems-save-config-btn"><i class="fas fa-book"></i> {{localize "SDE.merchant.manage.save"}}</button>
    <div class="ui-right">
      <button type="button" class="ui-btn sdems-close-for-all"><i class="fas fa-door-closed"></i> {{localize "SDE.merchant.manage.closeShop"}}</button>
      <button type="button" class="ui-btn primary sdems-open-for-all"><i class="fas fa-bullhorn"></i> {{localize "SDE.merchant.manage.makeAvailable"}}</button>
    </div>
  </footer>
  {{/if}}
</div>

<form class="ui-shell lp-form" autocomplete="off" onsubmit="return false">
  <header class="ui-head">
    <div class="ui-art lp-crest"><i class="fa-solid fa-landmark"></i></div>
    <div class="ui-head-text">
      <h2 class="ui-title">{{localize "SDE.town.make.title"}}</h2>
      <p class="ui-sub">{{localize "SDE.town.make.sub"}}</p>
    </div>
  </header>

  <div class="ui-body">
    <section class="ui-group">
      <h3 class="ui-h"><span>{{localize "SDE.town.make.new"}}</span></h3>
      <div class="ui-cols-2">
        <label class="ui-field"><span class="ui-label">{{localize "SDE.town.make.name"}}</span><input type="text" name="name" value="{{defaultName}}" maxlength="80"></label>
        <label class="ui-field"><span class="ui-label">{{localize "SDE.town.make.size"}}</span>
          <select name="size">{{#each sizes}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
      </div>
      <div class="ui-field">
        <span class="ui-label">{{localize "SDE.town.make.pictureLabel"}}</span>
        <div class="lp-pics">
          {{#each pictures}}
          <label class="lp-pic"><input type="radio" name="picture" value="{{id}}" {{#if selected}}checked{{/if}}><img src="{{thumb}}" alt=""><span>{{label}}</span></label>
          {{/each}}
        </div>
      </div>
      {{#if offerPlayerMap}}
      <div class="ui-note info lp-offer">
        <span>{{localize "SDE.town.make.playerMapHint"}}</span>
        <button type="button" class="ui-btn" data-action="playerMap"><i class="fa-solid fa-map"></i> {{localize "SDE.town.make.playerMap"}}</button>
      </div>
      {{/if}}
      <div class="ui-field">
        <span class="ui-label">{{localize "SDE.town.make.games"}}</span>
        <div class="ui-inline lp-games">
          {{#each games}}<label class="ui-check"><input type="checkbox" name="game.{{id}}" checked> {{label}}</label>{{/each}}
        </div>
      </div>
      <p class="ui-muted lp-hint">{{localize "SDE.town.make.hint"}}</p>
      <div class="ui-inline lp-make">
        <button type="button" class="ui-btn primary" data-action="make"><i class="fa-solid fa-wand-magic-sparkles"></i> {{localize "SDE.town.make.button"}}</button>
      </div>
    </section>

    <section class="ui-group">
      <h3 class="ui-h"><span>{{localize "SDE.town.make.pages"}}</span><small>{{pages.length}}</small></h3>
      {{#if pages.length}}
      <div class="ui-list">
        {{#each pages}}
        <div class="ui-row {{#if here}}sel{{/if}}">
          <div class="ui-row-main">
            <span class="ui-row-name">{{name}}</span>
            <span class="ui-inline">{{#if sizeLabel}}<span class="ui-chip">{{sizeLabel}}</span>{{/if}}{{#if here}}<span class="ui-chip on">{{localize "SDE.town.make.here"}}</span>{{/if}}{{#unless shown}}<span class="ui-chip off">{{localize "SDE.town.make.hidden"}}</span>{{/unless}}</span>
          </div>
          <button type="button" class="ui-icon" data-action="edit" data-scene-id="{{sceneId}}" data-tooltip="{{localize 'SDE.town.edit'}}" aria-label="{{localize 'SDE.town.edit'}}"><i class="fa-solid fa-pen"></i></button>
          <button type="button" class="ui-btn" data-action="go" data-scene-id="{{sceneId}}"><i class="fa-solid fa-person-walking-arrow-right"></i> {{#if here}}{{#if shown}}{{localize "SDE.town.make.again"}}{{else}}{{localize "SDE.town.make.show"}}{{/if}}{{else}}{{localize "SDE.town.make.go"}}{{/if}}</button>
        </div>
        {{/each}}
      </div>
      {{else}}
      <div class="ui-empty"><i class="fa-solid fa-landmark"></i><span>{{localize "SDE.town.make.none"}}</span></div>
      {{/if}}
    </section>

    {{#if places.length}}
    <section class="ui-group">
      <h3 class="ui-h"><span>{{localize "SDE.town.make.places"}}</span><small>{{places.length}}</small></h3>
      <p class="ui-muted lp-hint">{{localize "SDE.town.make.placesHint"}}</p>
      <div class="ui-list lp-places">
        {{#each places}}
        <div class="ui-row">
          <div class="ui-row-main"><span class="ui-row-name">{{name}}</span><span class="ui-row-sub">{{sizeLabel}}</span></div>
          <button type="button" class="ui-btn" data-action="settlement" data-num="{{num}}"><i class="fa-solid fa-person-walking-arrow-right"></i> {{#if sceneId}}{{localize "SDE.town.make.go"}}{{else}}{{localize "SDE.town.make.makeGo"}}{{/if}}</button>
        </div>
        {{/each}}
      </div>
    </section>
    {{/if}}
  </div>
</form>

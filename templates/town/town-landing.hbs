<nav class="tm-menu" aria-label="{{townName}}">
  {{#if isGM}}
  <div class="tm-gm">
    <button type="button" class="ui-icon" data-action="editTown" data-tooltip="{{localize 'SDE.town.edit'}}" aria-label="{{localize 'SDE.town.edit'}}"><i class="fa-solid fa-pen"></i></button>
    <button type="button" class="ui-icon" data-action="openLog" data-tooltip="{{localize 'SDE.town.log.open'}}" aria-label="{{localize 'SDE.town.log.open'}}"><i class="fa-solid fa-receipt"></i></button>
    <button type="button" class="ui-icon" data-action="restockAll" data-tooltip="{{localize 'SDE.town.restock'}}" aria-label="{{localize 'SDE.town.restock'}}"><i class="fa-solid fa-boxes-packing"></i></button>
    <button type="button" class="ui-icon" data-action="hideTown" data-tooltip="{{hideTitle}}" aria-label="{{hideTitle}}"><i class="fa-solid fa-eye-slash"></i></button>
  </div>
  {{/if}}

  <div class="tm-crest"><i class="fa-solid fa-landmark"></i></div>
  <h1 class="tm-title">{{townName}}</h1>
  {{#if tagline}}<p class="tm-tag">{{tagline}}</p>{{/if}}
  {{#if blurb}}<p class="tm-blurb">{{blurb}}</p>{{/if}}
  <div class="tm-orn" aria-hidden="true"><i></i></div>

  {{#if merchants.length}}
  <ul class="tm-list">
    {{#each merchants}}
    <li>
      <button type="button" class="tm-item" data-action="visitMerchant" data-merchant-id="{{id}}" aria-label="{{localize 'SDE.town.visitNamed' name=name}}"
        data-tooltip="{{#if open}}{{pitch}}{{else}}{{localize 'SDE.town.shut'}}{{/if}}" {{#unless open}}disabled{{/unless}}>
        <span class="tm-dia"></span>
        <span class="tm-txt"><b>{{name}}</b><small>{{#if open}}{{#if role}}{{role}}{{else}}{{localize "SDE.town.wares" n=wares}}{{/if}}{{else}}{{localize "SDE.town.closed"}}{{/if}}</small></span>
      </button>
    </li>
    {{/each}}
  </ul>
  {{else}}
  <div class="tm-empty">
    {{#if isGM}}{{localize "SDE.town.noMerchantsGM"}}<br><button type="button" class="ui-btn primary" data-action="editTown"><i class="fa-solid fa-plus"></i> {{localize "SDE.town.addMerchant"}}</button>
    {{else}}{{localize "SDE.town.noMerchants"}}{{/if}}
  </div>
  {{/if}}

  {{#if places.length}}
  <div class="tm-orn" aria-hidden="true"><i></i></div>
  <ul class="tm-list">
    {{#each places}}
    <li>
      <button type="button" class="tm-item place" data-action="openPlace" data-place="{{id}}" {{#if disabled}}disabled data-tooltip="{{hint}}"{{/if}}>
        <span class="tm-dia"></span>
        <span class="tm-txt"><b>{{label}}</b><small>{{#if tag}}{{tag}}{{else}}{{sub}}{{/if}}</small></span>
      </button>
    </li>
    {{/each}}
  </ul>
  {{/if}}

  <p class="tm-foot">
    {{#if actorName}}{{localize "SDE.town.playingAs" name=actorName}} &nbsp; <b>{{purse}}</b>{{else}}{{localize "SDE.town.noCharacter"}}{{/if}}
  </p>
</nav>

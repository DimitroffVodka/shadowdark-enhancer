<div class="ui-shell">
  <header class="ui-head">
    <div class="ui-art lg-art"><i class="fa-solid fa-coins"></i></div>
    <div class="ui-head-text">
      <h2 class="ui-title">{{localize "SDE.loot.generator.title"}}</h2>
      <p class="ui-sub">{{#if hasTables}}{{localize "SDE.loot.generator.headSub"}}{{else}}{{localize "SDE.loot.generator.headSubEmpty"}}{{/if}}</p>
    </div>
    {{#if hasTables}}
    <div class="ui-stats">
      <div class="ui-stat"><span class="ui-label">{{localize "SDE.loot.generator.tables"}}</span><span class="ui-value">{{tables.length}}</span></div>
      <div class="ui-stat"><span class="ui-label">{{localize "SDE.loot.generator.rolls"}}</span><span class="ui-value">{{history.length}}</span></div>
    </div>
    {{/if}}
  </header>

  <div class="ui-body">
    {{#if hasTables}}
    <section class="ui-card">
      <div class="ui-field">
        <span class="ui-label">{{localize "SDE.monsterLoot.colTable"}}</span>
        <div class="ui-inline lg-picker">
          <select data-loot-table aria-label="{{localize 'SDE.monsterLoot.colTable'}}">
            {{#if hasFavourites}}
            <optgroup label="{{localize 'SDE.loot.generator.favourites'}}">
              {{#each favouriteTables as |t|}}<option value="{{t.uuid}}" {{#if t.isSelected}}selected{{/if}}>{{t.name}}</option>{{/each}}
            </optgroup>
            {{#if otherTables.length}}
            <optgroup label="{{localize 'SDE.loot.generator.allTables'}}">
              {{#each otherTables as |t|}}<option value="{{t.uuid}}" {{#if t.isSelected}}selected{{/if}}>{{t.name}}</option>{{/each}}
            </optgroup>
            {{/if}}
            {{else}}
            {{#each tables as |t|}}<option value="{{t.uuid}}" {{#if t.isSelected}}selected{{/if}}>{{t.name}}</option>{{/each}}
            {{/if}}
          </select>
          <button type="button" class="ui-icon lg-fav {{#if selectedIsFav}}on{{/if}}" data-action="toggleFavourite" aria-pressed="{{#if selectedIsFav}}true{{else}}false{{/if}}" title="{{localize 'SDE.loot.generator.favourite'}}" aria-label="{{localize 'SDE.loot.generator.favourite'}}"><i class="{{#if selectedIsFav}}fas{{else}}far{{/if}} fa-star"></i></button>
          {{#if hasFavourites}}<button type="button" class="ui-btn ghost lg-fav-only {{#if favOnly}}on{{/if}}" data-action="toggleFavOnly" aria-pressed="{{#if favOnly}}true{{else}}false{{/if}}"><i class="fas fa-filter"></i> {{localize "SDE.loot.generator.favOnly"}}</button>{{/if}}
        </div>
      </div>
      <p class="ui-sub">{{{localize "SDE.loot.generator.curatedHint"}}}</p>
    </section>

    {{#if hasHistory}}
    <section class="ui-group">
      <h3 class="ui-h">{{localize "SDE.loot.generator.history"}}
        <button type="button" class="ui-icon danger" data-action="clearHistory" title="{{localize 'SDE.loot.generator.clearHistory'}}" aria-label="{{localize 'SDE.loot.generator.clearHistory'}}"><i class="fas fa-trash"></i></button>
      </h3>
      {{#each history as |e|}}
      <article class="ui-card">
        <div class="ui-card-head">
          <i class="fas fa-book-open ui-muted"></i>
          <h4 class="ui-card-name">{{e.tableName}}</h4>
          <div class="ui-card-actions">
            <button type="button" class="ui-icon" data-action="postEntry" data-entry-id="{{e.id}}" title="{{localize 'SDE.loot.generator.post'}}" aria-label="{{localize 'SDE.loot.generator.post'}}"><i class="fas fa-comment"></i></button>
            <button type="button" class="ui-icon" data-action="dropEntry" data-entry-id="{{e.id}}" title="{{localize 'SDE.loot.generator.dropGround'}}" aria-label="{{localize 'SDE.loot.generator.dropGround'}}"><i class="fas fa-box-open"></i></button>
          </div>
        </div>
        {{#if e.items.length}}
        <div class="ui-list">
          {{#each e.items as |it|}}
          <div class="ui-row">
            <img src="{{it.img}}" alt="">
            <div class="ui-row-main"><span class="ui-row-name">{{it.name}}</span></div>
            {{#if it.forgeable}}<button type="button" class="ui-icon" data-action="forgeEntryItem" data-entry-id="{{e.id}}" data-item-index="{{it.idx}}" title="{{localize 'SDE.loot.btn.forge'}}" aria-label="{{localize 'SDE.loot.btn.forge'}}"><i class="fas fa-hammer"></i></button>{{/if}}
          </div>
          {{/each}}
        </div>
        {{/if}}
        {{#if e.hasCoins}}<div class="ui-inline"><span class="ui-chip gold"><i class="fas fa-coins"></i> {{e.coinsLabel}}</span></div>{{/if}}
        {{#each e.notes as |n|}}<p class="ui-sub">{{n}}</p>{{/each}}
        {{#if e.isEmpty}}<p class="ui-sub">{{localize "SDE.loot.generator.nothing"}}</p>{{/if}}
        <div class="ui-inline lg-give">
          <select class="sde-lootgen-recipient lg-recipient" data-entry-id="{{e.id}}" aria-label="{{localize 'SDE.loot.generator.recipientAria'}}">
            <option value="party">{{localize "SDE.loot.generator.partyOption"}}</option>
            {{#if e.hasParty}}<option value="partyStash">{{localize "SDE.loot.generator.partyStashOption"}}</option>{{/if}}
            {{#each e.party as |p|}}<option value="{{p.id}}">{{p.name}}</option>{{/each}}
          </select>
          <button type="button" class="ui-btn" data-action="giveEntry" data-entry-id="{{e.id}}"><i class="fas fa-gift"></i> {{localize "SDE.loot.btn.give"}}</button>
        </div>
      </article>
      {{/each}}
    </section>
    {{else}}
    <div class="ui-empty"><i class="fa-solid fa-dice-d20"></i><span>{{localize "SDE.loot.generator.rollHint"}}</span></div>
    {{/if}}

    {{else}}
    <div class="ui-empty"><i class="fa-solid fa-coins"></i><span>{{{localize "SDE.loot.generator.emptyHint"}}}</span></div>
    {{/if}}
  </div>

  <footer class="ui-footer">
    <button type="button" class="ui-btn {{#unless hasTables}}primary{{else}}ghost{{/unless}} lg-setup {{#if needsSetup}}needs-setup{{/if}}" data-action="openSetup"><i class="fas fa-gear"></i> {{localize "SDE.loot.generator.setup"}}</button>
    {{#if hasTables}}
    <button type="button" class="ui-btn ghost" data-action="dropCoinsPrompt"><i class="fas fa-coins"></i> {{localize "SDE.loot.generator.dropCoins"}}</button>
    <div class="ui-right">
      <button type="button" class="ui-btn" data-action="rollForToken"><i class="fas fa-crosshairs"></i> {{localize "SDE.loot.generator.rollForToken"}}</button>
      <button type="button" class="ui-btn primary" data-action="rollLoot"><i class="fas fa-dice-d20"></i> {{localize "SDE.loot.generator.roll"}}</button>
    </div>
    {{/if}}
  </footer>
</div>

<div class="sde-lootgen">
  {{#if hasTables}}
  <div class="sde-lootgen-controls">
    <select data-loot-table aria-label="{{localize 'SDE.monsterLoot.colTable'}}">
      {{#each tables as |t|}}
      <option value="{{t.uuid}}" {{#if t.isSelected}}selected{{/if}}>{{t.name}}</option>
      {{/each}}
    </select>
    <button type="button" class="sde-lootgen-roll" data-action="rollLoot"><i class="fas fa-dice-d20"></i> {{localize "SDE.loot.generator.roll"}}</button>
    <button type="button" class="sde-lootgen-rolltoken" data-action="rollForToken"><i class="fas fa-crosshairs"></i> {{localize "SDE.loot.generator.rollForToken"}}</button>
    <button type="button" class="sde-lootgen-setup {{#if needsSetup}}needs-setup{{/if}}" data-action="openSetup"><i class="fas fa-gear"></i> {{localize "SDE.loot.generator.setup"}}</button>
    <button type="button" class="sde-lootgen-dropcoins-manual" data-action="dropCoinsPrompt"><i class="fas fa-coins"></i> {{localize "SDE.loot.generator.dropCoins"}}</button>
  </div>
  <p class="notes">{{localize "SDE.loot.generator.rollHint"}}</p>
  <p class="notes"><i class="fa-solid fa-circle-info"></i> {{{localize "SDE.loot.generator.curatedHint"}}}</p>
  {{else}}
  <p class="notes">{{{localize "SDE.loot.generator.emptyHint"}}}</p>
  <button type="button" class="sde-lootgen-setup needs-setup" data-action="openSetup"><i class="fas fa-gear"></i> {{localize "SDE.loot.generator.setup"}}</button>
  {{/if}}

  {{#if hasHistory}}
  <ul class="sde-lootgen-history">
    {{#each history as |e|}}
    <li class="sde-lootgen-entry">
      <div class="sde-lootgen-entry-head"><i class="fas fa-book-open"></i> {{e.tableName}}</div>
      {{#if e.items.length}}
      <ul class="sde-lootgen-items">
        {{#each e.items as |it|}}
        <li><img src="{{it.img}}" width="22" height="22" alt=""> <span>{{it.name}}</span>{{#if it.forgeable}}<button type="button" class="sde-lootgen-forge" data-action="forgeEntryItem" data-entry-id="{{e.id}}" data-item-index="{{it.idx}}"><i class="fas fa-hammer"></i> {{localize "SDE.loot.btn.forge"}}</button>{{/if}}</li>
        {{/each}}
      </ul>
      {{/if}}
      {{#if e.hasCoins}}<div class="sde-lootgen-coins"><i class="fas fa-coins"></i> {{e.coinsLabel}}</div>{{/if}}
      {{#each e.notes as |n|}}<div class="sde-lootgen-note">{{n}}</div>{{/each}}
      {{#if e.isEmpty}}<div class="sde-lootgen-note">{{localize "SDE.loot.generator.nothing"}}</div>{{/if}}
      <div class="sde-lootgen-entry-actions">
        <button type="button" class="sde-lootgen-post" data-action="postEntry" data-entry-id="{{e.id}}"><i class="fas fa-comment"></i> {{localize "SDE.loot.generator.post"}}</button>
        <button type="button" class="sde-lootgen-drop" data-action="dropEntry" data-entry-id="{{e.id}}"><i class="fas fa-box-open"></i> {{localize "SDE.loot.generator.dropGround"}}</button>
        <select class="sde-lootgen-recipient" data-entry-id="{{e.id}}" aria-label="{{localize 'SDE.loot.generator.recipientAria'}}">
          <option value="party">{{localize "SDE.loot.generator.partyOption"}}</option>
          {{#each e.party as |p|}}<option value="{{p.id}}">{{p.name}}</option>{{/each}}
        </select>
        <button type="button" class="sde-lootgen-give" data-action="giveEntry" data-entry-id="{{e.id}}"><i class="fas fa-gift"></i> {{localize "SDE.loot.btn.give"}}</button>
      </div>
    </li>
    {{/each}}
  </ul>
  <div class="sde-lootgen-footer">
    <button type="button" class="sde-lootgen-clear" data-action="clearHistory"><i class="fas fa-trash"></i> {{localize "SDE.loot.generator.clearHistory"}}</button>
  </div>
  {{/if}}
</div>

<div class="sde-spell-importer">

  <div class="sde-si-head">
    <div class="sde-si-title"><i class="fa-solid fa-wand-sparkles"></i> {{localize "SDE.importer.spellImporter.title"}}</div>
    <div class="sde-si-headright">
      {{#if spellCount}}<span class="sde-si-chip sde-si-chip-on">{{localize "SDE.importer.spellImporter.parsedChip" n=spellCount}}</span>{{else}}<span class="sde-si-chip">{{localize "SDE.importer.spellImporter.noSpellsYet"}}</span>{{/if}}
      <button type="button" data-action="siStartOver" class="sde-cu-btn"><i class="fas fa-rotate-left"></i> {{localize "SDE.importer.classImporter.startOver"}}</button>
    </div>
  </div>

  {{!-- Preset spell list — sets Class + Alignment + Source and deep-links the PDF.
        Druid/Sorcerer/Mage are Wizard spells split by alignment; WR Priest lists
        split by alignment; Necromancer is its own class. --}}
  <label class="sde-si-field">
    <span class="sde-si-fieldname">{{localize "SDE.importer.cls.spellListAria"}}</span>
    <select data-si-list class="sde-si-listsel">
      <option value="">{{localize "SDE.importer.spellImporter.pickList"}}</option>
      {{#each spellLists as |l|}}<option value="{{l.key}}"{{#if l.selected}} selected{{/if}}>{{l.label}}</option>{{/each}}
    </select>
    {{#if listPdf}}<button type="button" data-action="siOpenPdf" data-href="{{listPdf}}" class="sde-cu-btn" title="{{localize 'SDE.importer.spellImporter.openListTip' label=listLabel}}"><i class="fas fa-file-pdf"></i> {{#if listPage}}{{localize "SDE.importer.spellImporter.openPdfPage" page=listPage}}{{else}}{{localize "SDE.importer.seed.openPdf"}}{{/if}}</button>{{/if}}
  </label>

  <label class="sde-si-field">
    <span class="sde-si-fieldname">{{localize "SDE.importer.source.label"}}</span>
    <input type="text" data-si-source list="sde-si-sources" value="{{source}}" placeholder="{{localize 'SDE.importer.spellImporter.sourcePlaceholder'}}">
    <datalist id="sde-si-sources">{{#each sourceList as |s|}}<option value="{{s}}"></option>{{/each}}</datalist>
  </label>

  {{#if imported}}
  <div class="sde-si-imported">
    <div class="sde-ci-impitem sde-ci-impok"><i class="fas fa-circle-check"></i> {{#if imported.created}}{{localize "SDE.importer.spellImporter.importedNoS" n=imported.created}}{{else}}{{localize "SDE.importer.spellImporter.importedS" n=imported.created}}{{/if}}{{#if imported.skipped}} {{localize "SDE.importer.spellImporter.importedSkipped" n=imported.skipped}}{{/if}}</div>
    <div class="sde-ci-impitem sde-ci-impok"><i class="fas fa-circle-check"></i> {{localize "SDE.importer.spellImporter.importedTags" classes=imported.classes alignments=imported.alignments}}</div>
  </div>
  {{/if}}

  {{!-- Defaults bar — the Class → Alignment these spells belong to. --}}
  <div class="sde-si-bulkbar">
    <span class="sde-si-bulklabel">{{localize "SDE.importer.spellImporter.bulkLabel"}}</span>
    <label class="sde-si-bulkfield">{{localize "SDE.importer.spells.class"}}
      <input type="text" data-si-bulkclass list="sde-si-classes" value="{{bulkClass}}" placeholder="{{localize 'SDE.importer.spells.classPlaceholder'}}">
      <datalist id="sde-si-classes"><option value="Wizard"></option><option value="Priest"></option><option value="Necromancer"></option><option value="Witch"></option><option value="Seer"></option><option value="Warlock"></option></datalist>
    </label>
    <label class="sde-si-bulkfield">{{localize "SDE.charBuilder.step.alignment"}}
      <select data-si-bulkalign>{{#each bulkAlignOptions as |o|}}<option value="{{o.value}}"{{#if o.selected}} selected{{/if}}>{{o.label}}</option>{{/each}}</select>
    </label>
    {{#if spellCount}}<button type="button" data-action="siApplyBulk" class="sde-cu-btn" title="{{localize 'SDE.importer.spellImporter.applyTip'}}">{{localize "SDE.importer.spellImporter.applyAll"}}</button>{{/if}}
  </div>
  <p class="sde-si-note"><i class="fas fa-circle-info"></i> {{{localize "SDE.importer.spellImporter.presetNote"}}}</p>

  <textarea data-si-paste class="sde-si-paste" placeholder="{{localize 'SDE.importer.spellImporter.pastePlaceholder'}}">{{pasteText}}</textarea>
  <div class="sde-si-parsebtns">
    <button type="button" data-action="siParse" class="sde-cu-btn"><i class="fas fa-wand-magic"></i> {{localize "SDE.importer.spellImporter.parseSpells"}}</button>
    <button type="button" data-action="siGrabPdf" class="sde-cu-btn" title="{{localize 'SDE.importer.spellImporter.grabTip'}}"><i class="fas fa-wand-magic-sparkles"></i> {{localize "SDE.importer.seed.grabFromPdf"}}</button>
    {{#if summary}}<span class="sde-si-summary">{{summary}}</span>{{/if}}
  </div>

  {{#if spellCount}}
  <div class="sde-si-groups">
    {{#each groups as |g|}}
    <div class="sde-si-group">
      <div class="sde-si-grouphead"><i class="fa-solid fa-layer-group"></i> {{localize "SDE.importer.spellImporter.groupHead" class=g.class tier=g.tier alignment=g.alignmentLabel}} <span class="sde-si-groupcount">({{g.spells.length}})</span></div>
      {{#each g.spells as |sp|}}
      <div class="sde-si-spellrow" data-si-spell="{{sp.idx}}">
        <span class="sde-si-spellname{{#if sp.warn}} sde-si-warn{{/if}}" title="{{sp.desc}}">{{sp.name}}</span>
        <label class="sde-si-inline">T<input type="number" min="1" max="5" data-si-field="tier" value="{{sp.tier}}" class="sde-si-tier"></label>
        <input type="text" data-si-field="class" value="{{sp.className}}" class="sde-si-cls" aria-label="{{localize 'SDE.importer.spellImporter.castingClassAria'}}">
        <select data-si-field="alignment" class="sde-si-align">{{#each sp.alignOptions as |a|}}<option value="{{a.value}}"{{#if a.selected}} selected{{/if}}>{{a.label}}</option>{{/each}}</select>
        <button type="button" data-action="siRemove" class="sde-cu-btn sde-cu-btn-del" title="{{localize 'SDE.quests.remove'}}"><i class="fas fa-trash"></i></button>
      </div>
      {{/each}}
    </div>
    {{/each}}
  </div>

  <div class="sde-si-footer">
    <span class="sde-si-pending">{{summary}}</span>
    <button type="button" data-action="siImport" class="sde-import-primary"><i class="fas fa-download"></i> {{#if spellCount}}{{localize "SDE.importer.spellImporter.importNoS" n=spellCount}}{{else}}{{localize "SDE.importer.spellImporter.importS" n=spellCount}}{{/if}}</button>
  </div>
  {{/if}}

</div>

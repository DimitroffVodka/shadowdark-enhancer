{{!-- Quest Log: filters in the header, 5 status tabs, list + detail. Same context and data-* as templates/quest-log.hbs. --}}
<div class="ui-shell sde-quest-log-root">

  <header class="ui-head ql-filters">
    <select name="ql-filter-character" data-ql-filter="character" aria-label="{{localize "SDE.quests.characters"}}">
      <option value="">{{localize "SDE.quests.filter.anyCharacter"}}</option>
      {{#each filterCharacters}}<option value="{{uuid}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}
    </select>
    {{#unless inline}}{{#if hasParties}}
      <select name="ql-filter-party" data-ql-filter="party" aria-label="{{localize "SDE.quests.party"}}">
        <option value="">{{localize "SDE.quests.filter.anyParty"}}</option>
        {{#each filterParties}}<option value="{{uuid}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}
      </select>
    {{/if}}{{/unless}}
    <select name="ql-filter-source" data-ql-filter="source" aria-label="{{localize "SDE.quests.sourceLabel"}}">
      <option value="">{{localize "SDE.quests.filter.anySource"}}</option>
      {{#each filterSources}}<option value="{{kind}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
    </select>
    {{#if isGM}}{{#unless inline}}<button type="button" class="ui-btn ql-rumors" data-action="qlFromRumors"><i class="fa-solid fa-scroll"></i> {{localize "SDE.quests.fromRumors"}}</button>{{/unless}}{{/if}}
    {{#if isGM}}<button type="button" class="ui-btn primary ql-new" data-action="qlNew"><i class="fa-solid fa-plus"></i> {{localize "SDE.quests.new"}}</button>{{/if}}
  </header>

  <nav class="ui-tabs">
    {{#each tabs}}
      <button type="button" class="ui-tab {{#if active}}active{{/if}}" data-action="qlTab" data-status="{{status}}">{{label}} <span class="ui-count">{{count}}</span></button>
    {{/each}}
  </nav>

  <div class="ui-body ql-body">
    <div class="ql-split">

      <div class="ui-list ql-list">
        {{#each quests}}
          <div class="ui-row ql-item {{#if selected}}sel{{/if}}" data-action="qlSelect" data-id="{{id}}">
            <div class="ui-row-main"><span class="ui-row-name">{{name}}</span><span class="ui-row-sub">{{sourceLabel}}</span></div>
            {{#if progress.total}}<span class="ui-chip {{#if selected}}gold{{/if}}">{{progress.done}}/{{progress.total}}</span>{{/if}}
          </div>
        {{else}}
          <div class="ui-empty"><i class="fa-solid fa-list-check"></i><span>{{localize "SDE.quests.empty"}}</span></div>
        {{/each}}
      </div>

      <section class="ql-detail">
        {{#if payoutHTML}}<div class="ui-card sel">{{{payoutHTML}}}<div class="ui-inline"><button type="button" class="ui-btn" data-action="qlCancelPayout">{{localize "SDE.quests.payout.cancel"}}</button><button type="button" class="ui-btn primary ui-right" data-action="qlConfirmPayout">{{localize "SDE.quests.payout.confirm"}}</button></div></div>{{/if}}
        {{#with quest}}

          <div class="ui-card">
            {{#if ../isGM}}
              <div class="ql-titlerow">
                <input type="text" class="ql-name" name="ql-name" data-ql-field="name" value="{{name}}" aria-label="{{localize "SDE.quests.name"}}">
                <select name="ql-status" data-ql-field="status" aria-label="{{localize "SDE.quests.statusLabel"}}">{{#each statusOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
              </div>
            {{else}}
              <h2 class="ui-title ql-title">{{name}}</h2>
            {{/if}}
            <div class="ui-inline">
              <span class="ui-chip gold">{{statusLabel}}</span><span class="ui-chip">{{sourceLabel}}</span>{{#if when.overdue}}<span class="ui-chip bad">{{localize "SDE.quests.overdue"}}</span>{{/if}}
              {{#unless ../inline}}{{#if source.uuid}}<a data-action="qlOpenSource">{{localize "SDE.quests.openSource"}}</a>{{/if}}{{/unless}}
              {{#if canAccept}}<a data-action="qlAccept"><i class="fa-solid fa-scroll"></i> {{localize "SDE.quests.acceptLink"}}</a>{{/if}}
              <span class="ui-right ui-inline">
                {{#unless ../inline}}<button type="button" class="ui-btn" data-action="qlOpenJournal"><i class="fa-solid fa-book-open"></i> {{localize "SDE.quests.openJournal"}}</button>{{/unless}}
                {{#if hasPin}}<button type="button" class="ui-btn" data-action="qlJump"><i class="fa-solid fa-location-dot"></i> {{localize "SDE.quests.jump"}}</button>{{/if}}
              </span>
            </div>
            {{#if when.dueText}}<p class="ql-due">{{when.dueText}}</p>{{/if}}
            {{#if ../isGM}}
              <div class="ui-field"><span class="ui-label">{{localize "SDE.quests.givenBy"}}</span>
                <div class="sde-ql-giver ql-drop">
                  {{#if giver}}<span class="ui-chip">{{#if giver.img}}<img src="{{giver.img}}" alt="" width="18" height="18"> {{/if}}{{giver.name}} <a class="ui-icon ql-x" data-action="qlClearGiver" aria-label="{{localize "SDE.quests.giverClear"}}" title="{{localize "SDE.quests.giverClear"}}"><i class="fa-solid fa-xmark"></i></a></span>
                  {{else}}<span class="ui-muted">{{localize "SDE.quests.giverDrop"}}</span>{{/if}}
                </div></div>
            {{else if giver}}
              <div class="ui-inline"><span class="ui-label">{{localize "SDE.quests.givenBy"}}</span>
                <span class="ui-chip">{{#if giver.img}}<img src="{{giver.img}}" alt="" width="18" height="18"> {{/if}}{{giver.name}}</span></div>
            {{/if}}
          </div>

          <div class="ui-card">
            <h3 class="ui-h">{{localize "SDE.quests.characters"}}</h3>
            <div class="ui-inline">
              {{#each characterList}}
                <span class="ui-chip">{{name}}{{#if ../../isGM}} <a class="ui-icon ql-x" data-action="qlRemoveCharacter" data-uuid="{{uuid}}" aria-label="{{localize "SDE.quests.remove"}}"><i class="fa-solid fa-xmark"></i></a>{{/if}}</span>
              {{else}}<span class="ui-muted">{{localize "SDE.quests.noCharacters"}}</span>{{/each}}
            </div>
            {{#if ../isGM}}
              <select name="ql-add-character" data-ql-field="addCharacter" aria-label="{{localize "SDE.quests.addCharacter"}}">
                <option value="">{{localize "SDE.quests.addCharacter"}}</option>
                {{#each addableCharacters}}<option value="{{uuid}}">{{name}}</option>{{/each}}
              </select>
            {{/if}}
            {{#if ../hasParties}}
              <div class="ui-pair"><span class="ui-label">{{localize "SDE.quests.party"}}</span>
              {{#if ../inline}}<span class="ui-value">{{partyName}}</span>{{else}}{{#if ../isGM}}
                <select name="ql-party" data-ql-field="party" aria-label="{{localize "SDE.quests.party"}}"><option value="">{{localize "SDE.quests.noParty"}}</option>{{#each partyOptions}}<option value="{{uuid}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select>
              {{else}}<span class="ui-value">{{#if partyName}}{{partyName}}{{else}}{{localize "SDE.quests.noParty"}}{{/if}}</span>{{/if}}{{/if}}</div>
            {{/if}}
          </div>

          <div class="ui-card">
            <h3 class="ui-h">{{localize "SDE.quests.description"}}</h3>
            {{#if ../isGM}}<textarea name="ql-description" data-ql-field="description" rows="4" aria-label="{{localize "SDE.quests.description"}}">{{description}}</textarea>
            {{else}}<div class="ql-desc">{{{descriptionHtml}}}</div>{{/if}}
          </div>

          <div class="ui-card">
            <h3 class="ui-h">{{localize "SDE.quests.objectives"}}{{#if progress.total}} <small>{{progress.done}}/{{progress.total}}</small>{{/if}}</h3>
            {{#if ../isGM}}
              <div class="ui-pair"><label class="ui-label">{{localize "SDE.quests.reveal"}}
                <select name="ql-reveal" data-ql-field="reveal">{{#each revealOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label></div>
            {{/if}}
            <div class="ui-list ql-flat">
              {{#each objectives}}
                <div class="ui-row {{#if parent}}ql-sub{{/if}} {{#if done}}ql-done{{/if}} {{#if secret}}ql-secret{{/if}}">
                  <input type="checkbox" name="ql-obj-done-{{id}}" data-ql-field="objectiveDone" data-objective="{{id}}" {{#if done}}checked{{/if}} {{#unless ../../isGM}}disabled{{/unless}} aria-label="{{text}}">
                  {{#if ../../isGM}}
                    <input type="text" name="ql-obj-{{id}}" data-ql-field="objectiveText" data-objective="{{id}}" value="{{text}}" aria-label="{{text}}">
                    {{#if secret}}<span class="ui-chip ql-secret-mark" title="{{localize "SDE.quests.secretMark"}}">{{localize "SDE.quests.secretChip"}}</span>{{/if}}
                    <a class="ui-icon" data-action="qlToggleSecret" data-objective="{{id}}" title="{{#if secret}}{{localize "SDE.quests.makeVisible"}}{{else}}{{localize "SDE.quests.makeSecret"}}{{/if}}" aria-label="{{#if secret}}{{localize "SDE.quests.makeVisible"}}{{else}}{{localize "SDE.quests.makeSecret"}}{{/if}}"><i class="fa-solid {{#if secret}}fa-eye-slash{{else}}fa-eye{{/if}}"></i></a>
                    {{#if parent}}<span class="ui-icon" aria-hidden="true"></span>{{else}}<a class="ui-icon" data-action="qlAddSubStep" data-objective="{{id}}" aria-label="{{localize "SDE.quests.addSubStep"}}" title="{{localize "SDE.quests.addSubStep"}}"><i class="fa-solid fa-turn-down fa-rotate-270"></i></a>{{/if}}
                    <a class="ui-icon danger" data-action="qlRemoveObjective" data-objective="{{id}}" aria-label="{{localize "SDE.quests.remove"}}"><i class="fa-solid fa-trash"></i></a>
                  {{else}}<span class="ui-row-main">{{text}}</span>{{/if}}
                </div>
                {{#if subRow}}
                  <div class="ui-row ql-sub ql-add">
                    <input type="text" name="ql-new-substep" data-ql-new-substep placeholder="{{localize "SDE.quests.newSubStep"}}" aria-label="{{localize "SDE.quests.newSubStep"}}">
                    <label class="ql-new-secret" title="{{localize "SDE.quests.newSecret"}}"><input type="checkbox" name="ql-new-substep-secret" data-ql-new-substep-secret {{#if ../newSubSecret}}checked{{/if}} aria-label="{{localize "SDE.quests.newSecret"}}"><i class="fa-solid fa-eye-slash"></i></label>
                    <button type="button" class="ui-btn" data-action="qlSubmitSubStep" aria-label="{{localize "SDE.quests.newSubStep"}}"><i class="fa-solid fa-plus"></i></button>
                  </div>
                {{/if}}
              {{else}}<div class="ui-row ui-muted">{{localize "SDE.quests.noObjectives"}}</div>{{/each}}
            </div>
            {{#if ../isGM}}
              <div class="ui-inline ql-add">
                <input type="text" name="ql-new-objective" data-ql-new-objective placeholder="{{localize "SDE.quests.newObjective"}}" aria-label="{{localize "SDE.quests.newObjective"}}">
                <label class="ql-new-secret" title="{{localize "SDE.quests.newSecret"}}"><input type="checkbox" name="ql-new-secret" data-ql-new-secret {{#if newSecret}}checked{{/if}} aria-label="{{localize "SDE.quests.newSecret"}}"><i class="fa-solid fa-eye-slash"></i></label>
                <button type="button" class="ui-btn" data-action="qlAddObjective" aria-label="{{localize "SDE.quests.newObjective"}}"><i class="fa-solid fa-plus"></i></button>
              </div>
            {{/if}}
          </div>

          <div class="ui-card">
            <h3 class="ui-h">{{localize "SDE.quests.rewards"}}{{#if paid}} <small>{{localize "SDE.quests.paid"}}</small>{{/if}}</h3>
            {{#if ../isGM}}
              <div class="ql-grid">
                <div class="ui-field"><label class="ui-label">{{localize "SDE.quests.xp"}}</label><input type="number" min="0" step="1" name="ql-xp" data-ql-field="xp" value="{{rewards.xp}}"></div>
                <div class="ui-field"><label class="ui-label">{{localize "SDE.quests.gp"}}</label><input type="number" min="0" step="1" name="ql-gp" data-ql-field="gp" value="{{rewards.coins.gp}}"></div>
                <div class="ui-field"><label class="ui-label">{{localize "SDE.quests.sp"}}</label><input type="number" min="0" step="1" name="ql-sp" data-ql-field="sp" value="{{rewards.coins.sp}}"></div>
                <div class="ui-field"><label class="ui-label">{{localize "SDE.quests.cp"}}</label><input type="number" min="0" step="1" name="ql-cp" data-ql-field="cp" value="{{rewards.coins.cp}}"></div>
                <div class="ui-field"><label class="ui-label">{{localize "SDE.quests.renown"}}</label><input type="number" step="1" name="ql-renown" data-ql-field="renown" value="{{rewards.renown}}"></div>
                <div class="ui-field"><label class="ui-label">{{localize "SDE.quests.training"}}</label>
                  <select name="ql-training" data-ql-field="training"><option value="">{{localize "SDE.quests.noTraining"}}</option>{{#each trainerOptions}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></div>
              </div>
              <div class="sde-ql-drop ql-drop">
                {{#each rewards.items}}
                  <span class="ui-chip"><img src="{{img}}" alt="" width="18" height="18"> {{name}} <a class="ui-icon ql-x" data-action="qlRemoveItem" data-index="{{@index}}" aria-label="{{localize "SDE.quests.remove"}}"><i class="fa-solid fa-xmark"></i></a></span>
                {{/each}}
                <span class="ui-muted">{{localize "SDE.quests.dropItems"}}</span>
              </div>
              <h4 class="ui-label ql-notes-h">{{localize "SDE.quests.otherRewards"}}</h4>
              <div class="ui-list ql-flat">
                {{#each noteList}}
                  <div class="ui-row">
                    <input type="text" maxlength="200" name="ql-note-{{index}}" data-ql-field="noteText" data-index="{{index}}" value="{{text}}" aria-label="{{text}}">
                    <a class="ui-icon danger" data-action="qlRemoveNote" data-index="{{index}}" aria-label="{{localize "SDE.quests.remove"}}"><i class="fa-solid fa-xmark"></i></a>
                  </div>
                {{/each}}
              </div>
              <div class="ui-inline ql-add">
                <input type="text" maxlength="200" name="ql-new-note" data-ql-new-note placeholder="{{localize "SDE.quests.newNote"}}" aria-label="{{localize "SDE.quests.newNote"}}">
                <button type="button" class="ui-btn" data-action="qlSubmitNote" aria-label="{{localize "SDE.quests.newNote"}}"><i class="fa-solid fa-plus"></i></button>
              </div>
              <p class="ui-muted">{{localize "SDE.quests.noteHint"}}</p>
            {{else}}
              {{#if hasNotes}}{{else if hasRewards}}{{else}}<span class="ui-muted">{{localize "SDE.quests.noRewards"}}</span>{{/if}}
              {{#if hasRewards}}
                <div class="ui-inline">
                  {{#if rewards.xp}}<span class="ui-chip gold">{{localize "SDE.quests.reward.xp" n=rewards.xp}}</span>{{/if}}
                  {{#each coinRewards}}<span class="ui-chip gold">{{this}}</span>{{/each}}
                  {{#if rewards.renown}}<span class="ui-chip gold">{{localize "SDE.quests.reward.renown" n=renownSigned}}</span>{{/if}}
                  {{#each rewards.items}}<span class="ui-chip"><img src="{{img}}" alt="" width="18" height="18"> {{name}}</span>{{/each}}
                  {{#if trainerName}}<span class="ui-chip">{{localize "SDE.quests.reward.training" trainer=trainerName}}</span>{{/if}}
                </div>
              {{/if}}
              {{#if hasNotes}}
                <div class="ui-inline">{{#each noteList}}<span class="ui-chip">{{text}}</span>{{/each}}</div>
              {{/if}}
            {{/if}}
          </div>

          {{#if ../isGM}}
            <details class="ui-details" data-ql-when {{#if whenOpen}}open{{/if}}>
              <summary>{{localize "SDE.quests.when"}}</summary>
              <div class="ui-details-body">
                {{#each when.rows}}
                  <div class="ui-field ql-date" data-ql-date="{{field}}">
                    <span class="ui-label">{{label}}</span>
                    <div class="ql-date-row">
                      <input class="ui-num-in" type="number" step="1" name="ql-{{field}}-day" data-part="day" value="{{day}}" aria-label="{{localize "SDE.quests.dateDay"}}" placeholder="{{localize "SDE.quests.dateDay"}}">
                      <select name="ql-{{field}}-month" data-part="month" aria-label="{{localize "SDE.quests.dateMonth"}}">
                        <option value="">{{localize "SDE.quests.dateMonth"}}</option>
                        {{#each months}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
                      </select>
                      <input class="ui-num-in" type="number" step="1" name="ql-{{field}}-year" data-part="year" value="{{year}}" aria-label="{{localize "SDE.quests.dateYear"}}" placeholder="{{localize "SDE.quests.dateYear"}}">
                      {{#if set}}<a class="ui-icon danger" data-action="qlClearDate" data-date="{{field}}" aria-label="{{localize "SDE.quests.dateClear"}}" title="{{localize "SDE.quests.dateClear"}}"><i class="fa-solid fa-xmark"></i></a>{{else}}<span class="ui-icon" aria-hidden="true"></span>{{/if}}
                    </div>
                  </div>
                {{/each}}
                {{#if when.appearsPassed}}<p class="ui-muted">{{localize "SDE.quests.datePassedAppears"}}</p>{{/if}}
                {{#if deadline}}
                  <label class="ql-check"><input type="checkbox" name="ql-autofail" data-ql-field="autoFail" {{#if autoFail}}checked{{/if}}> {{localize "SDE.quests.autoFail"}}</label>
                {{/if}}
                {{#if when.failPassed}}<p class="ui-muted">{{localize "SDE.quests.datePassedFails"}}</p>{{/if}}
                <p class="ui-muted">{{localize "SDE.quests.whenHint"}}</p>
              </div>
            </details>
          {{/if}}

          {{#if ../isGM}}
            <details class="ui-details">
              <summary>{{localize "SDE.quests.location"}}</summary>
              <div class="ui-details-body">
                <div class="ui-field"><label class="ui-label">{{localize "SDE.quests.hex"}}</label><input class="ui-num-in" type="number" min="1" step="1" name="ql-hex" data-ql-field="hex" value="{{hex}}"></div>
                <p class="ui-muted">{{localize "SDE.quests.locationHint"}}</p>
              </div>
            </details>
          {{/if}}
        {{else}}
          <div class="ui-empty"><i class="fa-solid fa-scroll"></i><span>{{localize "SDE.quests.pickOne"}}</span></div>
        {{/with}}
      </section>
    </div>
  </div>
</div>

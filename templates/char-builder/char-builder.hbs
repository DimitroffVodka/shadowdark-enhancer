<div class="sde-cb">

  {{!-- Tab bar --}}
  <nav class="sde-cb-tabs">
    {{#each steps}}
    <button type="button"
      class="sde-cb-tab{{#if active}} active{{/if}}{{#if complete}} complete{{/if}}"
      data-action="cb-goto" data-index="{{index}}" data-step="{{id}}">
      <span class="sde-cb-tab-num">{{num}}</span><span class="sde-cb-tab-label">{{label}}</span>
    </button>
    {{/each}}
  </nav>

  {{!-- Active step body --}}
  <div class="sde-cb-body" data-step="{{stepId}}">
    {{> (lookup . 'stepPartial') }}
  </div>

  {{!-- Footer --}}
  <footer class="sde-cb-footer">
    <div class="sde-cb-footer-left">
      <button type="button" class="sde-cb-btn ghost" data-action="cb-dismiss">
        <i class="fa-solid fa-circle-xmark"></i> {{localize "SDE.charBuilder.nav.dismiss"}}
      </button>
      {{#if nav.canUndo}}
      <button type="button" class="sde-cb-btn ghost" data-action="cb-undo" {{#if nav.finishing}}disabled{{/if}}>
        <i class="fa-solid fa-rotate-left"></i> {{localize "SDE.charBuilder.existing.undo"}}
      </button>
      {{/if}}
      {{#if nav.levelUpOffer}}
      <button type="button" class="sde-cb-btn dice" data-action="cb-level-up">
        <i class="fa-solid fa-arrow-up"></i> {{localize "SDE.charBuilder.levelUp.button"}} ({{nav.levelUpOffer.to}})
      </button>
      {{/if}}
      {{#if nav.levelUpActive}}
      <button type="button" class="sde-cb-btn ghost" data-action="cb-level-up-cancel" {{#if nav.finishing}}disabled{{/if}}>
        <i class="fa-solid fa-xmark"></i> {{localize "SDE.charBuilder.levelUp.cancel"}} ({{nav.levelUpActive.from}} → {{nav.levelUpActive.to}})
      </button>
      {{/if}}
      {{#if nav.level}}
      <label class="sde-cb-level" title="{{localize 'SDE.charBuilder.levelHint'}}">
        <span>{{localize "SDE.charBuilder.level"}}</span>
        <select data-cb-level>
          {{#each nav.level.options}}
          <option value="{{value}}"{{#if selected}} selected{{/if}}>{{value}}</option>
          {{/each}}
        </select>
      </label>
      {{/if}}
      {{#if nav.showFullRandom}}
      <button type="button" class="sde-cb-btn danger" data-action="cb-full-random">
        <i class="fa-solid fa-bolt"></i> {{localize "SDE.charBuilder.nav.fullRandom"}}
      </button>
      {{/if}}
      {{#if nav.supportsRandom}}
      <button type="button" class="sde-cb-btn dice" data-action="cb-random">
        <i class="fa-solid fa-dice"></i> {{localize "SDE.charBuilder.nav.random"}}
      </button>
      {{/if}}
    </div>
    <div class="sde-cb-footer-right">
      <button type="button" class="sde-cb-btn nav" data-action="cb-prev" {{#unless nav.canPrev}}disabled{{/unless}}>
        <i class="fa-solid fa-caret-left"></i> {{localize "SDE.charBuilder.nav.prev"}}
      </button>
      <button type="button" class="sde-cb-btn nav" data-action="cb-next" {{#if nav.isLast}}disabled{{/if}}>
        {{localize "SDE.charBuilder.nav.next"}} <i class="fa-solid fa-caret-right"></i>
      </button>
      <button type="button" class="sde-cb-btn nav finish{{#if nav.allComplete}} ready{{/if}}" data-action="cb-finish" {{#if nav.finishing}}disabled{{/if}}>
        <i class="fa-solid fa-check"></i> {{#if nav.existing}}{{localize "SDE.charBuilder.existing.finish"}}{{else}}{{localize "SDE.charBuilder.nav.finish"}}{{/if}}
      </button>
    </div>
  </footer>

</div>

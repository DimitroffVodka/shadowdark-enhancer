<div class="sde-cb-roll-step">
  {{#if step.existing}}
  <p class="sde-cb-hint"><i class="fa-solid fa-lock"></i> {{localize "SDE.charBuilder.gold.existingHint"}}</p>
  <div class="sde-cb-big-number">
    <span class="val">{{step.coinsText}}</span>
  </div>
  {{else}}
  {{#if step.fixed}}
  <p class="sde-cb-method-label">
    <i class="fa-solid fa-lock"></i> {{localize "SDE.charBuilder.gold.fixed"}}: <b>{{step.fixed}} {{localize "SDE.charBuilder.gold.unit"}}</b>
    <span class="gm">({{localize "SDE.charBuilder.stats.methodGm"}})</span>
  </p>
  {{else}}
  <p class="sde-cb-method-label">{{localize "SDE.charBuilder.gold.formula"}}: <b>{{localize "SDE.charBuilder.gold.rollFormula"}} {{localize "SDE.charBuilder.gold.unit"}}</b></p>
  <div class="sde-cb-stats-btns">
    {{#if step.rollLocked}}
    <span class="sde-cb-hint"><i class="fa-solid fa-lock"></i> {{localize "SDE.charBuilder.lockedRoll"}}</span>
    {{else}}
    <button type="button" class="sde-cb-btn dice" data-action="cb-roll-gold">
      <i class="fa-solid fa-dice"></i> {{#if step.rolled}}{{localize "SDE.charBuilder.gold.rollAgain"}}{{else}}{{localize "SDE.charBuilder.gold.roll"}}{{/if}}
    </button>
    {{/if}}
    {{#if step.canEdit}}
    <label class="sde-cb-field inline">
      <span>{{localize "SDE.charBuilder.gold.manual"}}</span>
      <input type="number" min="0" step="1" data-cb-gold-input value="{{step.gp}}" class="sde-cb-gold-input">
    </label>
    {{/if}}
  </div>
  {{/if}}

  <div class="sde-cb-big-number">
    <span class="val">{{step.gp}}</span>
    <span class="unit">{{localize "SDE.charBuilder.gold.unit"}}</span>
  </div>
  {{/if}}
</div>

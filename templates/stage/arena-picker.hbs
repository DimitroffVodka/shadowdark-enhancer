{{!-- Arena fight picker: six looks as thumbnail radios, the default checked. Submitted by the dialog's Fight button as `look`. --}}
<div class="ap-body">
  <p id="ap-hint" class="ui-sub ap-hint">{{localize "SDE.stage.arena.pickerHint"}}</p>
  <div class="ap-grid" role="radiogroup" aria-labelledby="ap-hint">
    {{#each looks as |l|}}
    <label class="ap-look">
      <input type="radio" name="look" value="{{l.id}}"{{#if l.checked}} checked{{/if}}>
      <img class="ap-thumb" src="{{l.thumb}}" alt="" loading="lazy" decoding="async">
      <span class="ap-name">{{l.label}}</span>
    </label>
    {{/each}}
  </div>
</div>

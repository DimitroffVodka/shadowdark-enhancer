{{!-- Stage places, list part: the GM's places. Redrawn on any setting change; the Add form is a separate part. --}}
<div class="ui-shell sp">
  <div class="ui-body">
    <section class="ui-group">
      {{#if places.length}}
      <div class="ui-list sp-list">
        {{#each places as |p|}}
        <div class="ui-row sp-row{{#if p.shown}} sel{{/if}}" data-place-id="{{p.id}}">
          <img class="sp-thumb" src="{{p.image}}" alt="" loading="lazy" decoding="async" data-tooltip="{{p.name}}">
          <div class="sp-main">
            <div class="sp-fields">
              <input type="text" class="sp-name" id="sp-name-{{p.id}}" name="sp-name-{{p.id}}" value="{{p.name}}" maxlength="60" data-place-field="name" data-place-id="{{p.id}}" aria-label="{{localize 'SDE.stage.places.ariaName' name=p.name}}" data-tooltip="{{p.name}}">
              <select class="sp-kind" id="sp-kind-{{p.id}}" name="sp-kind-{{p.id}}" data-place-field="kind" data-place-id="{{p.id}}" aria-label="{{localize 'SDE.stage.places.ariaKind' name=p.name}}">
                {{#each p.kinds as |k|}}<option value="{{k.value}}"{{#if k.selected}} selected{{/if}}>{{localize k.label}}</option>{{/each}}
              </select>
              <select class="sp-page" id="sp-page-{{p.id}}" name="sp-page-{{p.id}}" data-place-field="pageSceneId" data-place-id="{{p.id}}" aria-label="{{localize 'SDE.stage.places.ariaPage' name=p.name}}">
                <option value=""{{#if p.pageNone}} selected{{/if}}>{{localize "SDE.stage.places.pageNone"}}</option>
                {{#if p.pageMissing}}<option value="{{p.pageSceneId}}" selected>{{localize "SDE.stage.places.pageMissing"}}</option>{{/if}}
                {{#each p.pageScenes as |s|}}<option value="{{s.id}}"{{#if s.selected}} selected{{/if}}>{{s.name}}</option>{{/each}}
              </select>
            </div>
            <div class="sp-actions">
              {{#if p.shown}}
              <button type="button" class="ui-btn" data-action="hidePlace" data-place-id="{{p.id}}" aria-label="{{localize 'SDE.stage.places.ariaHide' name=p.name}}"><i class="fa-solid fa-eye-slash"></i> {{localize "SDE.stage.places.hideButton"}}</button>
              {{else}}
              <button type="button" class="ui-btn" data-action="showPlace" data-place-id="{{p.id}}" aria-label="{{localize 'SDE.stage.places.ariaShow' name=p.name}}"><i class="fa-solid fa-eye"></i> {{localize "SDE.stage.places.showButton"}}</button>
              {{/if}}
              <button type="button" class="ui-btn ghost" data-action="replacePicture" data-place-id="{{p.id}}" aria-label="{{localize 'SDE.stage.places.ariaReplace' name=p.name}}"><i class="fa-solid fa-image"></i> {{localize "SDE.stage.places.replaceButton"}}</button>
              <button type="button" class="ui-btn danger" data-action="deletePlace" data-place-id="{{p.id}}" aria-label="{{localize 'SDE.stage.places.ariaDelete' name=p.name}}"><i class="fa-solid fa-trash"></i> {{localize "SDE.stage.places.deleteButton"}}</button>
              <input type="file" accept="image/*" hidden data-replace-file="{{p.id}}">
            </div>
          </div>
        </div>
        {{/each}}
      </div>
      {{else}}
      <div class="ui-empty"><i class="fa-solid fa-images"></i><p>{{localize "SDE.stage.places.empty"}}</p></div>
      {{/if}}
    </section>
  </div>
</div>

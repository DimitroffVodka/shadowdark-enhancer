{{#if isGM}}
<header class="zb-head">
  <h1 class="zb-heading">{{localize "SDE.stage.zone.title"}} <span class="zb-round">{{localize "SDE.stage.zone.round" round=round}}</span></h1>
  <span class="zb-hint">{{localize "SDE.stage.zone.dropHint"}}</span>
  <button type="button" class="ui-btn danger zb-end" data-action="end">{{localize "SDE.stage.zone.endFight"}}</button>
</header>
{{/if}}
<div class="zb-bands">
  {{#each bands}}
  <section class="zb-band" data-zone="{{zone}}" aria-labelledby="sde-zb-title-{{zone}}">
    <h2 class="zb-title" id="sde-zb-title-{{zone}}">{{localize title}} <span class="zb-count">{{count}}</span></h2>
    <ul class="zb-chips">
      {{#each chips}}
      <li class="zb-chip{{#if turn}} turn{{/if}}{{#if defeated}} defeated{{/if}}{{#if hidden}} concealed{{/if}}{{#if foe}} foe{{/if}}" data-combatant-id="{{id}}">
        <img class="zb-portrait" src="{{img}}" alt="">
        <div class="zb-main">
          <div class="zb-name" data-tooltip="{{name}}">{{name}}</div>
          <div class="zb-marks" role="group" aria-label="{{localize 'SDE.stage.zone.conditions'}}">
            {{#if turn}}<span class="zb-mark turn-mark">{{localize "SDE.stage.zone.turnMark"}}</span>{{/if}}
            {{#if defeated}}<span class="zb-mark">{{localize "SDE.stage.zone.defeatedMark"}}</span>{{/if}}
            {{#if hidden}}<span class="zb-mark">{{localize "SDE.stage.zone.hiddenMark"}}</span>{{/if}}
            {{#each statuses}}<img class="zb-status" src="{{img}}" alt="{{name}}" title="{{name}}" aria-label="{{name}}">{{/each}}
          </div>
          <div class="zb-hp">
            <div class="ui-bar hp zb-bar tone-{{hp.tone}}" role="img" aria-label="{{localize hp.word}}"><i style="width: {{hp.pct}}%"></i></div>
            {{#if hp.numbers}}<span class="zb-hpnum" title="{{localize 'SDE.stage.zone.hpNumbers' value=hp.value max=hp.max}}">{{hp.value}}/{{hp.max}}</span>{{/if}}
          </div>
        </div>
        {{#if canAct}}
        <div class="zb-controls">
          <button type="button" class="ui-btn zb-step" data-action="closer" aria-label="{{localize 'SDE.stage.zone.labelCloser' name=name}}"{{#if atClose}} disabled{{/if}}><i class="fa-solid fa-arrow-down" aria-hidden="true"></i> {{localize "SDE.stage.zone.chipCloser"}}</button>
          <button type="button" class="ui-btn zb-step" data-action="farther" aria-label="{{localize 'SDE.stage.zone.labelFarther' name=name}}"{{#if atFar}} disabled{{/if}}><i class="fa-solid fa-arrow-up" aria-hidden="true"></i> {{localize "SDE.stage.zone.chipFarther"}}</button>
          {{#if canDefeat}}<button type="button" class="ui-btn ghost zb-defeat" data-action="defeated" aria-pressed="{{defeated}}" aria-label="{{localize 'SDE.stage.zone.labelDefeated' name=name}}">{{localize "SDE.stage.zone.defeatedToggle"}}</button>{{/if}}
          <details class="zb-pop">
            <summary class="ui-btn zb-sum" aria-label="{{localize 'SDE.stage.zone.labelDmgOpen' name=name}}">{{localize "SDE.stage.zone.dmgOpen"}}</summary>
            <div class="zb-popbody">
              <input type="number" class="zb-amount" min="1" step="1" inputmode="numeric" placeholder="{{localize 'SDE.stage.zone.dmgAmount'}}" aria-label="{{localize 'SDE.stage.zone.labelDmgAmount' name=name}}">
              <button type="button" class="ui-btn danger" data-action="damage" aria-label="{{localize 'SDE.stage.zone.labelDamage' name=name}}">{{localize "SDE.stage.zone.btnDamage"}}</button>
              <button type="button" class="ui-btn" data-action="heal" aria-label="{{localize 'SDE.stage.zone.labelHeal' name=name}}">{{localize "SDE.stage.zone.btnHeal"}}</button>
            </div>
          </details>
        </div>
        {{/if}}
      </li>
      {{else}}
      <li class="zb-empty">{{localize "SDE.stage.zone.bandEmpty"}}</li>
      {{/each}}
    </ul>
  </section>
  {{/each}}
</div>

{{!-- Shared NPC stat block: the Effects tab (effect items, then the active effects). --}}
    <section class="sde-veh-tab-content {{#if tab.effects}}active{{/if}}" data-tab-content="effects">
      <div class="SD-box">
        <div class="header"><label>{{localize "SHADOWDARK.sheet.general.effects_and_conditions.title"}}</label><span></span></div>
        <div class="content">
          {{#each effects}}
            <ol class="SD-list">
              <li class="header"><div class="item-name">{{label}}</div></li>
              {{#each items}}
                <li class="item effect flexrow" data-item-id="{{id}}" data-uuid="{{uuid}}">
                  <div class="item-image" style="background-image: url({{img}})"><i class="fas fa-comment fa-lg"></i></div>
                  <a class="item-name effect-name" data-action="show-details">{{name}}</a>
                  <div class="effect-duration">{{#if unlimited}}<i class="fas fa-infinity"></i>{{else}}<i class="fas fa-clock"></i>{{/if}}</div>
                </li>
              {{/each}}
            </ol>
          {{/each}}
        </div>
      </div>

      <div class="SD-box">
        <div class="header"><label>{{localize "SHADOWDARK.app.active_effects.title"}}</label><span><a class="fa-solid fa-square-plus" data-action="effectControl" data-effect-action="create"></a></span></div>
        <div class="content">
          <div class="sde-veh-field">
            <label>{{localize "SHADOWDARK.item.effect.pre-defined.title"}}</label>
            <input list="sde-npc-predefined-effects" name="predefinedEffects" type="text" value="" placeholder="{{localize 'SHADOWDARK.dialog.type_here'}}" />
            <datalist id="sde-npc-predefined-effects">{{#each predefinedEffects}}<option value="{{key}}" label="{{name}}"></option>{{/each}}</datalist>
          </div>
          <ol class="SD-list">
            {{#each activeEffects}}
              <li class="effect" data-effect-uuid="{{uuid}}">
                <div class="effect-image"><img src="{{img}}" /></div>
                <div class="effect-name">{{name}}</div>
                <div class="effect-name">{{source}}</div>
                <div class="effect-duration">{{#if unlimited}}<i class="fas fa-infinity"></i>{{else if duration}}{{duration}}{{else}}<i class="fas fa-clock"></i>{{/if}}</div>
                <div class="actions">
                  <a data-action="effectControl" data-effect-action="toggle" data-tooltip="{{localize 'SHADOWDARK.sheet.general.active_effects.toggle_effect.tooltip'}}">
                    {{#if disabled}}<i class="fas fa-circle-xmark"></i>{{else}}<i class="fas fa-circle-check" style="color:var(--primary);"></i>{{/if}}
                  </a>
                  <a data-action="effectControl" data-effect-action="toggle-situational" data-tooltip="{{localize 'SHADOWDARK.sheet.general.active_effects.toggle_situational.tooltip'}}">
                    {{#if situational}}<i class="fas fa-circle-question" style="color:var(--primary);"></i>{{else}}<i class="far fa-circle-question"></i>{{/if}}
                  </a>
                  <a data-action="effectControl" data-effect-action="edit" data-tooltip="{{localize 'SHADOWDARK.sheet.general.active_effects.edit_effect.tooltip'}}"><i class="fa-solid fa-pen-to-square"></i></a>
                  <a data-action="effectControl" data-effect-action="delete" data-tooltip="{{localize 'SHADOWDARK.sheet.general.active_effects.delete_effect.tooltip'}}"><i class="fas fa-trash"></i></a>
                </div>
              </li>
            {{/each}}
          </ol>
        </div>
      </div>
    </section>

<div class="sde-vehicle-sheet-body flexcol">

  {{!-- Header (Shadowdark system chrome) --}}
  <header class="SD-header flex0">
    <img class="portrait" src="{{document.img}}" data-edit="img" data-tooltip="{{document.name}}" height="110" width="110" />
    <div class="shadowdark-logo"><span>ShadowDark</span></div>
    <div class="SD-title">
      <input type="text" name="name" value="{{document.name}}" placeholder="{{localize 'SDE.boat.namePlaceholder'}}" />
    </div>
  </header>

  {{!-- Tab nav (Shadowdark system chrome) --}}
  <nav class="SD-nav flex0" data-group="primary">
    <a class="navigation-tab {{#if tab.overview}}active{{/if}}" data-action="changeTab" data-tab="overview">{{localize "SDE.boat.tab.overview"}}</a>
    <a class="navigation-tab {{#if tab.occupants}}active{{/if}}" data-action="changeTab" data-tab="occupants">{{localize "SDE.boat.tab.passengers"}}</a>
    <a class="navigation-tab {{#if tab.inventory}}active{{/if}}" data-action="changeTab" data-tab="inventory">{{localize "SDE.boat.tab.cargo"}}</a>
    <a class="navigation-tab {{#if tab.weapons}}active{{/if}}" data-action="changeTab" data-tab="weapons">{{localize "SDE.boat.tab.weapons"}}</a>
    <a class="navigation-tab {{#if tab.description}}active{{/if}}" data-action="changeTab" data-tab="description">{{localize "SDE.boat.tab.description"}}</a>
  </nav>

  {{!-- Overview tab: vital stats down the left, detail sections on the right --}}
  <section class="sde-veh-tab-content {{#if tab.overview}}active{{/if}}" data-tab-content="overview">
    <div class="sde-veh-overview">

      {{!-- Left column: vital-stat boxes (like the Mount's HP / AC / LEVEL) --}}
      <div class="sde-veh-col-left">
        <div class="SD-box sde-veh-stat">
          <div class="header"><label>{{localize "SDE.vehicle.stat.hp"}}</label><span></span></div>
          <div class="content">
            <div class="sde-veh-hpline">
              <input type="number" name="system.hp.value" value="{{system.hp.value}}" />
              <span>/</span>
              <input type="number" name="system.hp.max" value="{{system.hp.max}}" />
            </div>
          </div>
        </div>
        <div class="sde-veh-statpair">
          <div class="SD-box sde-veh-stat">
            <div class="header"><label>{{localize "SDE.vehicle.stat.ac"}}</label><span></span></div>
            <div class="content">
              <input type="number" name="system.ac" value="{{system.ac}}" />
            </div>
          </div>
          <div class="SD-box sde-veh-stat">
            <div class="header"><label>{{localize "SDE.boat.move"}}</label><span></span></div>
            <div class="content">
              <input type="number" name="system.speed" value="{{system.speed}}" title="{{localize 'SDE.boat.moveTip'}}" />
              <div class="sde-veh-substat">{{localize "SDE.boat.combatSpeed" feet=derived.combatSpeedFeet}}</div>
            </div>
          </div>
        </div>
        <div class="SD-box sde-veh-stat">
          <div class="header"><label>{{localize "SDE.boat.cost"}}</label><span></span></div>
          <div class="content">
            <input type="number" name="system.cost" value="{{system.cost}}" />
            <div class="sde-veh-substat">{{localize "SDE.vehicle.gp"}}</div>
          </div>
        </div>
        <div class="SD-box sde-veh-stat">
          <div class="header"><label>{{localize "SDE.boat.tab.passengers"}}</label><span></span></div>
          <div class="content">
            <div class="sde-veh-statbig">{{occupantCount}} / {{derived.capacity}}</div>
            <div class="sde-veh-substat">{{localize "SDE.boat.capacityNote"}}</div>
          </div>
        </div>
        <p class="sde-veh-hint">{{localize "SDE.boat.overviewHint"}}</p>
      </div>

      {{!-- Right column: detail sections --}}
      <div class="sde-veh-col-right">
        <div class="SD-box">
          <div class="header"><label>{{localize "SDE.boat.command"}}</label><span></span></div>
          <div class="content">
            <div class="sde-veh-command">
              <div class="sde-veh-cmdrow">
                <span class="sde-veh-cmdlabel"><i class="fa-solid fa-anchor"></i> {{localize "SDE.vehicle.role.captain"}}</span>
                <span class="sde-veh-cmdval">{{#if captain}}{{captain.name}}{{else}}<em>{{localize "SDE.boat.unassigned"}}</em>{{/if}}</span>
                <button type="button" class="sde-veh-btn" data-action="rightShip" title="{{localize 'SDE.boat.rightShipTip'}}"><i class="fa-solid fa-ship"></i> {{localize "SDE.boat.rightShip"}} <span class="sde-veh-srctag">{{localize "SDE.boat.cs3Tag"}}</span></button>
              </div>
              <div class="sde-veh-cmdrow">
                <span class="sde-veh-cmdlabel"><i class="fa-solid fa-crosshairs"></i> {{localize "SDE.boat.gunners"}}</span>
                <span class="sde-veh-cmdval">{{#if gunners.length}}{{#each gunners}}{{name}}{{#unless @last}}, {{/unless}}{{/each}}{{else}}<em>{{localize "SDE.boat.none"}}</em>{{/if}}</span>
              </div>
              <p class="sde-veh-hint">{{{localize "SDE.boat.commandHint"}}}</p>
            </div>
          </div>
        </div>

        <div class="SD-box">
          <div class="header"><label>{{localize "SDE.boat.crewCargo"}}</label><span></span></div>
          <div class="content">
            <div class="sde-veh-grid">
              <div class="sde-veh-field"><label>{{localize "SDE.boat.cargoSlots"}}</label><input type="number" name="system.gearSlots.max" value="{{system.gearSlots.max}}" /></div>
              <div class="sde-veh-field"><label>{{localize "SDE.boat.crewRequired"}}</label><input type="number" name="system.crew.required" value="{{system.crew.required}}" /></div>
              <div class="sde-veh-field"><label>{{localize "SDE.boat.hiredCrew"}}</label><input type="number" name="system.crew.current" value="{{system.crew.current}}" title="{{localize 'SDE.boat.hiredCrewTip'}}" /></div>
              <div class="sde-veh-field"><label>{{localize "SDE.boat.crewAboard"}}</label><input type="text" value="{{derived.crewAboard}}" disabled title="{{localize 'SDE.boat.crewAboardTip'}}" /></div>
              <div class="sde-veh-field"><label>{{localize "SDE.boat.repairCost"}}</label><input type="text" value="{{localize 'SDE.boat.repairCostValue' cost=derived.repairCost}}" disabled /></div>
            </div>
            {{#if derived.crewShort}}<p class="sde-veh-warn">{{localize "SDE.boat.crewShort" aboard=derived.crewAboard required=system.crew.required}}</p>{{/if}}
          </div>
        </div>

        <div class="SD-box">
          <div class="header"><label>{{localize "SDE.vehicle.properties"}}</label><span></span></div>
          <div class="content">
            <div class="sde-veh-grid sde-veh-props">
              <label class="sde-veh-prop"><input type="checkbox" name="system.properties.crew" {{#if system.properties.crew}}checked{{/if}} /> {{localize "SDE.boat.prop.crew"}}</label>
              <label class="sde-veh-prop"><input type="checkbox" name="system.properties.fast" {{#if system.properties.fast}}checked{{/if}} /> {{localize "SDE.boat.prop.fast"}}</label>
              <label class="sde-veh-prop"><input type="checkbox" name="system.properties.rowGalley" {{#if system.properties.rowGalley}}checked{{/if}} /> {{localize "SDE.boat.prop.rowGalley"}}</label>
              <label class="sde-veh-prop"><input type="checkbox" name="system.properties.unseaworthy" {{#if system.properties.unseaworthy}}checked{{/if}} /> {{localize "SDE.boat.prop.unseaworthy"}}</label>
              <label class="sde-veh-prop"><input type="checkbox" name="system.properties.weapons" {{#if system.properties.weapons}}checked{{/if}} /> {{localize "SDE.boat.prop.weapons"}}</label>
              <div class="sde-veh-field grow"><label>{{localize "SDE.vehicle.other"}}</label><input type="text" name="system.propertiesNote" value="{{system.propertiesNote}}" /></div>
            </div>
          </div>
        </div>

        <div class="SD-box">
          <div class="header"><label>{{localize "SDE.boat.sinking"}}</label><span></span></div>
          <div class="content">
            <div class="sde-veh-actions">
              {{#if system.sinking.active}}
                <div class="sde-veh-field"><label>{{localize "SDE.boat.roundsLeft"}}</label><input type="text" value="{{system.sinking.roundsRemaining}}" disabled /></div>
                <button type="button" class="sde-veh-btn" data-action="advanceSinking"><i class="fa-solid fa-forward-step"></i> {{localize "SDE.boat.nextRound"}}</button>
                <button type="button" class="sde-veh-btn" data-action="stopSinking"><i class="fa-solid fa-life-ring"></i> {{localize "SDE.boat.stopSinking"}}</button>
              {{else}}
                <button type="button" class="sde-veh-btn" data-action="beginSinking"><i class="fa-solid fa-water"></i> {{localize "SDE.boat.beginSinking"}}</button>
              {{/if}}
              <button type="button" class="sde-veh-btn" data-action="sinkChance"><i class="fa-solid fa-dice-one"></i> {{localize "SDE.boat.chat.sinkChance"}}</button>
            </div>
          </div>
        </div>

        <details class="sde-veh-details">
          <summary>{{localize "SDE.boat.weather.title"}}</summary>
          <ul class="sde-veh-reflist">
            <li><strong>{{localize "SDE.boat.weather.driving"}}</strong> {{localize "SDE.boat.weather.drivingText"}}</li>
            <li><strong>{{localize "SDE.boat.weather.gusty"}}</strong> {{localize "SDE.boat.weather.gustyText"}}</li>
            <li><strong>{{localize "SDE.boat.weather.noWind"}}</strong> {{localize "SDE.boat.weather.noWindText"}}</li>
            <li><strong>{{localize "SDE.boat.weather.tempest"}}</strong> {{localize "SDE.boat.weather.tempestText"}}</li>
          </ul>
        </details>
      </div>

    </div>
  </section>

  {{!-- Shared Passengers / Cargo / Description tabs --}}
  {{> sdeVehicleBody}}

</div>

<div class="sde-vehicle-sheet-body flexcol">

  {{!-- Header (Shadowdark system chrome) --}}
  <header class="SD-header flex0">
    <img class="portrait" src="{{document.img}}" data-edit="img" data-tooltip="{{document.name}}" height="110" width="110" />
    <div class="shadowdark-logo"><span>ShadowDark</span></div>
    <div class="SD-title">
      <input type="text" name="name" value="{{document.name}}" placeholder="Vessel name" />
    </div>
  </header>

  {{!-- Tab nav (Shadowdark system chrome) --}}
  <nav class="SD-nav flex0" data-group="primary">
    <a class="navigation-tab {{#if tab.overview}}active{{/if}}" data-action="changeTab" data-tab="overview">Overview</a>
    <a class="navigation-tab {{#if tab.occupants}}active{{/if}}" data-action="changeTab" data-tab="occupants">Passengers</a>
    <a class="navigation-tab {{#if tab.inventory}}active{{/if}}" data-action="changeTab" data-tab="inventory">Cargo</a>
    <a class="navigation-tab {{#if tab.weapons}}active{{/if}}" data-action="changeTab" data-tab="weapons">Weapons</a>
    <a class="navigation-tab {{#if tab.description}}active{{/if}}" data-action="changeTab" data-tab="description">Description</a>
  </nav>

  {{!-- Overview tab: vital stats down the left, detail sections on the right --}}
  <section class="sde-veh-tab-content {{#if tab.overview}}active{{/if}}" data-tab-content="overview">
    <div class="sde-veh-overview">

      {{!-- Left column: vital-stat boxes (like the Mount's HP / AC / LEVEL) --}}
      <div class="sde-veh-col-left">
        <div class="SD-box sde-veh-stat">
          <div class="header"><label>HP</label><span></span></div>
          <div class="content">
            <div class="sde-veh-hpline">
              <input type="number" name="system.hp.value" value="{{system.hp.value}}" />
              <span>/</span>
              <input type="number" name="system.hp.max" value="{{system.hp.max}}" />
            </div>
          </div>
        </div>
        <div class="sde-veh-statpair">
          <div class="SD-box sde-veh-stat">
            <div class="header"><label>AC</label><span></span></div>
            <div class="content">
              <input type="number" name="system.ac" value="{{system.ac}}" />
            </div>
          </div>
          <div class="SD-box sde-veh-stat">
            <div class="header"><label>Move</label><span></span></div>
            <div class="content">
              <input type="number" name="system.speed" value="{{system.speed}}" title="hexes per 8-hour day" />
              <div class="sde-veh-substat">{{derived.combatSpeedFeet}} ft</div>
            </div>
          </div>
        </div>
        <div class="SD-box sde-veh-stat">
          <div class="header"><label>Cost</label><span></span></div>
          <div class="content">
            <input type="number" name="system.cost" value="{{system.cost}}" />
            <div class="sde-veh-substat">gp</div>
          </div>
        </div>
        <div class="SD-box sde-veh-stat">
          <div class="header"><label>Passengers</label><span></span></div>
          <div class="content">
            <div class="sde-veh-statbig">{{occupantCount}} / {{derived.capacity}}</div>
            <div class="sde-veh-substat">capacity = max HP</div>
          </div>
        </div>
        <p class="sde-veh-hint">Carries passengers equal to HP (they don't use cargo slots). Repairs: 1 week, 1 gp per HP. Begins to sink at 0 HP or capsize.</p>
      </div>

      {{!-- Right column: detail sections --}}
      <div class="sde-veh-col-right">
        <div class="SD-box">
          <div class="header"><label>Command</label><span></span></div>
          <div class="content">
            <div class="sde-veh-command">
              <div class="sde-veh-cmdrow">
                <span class="sde-veh-cmdlabel"><i class="fa-solid fa-anchor"></i> Captain</span>
                <span class="sde-veh-cmdval">{{#if captain}}{{captain.name}}{{else}}<em>unassigned</em>{{/if}}</span>
                <button type="button" class="sde-veh-btn" data-action="rightShip" title="Optional Cursed Scroll 3 rule: right a capsized ship with a DC 20 STR check (the Captain rolls). Western Reaches boats sink instead of capsizing."><i class="fa-solid fa-ship"></i> Right the ship <span class="sde-veh-srctag">CS3</span></button>
              </div>
              <div class="sde-veh-cmdrow">
                <span class="sde-veh-cmdlabel"><i class="fa-solid fa-crosshairs"></i> Gunners</span>
                <span class="sde-veh-cmdval">{{#if gunners.length}}{{#each gunners}}{{name}}{{#unless @last}}, {{/unless}}{{/each}}{{else}}<em>none</em>{{/if}}</span>
              </div>
              <p class="sde-veh-hint">Assign roles on the Passengers tab. A Gunner is pre-selected to operate the siege weapons. <em>Right the ship</em> is an optional Cursed Scroll 3 rule (Western Reaches boats sink instead of capsizing) — the Captain makes a DC 20 STR check, Sea Wolves with advantage.</p>
            </div>
          </div>
        </div>

        <div class="SD-box">
          <div class="header"><label>Crew &amp; cargo</label><span></span></div>
          <div class="content">
            <div class="sde-veh-grid">
              <div class="sde-veh-field"><label>Cargo slots</label><input type="number" name="system.gearSlots.max" value="{{system.gearSlots.max}}" /></div>
              <div class="sde-veh-field"><label>Crew req.</label><input type="number" name="system.crew.required" value="{{system.crew.required}}" /></div>
              <div class="sde-veh-field"><label>Hired crew</label><input type="number" name="system.crew.current" value="{{system.crew.current}}" title="Abstract NPC crew not added as passengers" /></div>
              <div class="sde-veh-field"><label>Crew aboard</label><input type="text" value="{{derived.crewAboard}}" disabled title="Hired crew + occupants assigned Captain / Gunner / Crew" /></div>
              <div class="sde-veh-field"><label>Repair cost</label><input type="text" value="{{derived.repairCost}} gp" disabled /></div>
            </div>
            {{#if derived.crewShort}}<p class="sde-veh-warn">Not enough crew aboard ({{derived.crewAboard}}/{{system.crew.required}}) to move this vessel.</p>{{/if}}
          </div>
        </div>

        <div class="SD-box">
          <div class="header"><label>Properties</label><span></span></div>
          <div class="content">
            <div class="sde-veh-grid sde-veh-props">
              <label class="sde-veh-prop"><input type="checkbox" name="system.properties.crew" {{#if system.properties.crew}}checked{{/if}} /> Crew (4+ trained)</label>
              <label class="sde-veh-prop"><input type="checkbox" name="system.properties.fast" {{#if system.properties.fast}}checked{{/if}} /> Fast (2× near)</label>
              <label class="sde-veh-prop"><input type="checkbox" name="system.properties.rowGalley" {{#if system.properties.rowGalley}}checked{{/if}} /> Row Galley</label>
              <label class="sde-veh-prop"><input type="checkbox" name="system.properties.unseaworthy" {{#if system.properties.unseaworthy}}checked{{/if}} /> Unseaworthy (1:6)</label>
              <label class="sde-veh-prop"><input type="checkbox" name="system.properties.weapons" {{#if system.properties.weapons}}checked{{/if}} /> Weapons</label>
              <div class="sde-veh-field grow"><label>Other</label><input type="text" name="system.propertiesNote" value="{{system.propertiesNote}}" /></div>
            </div>
          </div>
        </div>

        <div class="SD-box">
          <div class="header"><label>Sinking</label><span></span></div>
          <div class="content">
            <div class="sde-veh-actions">
              {{#if system.sinking.active}}
                <div class="sde-veh-field"><label>Rounds left</label><input type="text" value="{{system.sinking.roundsRemaining}}" disabled /></div>
                <button type="button" class="sde-veh-btn" data-action="advanceSinking"><i class="fa-solid fa-forward-step"></i> Next round</button>
                <button type="button" class="sde-veh-btn" data-action="stopSinking"><i class="fa-solid fa-life-ring"></i> Stop sinking</button>
              {{else}}
                <button type="button" class="sde-veh-btn" data-action="beginSinking"><i class="fa-solid fa-water"></i> Begin sinking (1d4)</button>
              {{/if}}
              <button type="button" class="sde-veh-btn" data-action="sinkChance"><i class="fa-solid fa-dice-one"></i> Sink chance (1:6)</button>
            </div>
          </div>
        </div>

        <details class="sde-veh-details">
          <summary>Weather &amp; wind (reference)</summary>
          <ul class="sde-veh-reflist">
            <li><strong>Driving:</strong> halve speed, navigation harder.</li>
            <li><strong>Gusty:</strong> +1 hex of travel.</li>
            <li><strong>No wind:</strong> arduous terrain (1 hex/day) unless rowed (Row Galley).</li>
            <li><strong>Tempest:</strong> 1d4 days; blown 1d4 hexes random/day; 1:6 daily sink.</li>
          </ul>
        </details>
      </div>

    </div>
  </section>

  {{!-- Shared Passengers / Cargo / Description tabs --}}
  {{> sdeVehicleBody}}

</div>

<div class="sde-hxt">
  <header class="sde-hxt-head">
    <div class="sde-hxt-title">
      <strong>{{sceneName}}</strong>
      {{#if sampled}}<span class="sde-hxt-stat">{{localize "SDE.hexMap.stat.numbered" numbered=numberedCount cells=cellCount}} · {{localize "SDE.hexMap.stat.tagged" tagged=summary.tagged gm=summary.gm}}{{#if summary.auto}}{{localize "SDE.hexMap.stat.auto" auto=summary.auto}}{{/if}}) · {{localize "SDE.hexMap.stat.toGo" n=summary.untagged}}</span>{{/if}}
    </div>
    <div class="sde-hxt-actions">
      {{#unless sampled}}
      <button type="button" data-action="hxtSample" class="{{#if primarySample}}sde-import-primary{{else}}sde-import-secondary{{/if}}" title="{{localize 'SDE.hexMap.tip.read'}}"><i class="fas fa-crop-simple"></i> {{localize "SDE.hexMap.btn.read"}}</button>
      {{/unless}}
      {{!-- Legend and Classify read the map themselves when they have to, so a
            reload never hides them: they are offered whenever the scene is
            numbered. Only the controls that work ON the pictures wait. --}}
      {{#if origin}}
      <button type="button" data-action="hxtLegend" class="{{#if primaryLegend}}sde-import-primary{{else}}sde-import-secondary{{/if}}" title="{{localize 'SDE.hexMap.tip.legend'}}"><i class="fas fa-list-ul"></i> {{localize "SDE.hexMap.btn.legend"}}</button>
      {{#if canClassify}}
      <button type="button" data-action="hxtClassify" class="sde-import-secondary" title="{{localize 'SDE.hexMap.tip.classify'}}"><i class="fas fa-wand-magic-sparkles"></i> {{localize "SDE.hexMap.btn.classify"}}</button>
      {{/if}}
      {{/if}}
      {{#if sampled}}{{#if origin}}{{#if canSheet}}
      <label title="{{localize 'SDE.hexMap.tip.show'}}">{{localize "SDE.hexMap.label.show"}} <select data-hxt-mode>{{#each modes as |m|}}<option value="{{m.value}}" {{#if m.selected}}selected{{/if}}>{{m.label}}</option>{{/each}}</select></label>
      <button type="button" data-action="hxtNextSheet" class="sde-import-secondary"><i class="fas fa-forward"></i> {{localize "SDE.hexMap.btn.nextSheet"}}</button>
      {{/if}}{{/if}}{{/if}}
      {{!-- These read the scene's stored tags, so they work whether or not it is sampled. --}}
      {{#if origin}}
      {{#if hasKey}}
      <label title="{{localize 'SDE.hexMap.tip.hexKey'}}">{{localize "SDE.hexMap.label.hexKey"}} <select data-hxt-entry><option value="">{{localize "SDE.hexMap.label.none"}}</option>{{#each entries as |e|}}<option value="{{e.uuid}}" {{#if e.selected}}selected{{/if}}>{{e.name}}</option>{{/each}}</select></label>
      <button type="button" data-action="hxtPinKeyed" class="sde-import-secondary" title="{{localize 'SDE.hexMap.tip.pinKeyed'}}"><i class="fas fa-map-pin"></i> {{localize "SDE.hexMap.btn.pinKeyed"}}</button>
      {{/if}}
      {{#if hasTags}}
      <button type="button" data-action="hxtShowTags" class="sde-import-secondary" title="{{localize 'SDE.hexMap.tip.showTags'}}"><i class="fas fa-eye"></i> {{#if overlayShown}}{{localize "SDE.hexMap.btn.hideTags"}}{{else}}{{localize "SDE.hexMap.btn.showTags"}}{{/if}}</button>
      <button type="button" data-action="hxtBrush" class="sde-import-secondary" title="{{localize 'SDE.hexMap.tip.brush'}}"><i class="fas fa-paintbrush"></i> {{localize "SDE.hexMap.btn.brush"}}</button>
      <button type="button" data-action="hxtBuildDataset" class="{{#if primaryBuild}}sde-import-primary{{else}}sde-import-secondary{{/if}}">{{#if viaExtras}}<i class="fas fa-paper-plane"></i> {{localize "SDE.hexMap.btn.sendExtras"}}{{else}}<i class="fas fa-download"></i> {{localize "SDE.hexMap.btn.download"}}{{/if}}</button>
      {{/if}}
      {{/if}}
      {{#if showMore}}
      <button type="button" data-action="hxtMore" class="sde-import-secondary sde-hxt-more-btn" aria-expanded="{{moreOpen}}" title="{{localize 'SDE.hexMap.tip.more'}}">{{localize "SDE.hexMap.btn.more"}}</button>
      {{/if}}
      <span class="sde-hxt-stat" data-hxt-progress>{{progress}}</span>
    </div>
    {{#if showMore}}
    <div class="sde-hxt-more-panel" {{#unless moreOpen}}hidden{{/unless}}>
        <div class="sde-hxt-more-row">
        {{#if sampled}}
        <button type="button" data-action="hxtSample" class="sde-import-secondary" title="{{localize 'SDE.hexMap.tip.readAgain'}}"><i class="fas fa-crop-simple"></i> {{localize "SDE.hexMap.btn.readAgain"}}</button>
        {{/if}}
        <button type="button" data-action="hxtLearnFrom" class="sde-import-secondary" title="{{localize 'SDE.hexMap.tip.learnFrom'}}"><i class="fas fa-graduation-cap"></i> {{localize "SDE.hexMap.btn.learnFrom"}}</button>
        <button type="button" data-action="hxtImport" class="sde-import-secondary" title="{{localize 'SDE.hexMap.tip.import'}}"><i class="fas fa-file-import"></i> {{localize "SDE.hexMap.btn.import"}}</button>
        <button type="button" data-action="hxtExport" class="sde-import-secondary" title="{{localize 'SDE.hexMap.tip.export'}}"><i class="fas fa-file-export"></i> {{localize "SDE.hexMap.btn.export"}}</button>
        <button type="button" data-action="hxtArt" class="sde-import-secondary" title="{{localize 'SDE.hexMap.tip.art'}}"><i class="fas fa-palette"></i> {{localize "SDE.hexMap.btn.art"}}{{#if artCount}} ({{artCount}}){{/if}}</button>
        {{#if origin}}
        <button type="button" data-action="hxtReference" class="sde-import-secondary" title="{{localize 'SDE.hexMap.tip.reference'}}"><i class="fas fa-layer-group"></i> {{localize "SDE.hexMap.btn.reference"}}</button>
        <button type="button" data-action="hxtClearTags" class="sde-import-secondary" title="{{localize 'SDE.hexMap.tip.clear'}}"><i class="fas fa-eraser"></i> {{localize "SDE.hexMap.btn.clear"}}</button>
        {{/if}}
        </div>
        {{#if origin}}
        <div class="sde-hxt-more-row">
        <span class="sde-hxt-muted"><i class="fas fa-anchor"></i> {{localize "SDE.hexMap.label.hex"}} <strong>{{originText}}</strong></span>
        <label>{{localize "SDE.hexMap.label.mapSize"}} <input type="number" data-hxt-cols value="{{boundsCols}}" min="1" max="99" placeholder="{{localize 'SDE.hexMap.label.cols'}}" class="sde-hxt-small"></label>
        <label>× <input type="number" data-hxt-rows value="{{boundsRows}}" min="1" max="99" placeholder="{{localize 'SDE.hexMap.label.rows'}}" class="sde-hxt-small"></label>
        <label title="{{localize 'SDE.hexMap.tip.skipTop'}}"><input type="checkbox" data-hxt-skip-top {{#if skipTopRow}}checked{{/if}}> {{localize "SDE.hexMap.label.skipTop"}}</label>
        {{#if canClassify}}
        <label title="{{localize 'SDE.hexMap.tip.sensitivity'}}">{{localize "SDE.hexMap.label.sensitivity"}} <input type="number" data-hxt-sensitivity value="{{sensitivity}}" min="0.3" max="3" step="0.1" class="sde-hxt-small"></label>
        {{/if}}
        <button type="button" data-action="hxtSetBounds" class="sde-import-secondary sde-hxt-inline">{{localize "SDE.hexMap.btn.apply"}}</button>
        </div>
      <p class="sde-hxt-muted">{{localize "SDE.hexMap.note.skipped"}}</p>
      {{/if}}
    </div>
    {{/if}}
  </header>

  {{#if error}}<p class="sde-hxt-error"><i class="fas fa-triangle-exclamation"></i> {{error}}</p>{{/if}}

  {{#unless sampled}}
  {{#if origin}}
  <p class="sde-hxt-note">{{{localize "SDE.hexMap.note.aligned"}}}</p>
  {{else}}
  <p class="sde-hxt-note">{{{localize "SDE.hexMap.note.align"}}}</p>
  {{/if}}
  {{/unless}}

  {{#if baseline}}
  <p class="sde-hxt-note sde-hxt-direction">
    <i class="fas fa-flag-checkered"></i> {{{localize "SDE.hexMap.note.baseline" checked=baseline.checked right=baseline.right accuracy=baseline.accuracy}}}
    {{#if baseline.worst}}{{localize "SDE.hexMap.note.baselineWorst"}} {{#each baseline.worst as |w|}}{{#unless @first}}, {{/unless}}{{lookup w 1}}× {{lookup w 0}}{{/each}}.{{/if}}
  </p>
  {{/if}}

  {{#if report}}
  {{#if legendLog}}
  <p class="sde-hxt-note sde-hxt-direction">
    <i class="fas fa-clipboard-list"></i> {{{localize "SDE.hexMap.note.legendLog" cards=legendLog.cards hexes=legendLog.hexes named=legendLog.named}}}{{#if legendLog.skipped}}{{localize "SDE.hexMap.note.legendLogSkipped" n=legendLog.skipped}}{{/if}}{{#if legendLog.opened}}{{localize "SDE.hexMap.note.legendLogOpened" n=legendLog.opened}}{{/if}}. {{localize "SDE.hexMap.note.legendLogKept"}}
    {{#if legendLog.suspect}}
    <br>{{{localize "SDE.hexMap.note.suspect" name=legendLog.suspect.name wrong=legendLog.suspect.wrong core=legendLog.suspect.core rate=legendLog.suspect.rate size=legendLog.suspect.size}}}
    {{/if}}
  </p>
  {{/if}}
  <p class="sde-hxt-note sde-hxt-direction">
    <i class="fas fa-chart-simple"></i> {{{localize "SDE.hexMap.note.corrections" judged=report.judged wrong=report.wrong}}}
    {{#if report.retag}}
    {{{localize "SDE.hexMap.note.retag" wrong=report.wrong}}}
    {{/if}}
    {{#if report.wrong}}
    <br>{{{localize "SDE.hexMap.note.margin" margin=reviewMargin ringed=reviewCount caught=report.caught}}}
    {{/if}}
    {{#if report.suggested}}
    {{{localize "SDE.hexMap.note.suggested" suggested=report.suggested count=report.suggestedCount ringed=reviewCount}}}
    <button type="button" data-action="hxtUseMargin" data-margin="{{report.suggested}}" class="sde-import-secondary sde-hxt-inline">{{localize "SDE.hexMap.btn.ringAt" suggested=report.suggested}}</button>
    {{/if}}
  </p>
  {{/if}}

  {{#if origin}}{{#if sampled}}{{#unless hasLegend}}
  {{#if done}}
  <p class="sde-hxt-note sde-hxt-direction">
    <i class="fas fa-circle-check"></i> {{{localize "SDE.hexMap.note.done" gm=summary.gm auto=summary.auto}}} {{#if viaExtras}}{{{localize "SDE.hexMap.note.doneReady" action=(localize "SDE.hexMap.btn.sendExtras")}}}{{else}}{{{localize "SDE.hexMap.note.doneReady" action=(localize "SDE.hexMap.btn.download")}}}{{/if}}
    {{{localize "SDE.hexMap.note.queueLead"}}}{{#if sheetExpected}}{{localize "SDE.hexMap.note.queueExpect" n=sheetExpected}}{{/if}}. {{{localize "SDE.hexMap.note.queueHow"}}}
    {{#if noCrawl}}{{{localize "SDE.hexMap.note.noCrawl"}}}{{/if}}
  </p>
  {{else if summary.tagged}}
  <p class="sde-hxt-note sde-hxt-direction">{{{localize "SDE.hexMap.note.some" untagged=summary.untagged gm=summary.gm sheet=sheet.length}}}</p>
  {{else}}
  <p class="sde-hxt-note sde-hxt-direction">{{{localize "SDE.hexMap.note.none" sheet=sheet.length}}}</p>
  {{/if}}
  {{/unless}}{{/if}}{{/if}}

  {{#if needsOrigin}}
  <p class="sde-hxt-note">
    <i class="fas fa-anchor"></i> {{{localize "SDE.hexMap.note.needsOrigin"}}}
    {{localize "SDE.hexMap.label.lowered"}} <select data-hxt-shifted><option value="odd" selected>{{localize "SDE.hexMap.label.loweredOdd"}}</option><option value="even">{{localize "SDE.hexMap.label.loweredEven"}}</option></select>
  </p>
  {{/if}}

  {{#if hasLegend}}
  <p class="sde-hxt-note sde-hxt-direction">
    <i class="fas fa-list-ul"></i> {{{localize "SDE.hexMap.legend.howTo"}}}
    <br>{{{localize "SDE.hexMap.legend.skipSplit"}}}
  </p>
  <div class="sde-hxt-sheet sde-hxt-legend">
    {{#each legend as |g|}}
    {{#if g.expand}}
    <div class="sde-hxt-cell sde-hxt-opened">
      <span class="sde-hxt-label">{{localize "SDE.hexMap.legend.opened" size=g.size picks=g.picks.length}}</span>
      <div class="sde-hxt-picks">
        {{#each g.picks as |p|}}
        <div class="sde-hxt-pick">
          <img src="{{p.thumb}}" alt="" width="72" height="72">
          <span class="sde-hxt-label">{{p.num}}</span>
          <select data-hxt-pick data-idx="{{g.idx}}" data-num="{{p.num}}">
            <option value="">{{localize "SDE.hexMap.label.skip"}}</option>
            {{#each p.terrainOptions as |o|}}<option value="{{o.value}}" {{#if o.selected}}selected{{/if}}>{{o.label}}</option>{{/each}}
          </select>
          <input type="text" data-hxt-pick-other data-num="{{p.num}}" value="{{p.other}}" placeholder="{{localize 'SDE.hexMap.label.otherTerrain'}}" aria-label="{{localize 'SDE.hexMap.label.otherTerrainAria'}}" {{#unless p.other}}hidden{{/unless}}>
        </div>
        {{/each}}
      </div>
    </div>
    {{else}}
    <div class="sde-hxt-cell">
      <div class="sde-hxt-thumbs">{{#each g.thumbs as |t|}}<img src="{{t}}" alt="" width="72" height="72">{{/each}}</div>
      <div class="sde-hxt-fields">
        <span class="sde-hxt-label">{{localize "SDE.hexMap.legend.cardSize" size=g.size}}{{#if g.split}} <span class="sde-hxt-muted">{{localize "SDE.hexMap.legend.fromSplit"}}</span>{{/if}}</span>
        <select data-hxt-legend data-idx="{{g.idx}}">
          <option value="">{{localize "SDE.hexMap.label.skip"}}</option>
          {{#each g.terrainOptions as |o|}}<option value="{{o.value}}" {{#if o.selected}}selected{{/if}}>{{o.label}}</option>{{/each}}
        </select>
        <input type="text" data-hxt-legend-other data-idx="{{g.idx}}" value="{{g.terrainOther}}" placeholder="{{localize 'SDE.hexMap.label.otherTerrain'}}" aria-label="{{localize 'SDE.hexMap.label.otherTerrainAria'}}" {{#unless g.terrainOther}}hidden{{/unless}}>
      </div>
    </div>
    {{/if}}
    {{/each}}
  </div>
  <footer class="sde-hxt-foot">
    <button type="button" data-action="hxtApplyLegend" class="sde-import-primary"><i class="fas fa-check"></i> {{localize "SDE.hexMap.btn.applyLegend"}}</button>
    <button type="button" data-action="hxtCancelLegend" class="sde-import-secondary">{{localize "SDE.hexMap.btn.cancel"}}</button>
  </footer>
  {{else if hasSheet}}
  <div class="sde-hxt-sheet">
    {{#each sheet as |c|}}
    <div class="sde-hxt-cell{{#if c.keyed}} keyed{{/if}}">
      <img src="{{c.thumb}}" alt="" width="96" height="96">
      {{#if c.align}}
      <div class="sde-hxt-fields">
        <span class="sde-hxt-muted">{{localize "SDE.hexMap.label.grid" i=c.i j=c.j}}</span>
        <input type="text" data-hxt-number data-i="{{c.i}}" data-j="{{c.j}}" placeholder="{{localize 'SDE.hexMap.label.number'}}" maxlength="4" class="sde-hxt-num">
        <button type="button" data-action="hxtSetNumber" data-i="{{c.i}}" data-j="{{c.j}}" class="sde-import-secondary sde-hxt-inline">{{localize "SDE.hexMap.btn.set"}}</button>
      </div>
      {{else}}
      <div class="sde-hxt-fields">
        <span class="sde-hxt-label">{{c.label}}{{#if c.keyed}} <i class="fas fa-star" title="{{localize 'SDE.hexMap.tip.keyedHex'}}"></i>{{/if}}{{#if c.source}} <span class="sde-hxt-muted">{{c.source}}{{#if c.margin}} {{c.margin}}{{/if}}{{#if c.review}} <i class="fas fa-circle-question" title="{{localize 'SDE.hexMap.tip.flagged'}}"></i>{{/if}}</span>{{/if}}</span>
        <select data-hxt-terrain data-num="{{c.num}}">
          <option value="">{{localize "SDE.hexMap.label.untagged"}}</option>
          {{#each c.terrainOptions as |o|}}<option value="{{o.value}}" {{#if o.selected}}selected{{/if}}>{{o.label}}</option>{{/each}}
        </select>
        <input type="text" data-hxt-terrain-other data-num="{{c.num}}" value="{{c.terrainOther}}" placeholder="{{localize 'SDE.hexMap.label.otherTerrain'}}" aria-label="{{localize 'SDE.hexMap.label.otherTerrainAria'}}" {{#unless c.terrainOther}}hidden{{/unless}}>
        <span class="sde-hxt-overlays">
          <label><input type="checkbox" data-hxt-overlay data-num="{{c.num}}" value="river" {{#if c.overlays.river}}checked{{/if}}> {{localize "SDE.hexMap.overlay.river"}}</label>
          <label><input type="checkbox" data-hxt-overlay data-num="{{c.num}}" value="path" {{#if c.overlays.path}}checked{{/if}}> {{localize "SDE.hexMap.overlay.path"}}</label>
          <label title="{{localize 'SDE.hexMap.tip.coast'}}"><input type="checkbox" data-hxt-overlay data-num="{{c.num}}" value="coast" {{#if c.overlays.coast}}checked{{/if}}> {{localize "SDE.hexMap.overlay.coast"}}</label>
        </span>
      </div>
      {{/if}}
    </div>
    {{/each}}
  </div>

  {{#if hasSheet}}{{#unless needsOrigin}}
  <footer class="sde-hxt-foot">
    <span class="sde-hxt-muted">{{localize "SDE.hexMap.sheet.leaveAlone"}}</span>
    <button type="button" data-action="hxtApplySheet" class="sde-import-primary" title="{{localize 'SDE.hexMap.tip.confirm'}}"><i class="fas fa-check"></i> {{localize "SDE.hexMap.btn.confirm" n=sheet.length}}</button>
    <button type="button" data-action="hxtNextSheet" class="sde-import-secondary" title="{{localize 'SDE.hexMap.tip.others' n=sheet.length}}">{{localize "SDE.hexMap.btn.others"}}</button>
  </footer>
  {{/unless}}{{/if}}
  {{/if}}
</div>

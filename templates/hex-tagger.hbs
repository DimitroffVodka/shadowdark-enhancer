<div class="sde-hxt">
  <header class="sde-hxt-head">
    <div class="sde-hxt-title">
      <strong>{{sceneName}}</strong>
      {{#if sampled}}<span class="sde-hxt-stat">{{numberedCount}} numbered of {{cellCount}} cells · {{summary.tagged}} tagged ({{summary.gm}} by hand{{#if summary.auto}}, {{summary.auto}} auto{{/if}}) · {{summary.untagged}} to go</span>{{/if}}
    </div>
    <div class="sde-hxt-actions">
      {{#unless sampled}}
      <button type="button" data-action="hxtSample" class="{{#if primarySample}}sde-import-primary{{else}}sde-import-secondary{{/if}}" title="Read every hex of this scene's image in your browser, so the Legend and Classify have a picture of each one. Nothing is uploaded, and no terrain is decided."><i class="fas fa-crop-simple"></i> Read the map</button>
      {{/unless}}
      {{!-- Legend and Classify read the map themselves when they have to, so a
            reload never hides them: they are offered whenever the scene is
            numbered. Only the controls that work ON the pictures wait. --}}
      {{#if origin}}
      <button type="button" data-action="hxtLegend" class="{{#if primaryLegend}}sde-import-primary{{else}}sde-import-secondary{{/if}}" title="Sort every hex picture into groups of look-alikes and show one card per group. Reads the map first if it needs to."><i class="fas fa-list-ul"></i> Legend</button>
      {{#if canClassify}}
      <button type="button" data-action="hxtClassify" class="sde-import-secondary" title="Tag every hex you have NOT tagged yourself by whichever of your own hand-tagged hexes it looks most like. Reads the map first if it needs to. Unsure hexes go to the Review queue."><i class="fas fa-wand-magic-sparkles"></i> Classify</button>
      {{/if}}
      {{/if}}
      {{#if sampled}}{{#if origin}}
      <label>Sheet <select data-hxt-mode>{{#each modes as |m|}}<option value="{{m.value}}" {{#if m.selected}}selected{{/if}}>{{m.label}}</option>{{/each}}</select></label>
      <button type="button" data-action="hxtNextSheet" class="sde-import-secondary"><i class="fas fa-forward"></i> Next sheet</button>
      {{#if canClassify}}
      <label title="Higher values lower the overlay thresholds: raise it if paths and rivers are missed, lower it if plain cells pick up overlays.">Sensitivity <input type="number" data-hxt-sensitivity value="{{sensitivity}}" min="0.3" max="3" step="0.1" class="sde-hxt-small"></label>
      {{/if}}
      {{/if}}{{/if}}
      {{!-- These read the scene's stored tags, so they work whether or not it is sampled. --}}
      {{#if origin}}
      <label>Crawl <select data-hxt-entry><option value="">(none)</option>{{#each entries as |e|}}<option value="{{e.uuid}}" {{#if e.selected}}selected{{/if}}>{{e.name}}</option>{{/each}}</select></label>
      {{#if entries.length}}
      <button type="button" data-action="hxtPinKeyed" class="sde-import-secondary" title="One map note per keyed hex of the chosen crawl on this scene, each opening its journal page"><i class="fas fa-map-pin"></i> Pin keyed hexes</button>
      {{/if}}
      <button type="button" data-action="hxtShowTags" class="sde-import-secondary" title="Draw every tag on the map itself: a colour per terrain, dots for river, path and coast, an amber ring on the unsure automatic cells. Click a hex there to change it. Press again to hide."><i class="fas fa-eye"></i> {{#if overlayShown}}Hide tags{{else}}Show tags{{/if}}</button>
      <button type="button" data-action="hxtBrush" class="sde-import-secondary" title="Pick a terrain once, then click or drag across the hexes that have it wrong. A whole stroke is one change, and Undo puts it back."><i class="fas fa-paintbrush"></i> Brush</button>
      <button type="button" data-action="hxtBuildDataset" class="{{#if primaryBuild}}sde-import-primary{{else}}sde-import-secondary{{/if}}">{{#if viaExtras}}<i class="fas fa-paper-plane"></i> Send to Extras{{else}}<i class="fas fa-download"></i> Download dataset{{/if}}</button>
      {{/if}}
      {{#if showMore}}
      <button type="button" data-action="hxtMore" class="sde-import-secondary sde-hxt-more-btn" aria-expanded="{{moreOpen}}" title="Map size, re-sample, import, export, the reference tile and Clear">More</button>
      {{/if}}
      <span class="sde-hxt-stat" data-hxt-progress>{{progress}}</span>
    </div>
    {{#if showMore}}
    <div class="sde-hxt-more-panel" {{#unless moreOpen}}hidden{{/unless}}>
        <div class="sde-hxt-more-row">
        {{#if sampled}}
        <button type="button" data-action="hxtSample" class="sde-import-secondary" title="Read the pictures from the scene image again; every tag is kept"><i class="fas fa-crop-simple"></i> Read the map again</button>
        {{/if}}
        <button type="button" data-action="hxtLearnFrom" class="sde-import-secondary" title="Bring in every hex you tagged by hand on another go at this same print, as examples for Classify. Your tags here are left alone."><i class="fas fa-graduation-cap"></i> Start from a map you have done</button>
        <button type="button" data-action="hxtImport" class="sde-import-secondary" title="Import tags from a CSV (hex_id, tags) or a JSON exported here"><i class="fas fa-file-import"></i> Import</button>
        <button type="button" data-action="hxtExport" class="sde-import-secondary" title="Download this scene's tags as JSON"><i class="fas fa-file-export"></i> Export</button>
        {{#if origin}}
        <button type="button" data-action="hxtReference" class="sde-import-secondary" title="Put this map image on another hex scene as a hidden, locked tile for tracing rivers and roads"><i class="fas fa-layer-group"></i> Reference tile</button>
        <button type="button" data-action="hxtClearTags" class="sde-import-secondary" title="Remove every tag and the anchor from this scene"><i class="fas fa-eraser"></i> Clear</button>
        {{/if}}
        </div>
        {{#if origin}}
        <div class="sde-hxt-more-row">
        <span class="sde-hxt-muted"><i class="fas fa-anchor"></i> hex <strong>{{originText}}</strong></span>
        <label>Map size <input type="number" data-hxt-cols value="{{boundsCols}}" min="1" max="99" placeholder="cols" class="sde-hxt-small"></label>
        <label>× <input type="number" data-hxt-rows value="{{boundsRows}}" min="1" max="99" placeholder="rows" class="sde-hxt-small"></label>
        <label title="The columns that sit higher have their first row cut in half by the print's frame. On maps like the Western Reaches that half cell is the margin the column labels are printed in, not map."><input type="checkbox" data-hxt-skip-top {{#if skipTopRow}}checked{{/if}}> top row is frame</label>
        <button type="button" data-action="hxtSetBounds" class="sde-import-secondary sde-hxt-inline">Apply</button>
        </div>
      <p class="sde-hxt-muted">Cells past the map's columns or rows (margins, legend) are skipped.</p>
      {{/if}}
    </div>
    {{/if}}
  </header>

  {{#if error}}<p class="sde-hxt-error"><i class="fas fa-triangle-exclamation"></i> {{error}}</p>{{/if}}

  {{#unless sampled}}
  {{#if origin}}
  <p class="sde-hxt-note">This scene's grid is already aligned to the map. <strong>Read the map</strong> takes a picture of every hex from the image in your browser — it decides no terrain. Then <strong>Legend</strong> sorts those pictures into groups of look-alikes and asks you to name one card per group, and <strong>Classify</strong> tags every remaining hex by whichever hex you tagged by hand it looks most like.</p>
  {{else}}
  <p class="sde-hxt-note">Open the hex-map scene, align its grid to the map with Foundry's grid tool (set background scale Y separately for stretched prints), then <strong>Read the map</strong>. Nothing is uploaded; the picture of each hex is read from the image in your browser.</p>
  {{/if}}
  {{/unless}}

  {{#if baseline}}
  <p class="sde-hxt-note sde-hxt-direction">
    <i class="fas fa-flag-checkered"></i> <strong>The initial scan, scored by you</strong>: of the {{baseline.checked}} hexes you have checked so far, it had {{baseline.right}} right — <strong>{{baseline.accuracy}}%</strong>. That is what this map would have been worth to somebody who never corrected anything, and it is the number a change to the module has to move.
    {{#if baseline.worst}}Its worst confusions on what you have checked: {{#each baseline.worst as |w|}}{{#unless @first}}, {{/unless}}{{lookup w 1}}× {{lookup w 0}}{{/each}}.{{/if}}
  </p>
  {{/if}}

  {{#if report}}
  <p class="sde-hxt-note sde-hxt-direction">
    <i class="fas fa-chart-simple"></i> <strong>From your corrections</strong>: you have judged {{report.judged}} hexes the classifier tagged, and {{report.wrong}} of them were wrong.
    {{#if report.retag}}
    That is bad enough that the threshold below is not the problem — the examples it is working from are. <strong>Classify</strong> again: your {{report.wrong}} corrections become examples, and every cell you have not touched is re-tagged from them.
    {{/if}}
    {{#if report.wrong}}
    <br>When it tags a hex it also says how much better its first guess was than its second — twice as good, a tenth better. The <strong>Review queue</strong> holds the hexes where that was under <strong>{{reviewMargin}}×</strong>, which is {{reviewCount}} of them, and it caught {{report.caught}}% of the mistakes you found: the rest it was confident about and still got wrong.
    {{/if}}
    {{#if report.suggested}}
    Widening it to <strong>{{report.suggested}}×</strong> would have caught 90%, with {{report.suggestedCount}} hexes in the queue instead of {{reviewCount}}.
    <button type="button" data-action="hxtUseMargin" data-margin="{{report.suggested}}" class="sde-import-secondary sde-hxt-inline">Use {{report.suggested}}×</button>
    {{/if}}
  </p>
  {{/if}}

  {{#if origin}}{{#if sampled}}{{#unless hasLegend}}
  {{#if done}}
  <p class="sde-hxt-note sde-hxt-direction">
    <i class="fas fa-circle-check"></i> <strong>The map is tagged</strong>: {{summary.gm}} cells by you, {{summary.auto}} by the classifier. Nothing more is required; <strong>{{#if viaExtras}}Send to Extras{{else}}Download dataset{{/if}}</strong> is ready whenever you are.
    {{#if reviewCount}}The classifier was least sure about {{reviewCount}} hexes — the ones where its second guess was nearly as good as its first. They are below, each already filled in with what it guessed. <strong>Change only the ones that are wrong</strong>, then press the button at the bottom: that confirms the whole sheet, the ones you changed <em>and</em> the ones you left, takes them out of this queue and records how often it was right. You never have to finish the list.{{/if}}
    {{#if noCrawl}}Choosing your crawl entry above and pressing <strong>Classify</strong> again leaves the keyed hexes to the book and shortens that list.{{/if}}
  </p>
  {{else if summary.tagged}}
  <p class="sde-hxt-note sde-hxt-direction">{{summary.untagged}} cells still untagged. <strong>Legend</strong> names them all at once, one card per glyph; <strong>Classify</strong> tags them from the {{summary.gm}} you tagged by hand; the sheet below tags them {{sheet.length}} at a time.</p>
  {{else}}
  <p class="sde-hxt-note sde-hxt-direction">Nothing tagged yet. <strong>Legend</strong> is the quick way: one card per glyph to name, then everything is tagged from those. The sheet below is the slow way, {{sheet.length}} cells at a time.</p>
  {{/if}}
  {{/unless}}{{/if}}{{/if}}

  {{#if needsOrigin}}
  <p class="sde-hxt-note">
    <i class="fas fa-anchor"></i> Read the printed hex number off any thumbnail below and type it in that cell, then <strong>Set</strong>. Every other cell is numbered from it.
    Lowered columns: <select data-hxt-shifted><option value="odd" selected>odd (1, 3, 5…)</option><option value="even">even (0, 2, 4…)</option></select>
  </p>
  {{/if}}

  {{#if hasLegend}}
  <p class="sde-hxt-note sde-hxt-direction">
    <i class="fas fa-list-ul"></i> Each card is one group of look-alike cells, biggest first, with a picture of each kind of cell in it. <strong>Name what the pictures have in common</strong> — a mountain, a mountain with a river and a mountain with a road are all one answer: mountain. A river, path or coast <em>crossing</em> a terrain is not asked here — the classifier finds those cell by cell — but a hex that is <strong>only</strong> a river, with no terrain under it, is a <strong>river</strong> card and must be named one, or its hexes have nowhere to go. Cards of map symbols have their own names: <strong>village</strong>, <strong>town</strong>, <strong>city</strong>, <strong>city state</strong> and <strong>keyed location</strong> for the star markers, which keeps them out of the terrains and leaves them to the book. If the pictures are genuinely different things, choose <strong>these are not all the same</strong> and that card alone is broken into smaller ones to name; every other answer is kept. <strong>(skip)</strong> leaves a card to the classifier. The same thing often gets several cards; name them all, then <strong>Apply legend</strong>.
  </p>
  <div class="sde-hxt-sheet sde-hxt-legend">
    {{#each legend as |g|}}
    <div class="sde-hxt-cell">
      <div class="sde-hxt-thumbs">{{#each g.thumbs as |t|}}<img src="{{t}}" alt="" width="72" height="72">{{/each}}</div>
      <div class="sde-hxt-fields">
        <span class="sde-hxt-label">{{g.size}} cells{{#if g.split}} <span class="sde-hxt-muted">(from a split)</span>{{/if}}</span>
        <select data-hxt-legend data-idx="{{g.idx}}">
          <option value="">(skip)</option>
          {{#each g.terrainOptions as |o|}}<option value="{{o.value}}" {{#if o.selected}}selected{{/if}}>{{o.label}}</option>{{/each}}
        </select>
        <input type="text" data-hxt-legend-other data-idx="{{g.idx}}" value="{{g.terrainOther}}" placeholder="other terrain" aria-label="Other terrain" {{#unless g.terrainOther}}hidden{{/unless}}>
      </div>
    </div>
    {{/each}}
  </div>
  <footer class="sde-hxt-foot">
    <button type="button" data-action="hxtApplyLegend" class="sde-import-primary"><i class="fas fa-check"></i> Apply legend</button>
    <button type="button" data-action="hxtCancelLegend" class="sde-import-secondary">Cancel</button>
  </footer>
  {{else if hasSheet}}
  <div class="sde-hxt-sheet">
    {{#each sheet as |c|}}
    <div class="sde-hxt-cell{{#if c.keyed}} keyed{{/if}}">
      <img src="{{c.thumb}}" alt="" width="96" height="96">
      {{#if c.align}}
      <div class="sde-hxt-fields">
        <span class="sde-hxt-muted">grid {{c.i}},{{c.j}}</span>
        <input type="text" data-hxt-number data-i="{{c.i}}" data-j="{{c.j}}" placeholder="number" maxlength="4" class="sde-hxt-num">
        <button type="button" data-action="hxtSetNumber" data-i="{{c.i}}" data-j="{{c.j}}" class="sde-import-secondary sde-hxt-inline">Set</button>
      </div>
      {{else}}
      <div class="sde-hxt-fields">
        <span class="sde-hxt-label">{{c.label}}{{#if c.keyed}} <i class="fas fa-star" title="Keyed hex"></i>{{/if}}{{#if c.source}} <span class="sde-hxt-muted">{{c.source}}{{#if c.margin}} {{c.margin}}{{/if}}{{#if c.review}} <i class="fas fa-circle-question" title="Flagged for review"></i>{{/if}}</span>{{/if}}</span>
        <select data-hxt-terrain data-num="{{c.num}}">
          <option value="">(untagged)</option>
          {{#each c.terrainOptions as |o|}}<option value="{{o.value}}" {{#if o.selected}}selected{{/if}}>{{o.label}}</option>{{/each}}
        </select>
        <input type="text" data-hxt-terrain-other data-num="{{c.num}}" value="{{c.terrainOther}}" placeholder="other terrain" aria-label="Other terrain" {{#unless c.terrainOther}}hidden{{/unless}}>
        <span class="sde-hxt-overlays">
          <label><input type="checkbox" data-hxt-overlay data-num="{{c.num}}" value="river" {{#if c.overlays.river}}checked{{/if}}> river</label>
          <label><input type="checkbox" data-hxt-overlay data-num="{{c.num}}" value="path" {{#if c.overlays.path}}checked{{/if}}> path</label>
          <label title="Saved on this scene; not included in dataset networks yet."><input type="checkbox" data-hxt-overlay data-num="{{c.num}}" value="coast" {{#if c.overlays.coast}}checked{{/if}}> coast</label>
        </span>
      </div>
      {{/if}}
    </div>
    {{/each}}
  </div>

  {{#if hasSheet}}{{#unless needsOrigin}}
  <footer class="sde-hxt-foot">
    <span class="sde-hxt-muted">Leaving a hex alone says the classifier got it right.</span>
    <button type="button" data-action="hxtApplySheet" class="sde-import-primary" title="Accepts every hex on this sheet as it now reads — the ones you changed and the ones you left — and takes them out of the review queue."><i class="fas fa-check"></i> Confirm these {{sheet.length}}</button>
    <button type="button" data-action="hxtNextSheet" class="sde-import-secondary" title="A different {{sheet.length}} hexes. Nothing on this sheet is confirmed or changed.">Show me others</button>
  </footer>
  {{/unless}}{{/if}}
  {{/if}}
</div>

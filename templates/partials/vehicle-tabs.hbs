{{!-- Shared Occupants / Cargo / Description tabs for the Boat sheet (Shadowdark chrome). --}}

<section class="sde-veh-tab-content {{#if tab.occupants}}active{{/if}}" data-tab-content="occupants">
  <div class="SD-box">
    <div class="header"><label>{{occupantLabel}}</label><span>{{occupantCount}}</span></div>
    <div class="content">
      <div class="sde-veh-occ-actions">
        <button type="button" class="sde-veh-btn" data-action="placeTokens"><i class="fa-solid fa-map-pin"></i> {{localize "SDE.vehicle.placeTokens"}}</button>
      </div>
      <div class="sde-veh-droplist" data-drop="occupant">
        {{#if occupantCount}}
          {{#each occupants}}
            <div class="sde-veh-member" data-uuid="{{uuid}}">
              {{#if broken}}
                <div class="sde-veh-member-broken"><i class="fa-solid fa-triangle-exclamation"></i> {{name}}</div>
                <button type="button" class="sde-veh-member-remove" data-action="removeOccupant" title="{{localize 'SDE.vehicle.remove'}}"><i class="fa-solid fa-xmark"></i></button>
              {{else}}
                <img class="sde-veh-member-img" src="{{img}}" data-action="openOccupant" title="{{localize 'SDE.vehicle.openSheet'}}" />
                <div class="sde-veh-member-main">
                  <div class="sde-veh-member-name">
                    {{name}} <span class="sde-veh-member-sub">{{subtitle}}</span>
                    {{#if isCaptain}}<span class="sde-veh-role-badge is-captain"><i class="fa-solid fa-anchor"></i> {{localize "SDE.vehicle.role.captain"}}</span>{{/if}}
                    {{#if isGunner}}<span class="sde-veh-role-badge is-gunner"><i class="fa-solid fa-crosshairs"></i> {{localize "SDE.vehicle.role.gunner"}}</span>{{/if}}
                    {{#if isCrew}}<span class="sde-veh-role-badge is-crew"><i class="fa-solid fa-users"></i> {{localize "SDE.vehicle.role.crew"}}</span>{{/if}}
                  </div>
                  <div class="sde-veh-member-stats">
                    <span>{{localize "SDE.vehicle.stat.hp"}} {{hp.value}}/{{hp.max}}</span>
                    <span>{{localize "SDE.vehicle.stat.ac"}} {{ac}}</span>
                    {{#if level}}<span>{{localize "SDE.vehicle.stat.lvl"}} {{level}}</span>{{/if}}
                  </div>
                  <div class="sde-veh-member-abils">
                    <span>{{localize "SDE.vehicle.stat.str"}} {{abilities.str}}</span><span>{{localize "SDE.vehicle.stat.dex"}} {{abilities.dex}}</span><span>{{localize "SDE.vehicle.stat.con"}} {{abilities.con}}</span>
                    <span>{{localize "SDE.vehicle.stat.int"}} {{abilities.int}}</span><span>{{localize "SDE.vehicle.stat.wis"}} {{abilities.wis}}</span><span>{{localize "SDE.vehicle.stat.cha"}} {{abilities.cha}}</span>
                  </div>
                </div>
                <label class="sde-veh-member-rolesel" title="{{localize 'SDE.vehicle.roleTip'}}">
                  <select data-role data-uuid="{{uuid}}">
                    <option value="" {{#unless role}}selected{{/unless}}>{{localize "SDE.vehicle.role.passenger"}}</option>
                    <option value="captain" {{#if isCaptain}}selected{{/if}}>{{localize "SDE.vehicle.role.captain"}}</option>
                    <option value="gunner" {{#if isGunner}}selected{{/if}}>{{localize "SDE.vehicle.role.gunner"}}</option>
                    <option value="crew" {{#if isCrew}}selected{{/if}}>{{localize "SDE.vehicle.role.crew"}}</option>
                  </select>
                </label>
                <button type="button" class="sde-veh-member-remove" data-action="removeOccupant" title="{{localize 'SDE.vehicle.remove'}}"><i class="fa-solid fa-xmark"></i></button>
              {{/if}}
            </div>
          {{/each}}
        {{else}}
          <p class="sde-veh-empty">{{localize "SDE.vehicle.occupantsEmpty"}}</p>
        {{/if}}
      </div>
    </div>
  </div>
</section>

<section class="sde-veh-tab-content {{#if tab.inventory}}active{{/if}}" data-tab-content="inventory">
  <div class="SD-box">
    <div class="header"><label>{{localize "SDE.boat.tab.cargo"}}</label><span>{{slotInfo.used}}{{#if slotInfo.max}}/{{slotInfo.max}}{{/if}}</span></div>
    <div class="content">
      <div class="sde-veh-slottally">
        <i class="fa-solid fa-box"></i> {{localize "SDE.vehicle.slots"}} {{slotInfo.used}}{{#if slotInfo.max}} / {{slotInfo.max}}{{/if}}
        {{#if slotInfo.note}}<span class="sde-veh-slotnote">({{slotInfo.note}})</span>{{/if}}
      </div>
      <div class="sde-veh-droplist" data-drop="inventory">
        {{#if items.length}}
          {{#each items}}
            <div class="sde-veh-item" data-item-id="{{id}}">
              <img class="sde-veh-item-img" src="{{img}}" data-action="openItem" />
              <span class="sde-veh-item-name" data-action="openItem">{{name}}</span>
              <span class="sde-veh-item-qty">×{{quantity}}</span>
              <span class="sde-veh-item-slots">{{localize "SDE.vehicle.slotsShort" slots=slots}}</span>
              <button type="button" class="sde-veh-item-del" data-action="deleteItem" title="{{localize 'SDE.vehicle.delete'}}"><i class="fa-solid fa-trash"></i></button>
            </div>
          {{/each}}
        {{else}}
          <p class="sde-veh-empty">{{localize "SDE.vehicle.cargoEmpty"}}</p>
        {{/if}}
      </div>
    </div>
  </div>
</section>

<section class="sde-veh-tab-content {{#if tab.weapons}}active{{/if}}" data-tab-content="weapons">
  <div class="SD-box">
    <div class="header"><label>{{localize "SDE.vehicle.siegeWeapons"}}</label><span>{{weaponCount}}</span></div>
    <div class="content">
      <div class="sde-veh-droplist" data-drop="weapon">
        {{#if weapons.length}}
          {{#each weapons}}
            <div class="sde-veh-item" data-item-id="{{id}}">
              <img class="sde-veh-item-img" src="{{img}}" data-action="openItem" />
              <span class="sde-veh-item-name" data-action="openItem">{{name}}</span>
              {{#if damage}}<span class="sde-veh-item-dmg">{{damage}}</span>{{/if}}
              <button type="button" class="sde-veh-wpn-btn" data-action="weaponAttack" title="{{localize 'SDE.vehicle.attackTip'}}"><i class="fa-solid fa-crosshairs"></i> {{localize "SDE.vehicle.atk"}}</button>
              <button type="button" class="sde-veh-wpn-btn" data-action="weaponDamage" title="{{localize 'SDE.vehicle.damageTip'}}"><i class="fa-solid fa-burst"></i> {{localize "SDE.vehicle.dmg"}}</button>
              <button type="button" class="sde-veh-item-del" data-action="deleteItem" title="{{localize 'SDE.vehicle.remove'}}"><i class="fa-solid fa-trash"></i></button>
            </div>
          {{/each}}
        {{else}}
          <p class="sde-veh-empty">{{localize "SDE.vehicle.weaponsEmpty" occupants=occupantLabel}}</p>
        {{/if}}
      </div>
    </div>
  </div>
</section>

<section class="sde-veh-tab-content {{#if tab.description}}active{{/if}}" data-tab-content="description">
  <div class="SD-box">
    <div class="header"><label>{{localize "SDE.boat.tab.description"}}</label><span></span></div>
    <div class="content">
      <textarea name="system.notes" rows="10">{{system.notes}}</textarea>
    </div>
  </div>
</section>

{{!-- Shared Occupants / Cargo / Description tabs for the Boat sheet (Shadowdark chrome). --}}

<section class="sde-veh-tab-content {{#if tab.occupants}}active{{/if}}" data-tab-content="occupants">
  <div class="SD-box">
    <div class="header"><label>{{occupantLabel}}</label><span>{{occupantCount}}</span></div>
    <div class="content">
      <div class="sde-veh-occ-actions">
        <button type="button" class="sde-veh-btn" data-action="placeTokens"><i class="fa-solid fa-map-pin"></i> Place Tokens</button>
      </div>
      <div class="sde-veh-droplist" data-drop="occupant">
        {{#if occupantCount}}
          {{#each occupants}}
            <div class="sde-veh-member" data-uuid="{{uuid}}">
              {{#if broken}}
                <div class="sde-veh-member-broken"><i class="fa-solid fa-triangle-exclamation"></i> {{name}}</div>
                <button type="button" class="sde-veh-member-remove" data-action="removeOccupant" title="Remove"><i class="fa-solid fa-xmark"></i></button>
              {{else}}
                <img class="sde-veh-member-img" src="{{img}}" data-action="openOccupant" title="Open sheet" />
                <div class="sde-veh-member-main">
                  <div class="sde-veh-member-name">
                    {{name}} <span class="sde-veh-member-sub">{{subtitle}}</span>
                    {{#if isCaptain}}<span class="sde-veh-role-badge is-captain"><i class="fa-solid fa-anchor"></i> Captain</span>{{/if}}
                    {{#if isGunner}}<span class="sde-veh-role-badge is-gunner"><i class="fa-solid fa-crosshairs"></i> Gunner</span>{{/if}}
                    {{#if isCrew}}<span class="sde-veh-role-badge is-crew"><i class="fa-solid fa-users"></i> Crew</span>{{/if}}
                  </div>
                  <div class="sde-veh-member-stats">
                    <span>HP {{hp.value}}/{{hp.max}}</span>
                    <span>AC {{ac}}</span>
                    {{#if level}}<span>LVL {{level}}</span>{{/if}}
                  </div>
                  <div class="sde-veh-member-abils">
                    <span>STR {{abilities.str}}</span><span>DEX {{abilities.dex}}</span><span>CON {{abilities.con}}</span>
                    <span>INT {{abilities.int}}</span><span>WIS {{abilities.wis}}</span><span>CHA {{abilities.cha}}</span>
                  </div>
                </div>
                <label class="sde-veh-member-rolesel" title="Crew role">
                  <select data-role data-uuid="{{uuid}}">
                    <option value="" {{#unless role}}selected{{/unless}}>Passenger</option>
                    <option value="captain" {{#if isCaptain}}selected{{/if}}>Captain</option>
                    <option value="gunner" {{#if isGunner}}selected{{/if}}>Gunner</option>
                    <option value="crew" {{#if isCrew}}selected{{/if}}>Crew</option>
                  </select>
                </label>
                <button type="button" class="sde-veh-member-remove" data-action="removeOccupant" title="Remove"><i class="fa-solid fa-xmark"></i></button>
              {{/if}}
            </div>
          {{/each}}
        {{else}}
          <p class="sde-veh-empty">Drag Player or NPC actors here to add them.</p>
        {{/if}}
      </div>
    </div>
  </div>
</section>

<section class="sde-veh-tab-content {{#if tab.inventory}}active{{/if}}" data-tab-content="inventory">
  <div class="SD-box">
    <div class="header"><label>Cargo</label><span>{{slotInfo.used}}{{#if slotInfo.max}}/{{slotInfo.max}}{{/if}}</span></div>
    <div class="content">
      <div class="sde-veh-slottally">
        <i class="fa-solid fa-box"></i> Slots: {{slotInfo.used}}{{#if slotInfo.max}} / {{slotInfo.max}}{{/if}}
        {{#if slotInfo.note}}<span class="sde-veh-slotnote">({{slotInfo.note}})</span>{{/if}}
      </div>
      <div class="sde-veh-droplist" data-drop="inventory">
        {{#if items.length}}
          {{#each items}}
            <div class="sde-veh-item" data-item-id="{{id}}">
              <img class="sde-veh-item-img" src="{{img}}" data-action="openItem" />
              <span class="sde-veh-item-name" data-action="openItem">{{name}}</span>
              <span class="sde-veh-item-qty">×{{quantity}}</span>
              <span class="sde-veh-item-slots">{{slots}} sl</span>
              <button type="button" class="sde-veh-item-del" data-action="deleteItem" title="Delete"><i class="fa-solid fa-trash"></i></button>
            </div>
          {{/each}}
        {{else}}
          <p class="sde-veh-empty">Drag items here to load gear / cargo.</p>
        {{/if}}
      </div>
    </div>
  </div>
</section>

<section class="sde-veh-tab-content {{#if tab.weapons}}active{{/if}}" data-tab-content="weapons">
  <div class="SD-box">
    <div class="header"><label>Siege weapons</label><span>{{weaponCount}}</span></div>
    <div class="content">
      <div class="sde-veh-droplist" data-drop="weapon">
        {{#if weapons.length}}
          {{#each weapons}}
            <div class="sde-veh-item" data-item-id="{{id}}">
              <img class="sde-veh-item-img" src="{{img}}" data-action="openItem" />
              <span class="sde-veh-item-name" data-action="openItem">{{name}}</span>
              {{#if damage}}<span class="sde-veh-item-dmg">{{damage}}</span>{{/if}}
              <button type="button" class="sde-veh-wpn-btn" data-action="weaponAttack" title="Attack — a Passenger operates it (rolls 1d20 + that crew member's attack bonus)"><i class="fa-solid fa-crosshairs"></i> Atk</button>
              <button type="button" class="sde-veh-wpn-btn" data-action="weaponDamage" title="Roll the weapon's damage"><i class="fa-solid fa-burst"></i> Dmg</button>
              <button type="button" class="sde-veh-item-del" data-action="deleteItem" title="Remove"><i class="fa-solid fa-trash"></i></button>
            </div>
          {{/each}}
        {{else}}
          <p class="sde-veh-empty">Drag siege weapons from a compendium here (a boat employs up to 2; trebuchets on galleons only). A Passenger operates each weapon — add crew under the {{occupantLabel}} tab.</p>
        {{/if}}
      </div>
    </div>
  </div>
</section>

<section class="sde-veh-tab-content {{#if tab.description}}active{{/if}}" data-tab-content="description">
  <div class="SD-box">
    <div class="header"><label>Description</label><span></span></div>
    <div class="content">
      <textarea name="system.notes" rows="10">{{system.notes}}</textarea>
    </div>
  </div>
</section>

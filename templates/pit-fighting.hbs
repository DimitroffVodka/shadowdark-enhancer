<div class="sde-pit">

  {{#unless hasParty}}
  <p class="notes"><i class="fa-solid fa-circle-info"></i> {{localize "SDE.pitFighting.ui.noParty"}}</p>
  {{/unless}}

  {{!-- ── 1. THE OFFER ───────────────────────────────────────────────────── --}}
  <div class="sde-pit-section-head">
    <span>{{localize "SDE.pitFighting.ui.theOffer"}}</span>
    <span class="sde-pit-apl" title="{{localize 'SDE.pitFighting.ui.aplTip'}}">
      {{localize "SDE.pitFighting.ui.partyApl" apl=apl}}{{#if aplRounded}} <em>{{localize "SDE.pitFighting.ui.aplMean" mean=aplMeanText}}</em>{{/if}}
    </span>
  </div>

  <p class="notes">{{localize "SDE.pitFighting.ui.offerNote"}}</p>

  <div class="sde-pit-row">
    <span class="sde-pit-label">{{localize "SDE.pitFighting.ui.venue"}}</span>
    <span class="sde-pit-roll-total" title="2d6">{{#if hasVenue}}{{bout.venue.total}}{{/if}}</span>
    <span class="sde-pit-text">
      <button type="button" class="sde-pit-mini" data-action="rollVenue"><i class="fas fa-dice"></i> {{localize "SDE.pitFighting.ui.roll"}}</button>
      <select data-venue-select aria-label="{{localize 'SDE.pitFighting.ui.chooseVenue'}}">
        <option value="">{{localize "SDE.pitFighting.ui.orPick"}}</option>
        {{#each venueOptions as |v|}}
        <option value="{{v.total}}" {{#if v.selected}}selected{{/if}}>{{v.range}} · {{#if v.text}}{{v.text}}{{else}}{{localize "SDE.pitFighting.ui.row" row=v.row}}{{/if}}</option>
        {{/each}}
      </select>
      <button type="button" class="sde-pit-mini" data-action="openArena"
              title="{{localize 'SDE.pitFighting.ui.arenaTip'}}">
        <i class="fas fa-map"></i> {{localize "SDE.pitFighting.ui.arenaMap"}}
      </button>
      {{#if venueText}}<div class="sde-pit-drawn">{{venueText}}</div>{{/if}}
    </span>
  </div>

  <div class="sde-pit-row">
    <span class="sde-pit-label">{{localize "SDE.pitFighting.ui.stakes"}}</span>
    <span class="sde-pit-roll-total" title="{{localize 'SDE.pitFighting.ui.stakesTip'}}">{{#if hasStakes}}{{bout.stakes.total}}{{/if}}</span>
    <span class="sde-pit-text">
      <button type="button" class="sde-pit-mini" data-action="rollStakes"><i class="fas fa-dice"></i> {{localize "SDE.pitFighting.ui.roll"}}</button>
      <select data-stakes-select aria-label="{{localize 'SDE.pitFighting.ui.chooseStakes'}}">
        <option value="">{{localize "SDE.pitFighting.ui.orPick"}}</option>
        {{#each stakesOptions as |s|}}
        <option value="{{s.total}}" {{#if s.selected}}selected{{/if}}>{{s.label}}</option>
        {{/each}}
      </select>
      {{!-- The tier alone would only repeat the dropdown beside it. Say it
            when the twist MOVED it, which the dropdown cannot show. --}}
      {{#if bout.stakes.raised}}
      <div class="sde-pit-drawn">
        <strong>{{bout.stakes.label}}</strong>
        <em class="sde-pit-raised">{{localize "SDE.pitFighting.ui.raisedStep"}}</em>
      </div>
      {{/if}}
    </span>
  </div>

  {{#if hasOffer}}
  <div class="sde-pit-row">
    <span class="sde-pit-label">{{localize "SDE.pitFighting.ui.size"}}</span>
    <span class="sde-pit-roll-total sde-pit-no-die"></span>
    <span class="sde-pit-text">
      <button type="button" class="sde-pit-mini {{#if group}}sde-pit-on{{/if}}" data-action="toggleSize"
              title="{{localize 'SDE.pitFighting.ui.sizeTip'}}">
        <i class="fas fa-users"></i> {{sizeLabel}}
      </button>
    </span>
  </div>

  <div class="sde-pit-row">
    <span class="sde-pit-label">{{localize "SDE.pitFighting.ui.danger"}}</span>
    <span class="sde-pit-roll-total sde-pit-no-die"></span>
    <span class="sde-pit-text">
      <select data-danger-select aria-label="{{localize 'SDE.pitFighting.ui.dangerLevel'}}">
        {{#each dangerOptions as |d|}}
        <option value="{{d.key}}" {{#if d.selected}}selected{{/if}}>{{d.label}}</option>
        {{/each}}
      </select>
      {{#if bout.danger.overridden}}<em>{{localize "SDE.pitFighting.ui.yourCall"}}</em>{{/if}}
    </span>
  </div>

  <div class="sde-pit-row">
    <span class="sde-pit-label">{{localize "SDE.pitFighting.ui.foe"}}</span>
    <span class="sde-pit-roll-total sde-pit-no-die" title="{{bout.encounterTable}}"><i class="fas fa-table-list"></i></span>
    <span class="sde-pit-text">
      <button type="button" class="sde-pit-mini" data-action="drawFoe"><i class="fas fa-rotate"></i> {{localize "SDE.pitFighting.ui.draw"}}</button>
      {{#if canPlaceFoes}}
      <button type="button" class="sde-pit-mini" data-action="placeFoes"
              title="{{localize 'SDE.pitFighting.ui.placeTip'}}">
        <i class="fas fa-bullseye"></i> {{localize "SDE.pitFighting.ui.place"}}
      </button>
      {{/if}}
      <div class="sde-pit-drawn">{{#if foeText}}{{foeText}}{{else}}<em>{{localize "SDE.pitFighting.ui.notImported" table=bout.encounterTable}}</em>{{/if}}</div>
      {{#if foes.length}}
      <ul class="sde-pit-foes">
        {{#each foes as |f|}}
        <li class="sde-pit-foe{{#unless f.uuid}} sde-pit-foe-missing{{/unless}}">
          {{#if f.uuid}}<i class="fas fa-circle-check"></i>{{else}}<i class="fas fa-circle-question"></i>{{/if}}
          {{#unless (eq f.count "1")}}<span class="sde-pit-foe-count">{{f.count}}&times;</span>{{/unless}}
          <span class="sde-pit-foe-name">{{f.display}}</span>
          {{#if f.note}}<em class="sde-pit-foe-note">({{f.note}})</em>{{/if}}
          {{#unless f.uuid}}<span class="sde-pit-foe-why">{{localize "SDE.pitFighting.ui.notInCompendium"}}</span>{{/unless}}
        </li>
        {{/each}}
      </ul>
      {{/if}}
    </span>
  </div>
  {{else}}
  <div class="sde-pit-footer">
    <button type="button" class="sde-pit-roll" data-action="rollOffer" {{#unless hasParty}}disabled{{/unless}}>
      <i class="fas fa-dice"></i> {{localize "SDE.pitFighting.ui.rollOffer"}}
    </button>
  </div>
  {{/if}}

  {{#if hasMissing}}
  <div class="sde-pit-missing">
    <p><i class="fa-solid fa-triangle-exclamation"></i> {{localize "SDE.pitFighting.ui.missingNote"}}</p>
    <ul>{{#each missing as |m|}}<li>{{m}}</li>{{/each}}</ul>
    <button type="button" class="sde-pit-mini" data-action="openImporter">
      <i class="fas fa-file-import"></i> {{localize "SDE.pitFighting.ui.openImporter"}}
    </button>
  </div>
  {{/if}}

  {{!-- ── 2. THE TWIST — secret until revealed ───────────────────────────── --}}
  {{#if hasOffer}}
  <div class="sde-pit-row sde-pit-twist">
    <span class="sde-pit-label">{{localize "SDE.pitFighting.ui.twist"}}</span>
    <span class="sde-pit-roll-total" title="2d6">{{#if hasTwist}}{{bout.twist.total}}{{/if}}</span>
    <span class="sde-pit-text">
      {{#if twistRevealed}}
        <div class="sde-pit-drawn">
          {{#if twistText}}{{twistText}}{{else}}<em>{{localize "SDE.pitFighting.ui.twistNotImported"}}</em>{{/if}}
          {{#if twistSub}}<em>(1d4: {{twistSub}})</em>{{/if}}
        </div>
      {{else}}
        <button type="button" class="sde-pit-mini" data-action="rollTwist"><i class="fas fa-dice"></i> {{localize "SDE.pitFighting.ui.reroll"}}</button>
        <select data-twist-select aria-label="{{localize 'SDE.pitFighting.ui.chooseTwist'}}">
          <option value="">{{localize "SDE.pitFighting.ui.orPick"}}</option>
          {{#each twistOptions as |t|}}
          <option value="{{t.total}}" {{#if t.selected}}selected{{/if}}>{{t.range}} · {{#if t.text}}{{t.text}}{{else}}{{t.key}}{{/if}}</option>
          {{/each}}
        </select>
        <button type="button" class="sde-pit-mini" data-action="revealTwist"><i class="fas fa-eye"></i> {{localize "SDE.pitFighting.ui.reveal"}}</button>
        <div class="sde-pit-hidden">{{#if twistIsNone}}{{localize "SDE.pitFighting.ui.hiddenNone"}}{{else}}{{localize "SDE.pitFighting.ui.hiddenWaiting"}}{{/if}}</div>
      {{/if}}
    </span>
  </div>
  {{/if}}

  {{!-- ── 3. THE ANSWER — only once there is a bout to answer ────────────── --}}
  {{#if hasOffer}}
  <div class="sde-pit-section-head">
    <span>{{localize "SDE.pitFighting.ui.whoStepsUp"}} (<span data-fighter-count>{{fighterCount}}</span>)</span>
  </div>

  {{#if declined}}
  <p class="notes sde-pit-declined"><i class="fas fa-hand"></i> {{localize "SDE.pitFighting.ui.declined"}}</p>
  {{/if}}

  {{#if hasParty}}
  <ul class="sde-pit-members">
    {{#each party as |p|}}
    <li class="sde-pit-member">
      <label>
        <input type="checkbox" data-fighter="{{p.id}}" {{#if p.checked}}checked{{/if}} {{#if ../accepted}}disabled{{/if}}>
        <span class="sde-pit-member-name">{{p.name}}</span>
      </label>
      <span class="sde-pit-member-stats">
        {{#if p.level}}<span class="sde-pit-lvl">{{localize "SDE.pitFighting.ui.levelShort" level=p.level}}</span>{{/if}}
        <span class="sde-pit-ren" title="{{localize 'SDE.pitFighting.ui.currentRenown'}}"><i class="fas fa-crown"></i> {{p.renown}}</span>
      </span>
    </li>
    {{/each}}
  </ul>
  {{/if}}

  {{#if undecided}}
  <div class="sde-pit-footer">
    <button type="button" class="sde-pit-apply" data-action="accept" {{#unless fighterCount}}disabled{{/unless}}>
      <i class="fas fa-check"></i> {{localize "SDE.pitFighting.ui.accept"}}
    </button>
    <button type="button" class="sde-pit-mini" data-action="decline">
      <i class="fas fa-xmark"></i> {{localize "SDE.pitFighting.ui.decline"}}
    </button>
    <button type="button" class="sde-pit-mini" data-action="clearBout">{{localize "SDE.pitFighting.ui.newOffer"}}</button>
  </div>
  {{/if}}
  {{/if}}

  {{!-- ── 4. THE RESULT ──────────────────────────────────────────────────── --}}
  {{#if accepted}}
  <div class="sde-pit-section-head"><span>{{localize "SDE.pitFighting.ui.result"}}</span></div>

  <div class="sde-pit-outcome">
    <button type="button" class="sde-pit-mini {{#if isWin}}sde-pit-on{{/if}}" data-action="setOutcome" data-outcome="win">
      <i class="fas fa-trophy"></i> {{localize "SDE.pitFighting.ui.won"}}
    </button>
    <button type="button" class="sde-pit-mini {{#if isLoss}}sde-pit-on{{/if}}" data-action="setOutcome" data-outcome="loss">
      <i class="fas fa-skull"></i> {{localize "SDE.pitFighting.ui.lost"}}
    </button>
    <button type="button" class="sde-pit-mini" data-action="rollPrize">
      <i class="fas fa-sack-dollar"></i> {{localize "SDE.pitFighting.ui.rollTable" table=bout.stakes.table}}
    </button>
  </div>

  {{#if prize}}
  <div class="sde-pit-row">
    <span class="sde-pit-label">{{localize "SDE.pitFighting.ui.prize"}}</span>
    <span class="sde-pit-roll-total sde-pit-no-die"></span>
    <span class="sde-pit-text">{{prize}}</span>
  </div>
  {{/if}}

  {{#if outcome}}
  <div class="sde-pit-fame">
    <label>
      {{localize "SDE.pitFighting.ui.renownEach"}}
      <input type="number" step="1" value="{{renownDelta}}" data-renown-delta aria-label="{{localize 'SDE.pitFighting.ui.renownEachTip'}}">
    </label>
    <p class="notes">{{localize "SDE.pitFighting.ui.renownNote"}}</p>
  </div>
  {{/if}}

  <div class="sde-pit-footer">
    <button type="button" class="sde-pit-apply" data-action="applyResults" {{#unless canApply}}disabled{{/unless}}>
      <i class="fas fa-check"></i> {{#if applied}}{{localize "SDE.pitFighting.ui.applied"}}{{else}}{{localize "SDE.pitFighting.ui.applyResult"}}{{/if}}
    </button>
    <button type="button" class="sde-pit-mini" data-action="clearBout">{{localize "SDE.pitFighting.ui.newOffer"}}</button>
  </div>
  {{/if}}

</div>

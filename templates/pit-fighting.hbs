{{!-- Pit Fighting: four stages as numbered cards. Window root carries sde-ui (styles/sde-ui.css). --}}
<div class="ui-shell">

  <header class="ui-head">
    <div class="ui-head-text"><h2 class="ui-title">{{localize "SDE.pitFighting.title"}}</h2>
      <p class="ui-sub">{{#unless hasParty}}{{localize "SDE.pitFighting.ui.noParty"}}{{else}}{{localize "SDE.pitFighting.ui.offerNote"}}{{/unless}}</p></div>
    <div class="ui-stats">
      <div class="ui-stat" title="{{localize 'SDE.pitFighting.ui.aplTip'}}"><span class="ui-value">{{localize "SDE.pitFighting.ui.partyApl" apl=apl}}</span>{{#if aplRounded}}<span class="ui-label">{{localize "SDE.pitFighting.ui.aplMean" mean=aplMeanText}}</span>{{/if}}</div>
      {{#if hasOffer}}<div class="ui-stat"><span class="ui-label">{{localize "SDE.pitFighting.ui.whoStepsUp"}}</span><span class="ui-value" data-fighter-count>{{fighterCount}}</span></div>{{/if}}
    </div>
  </header>

  <div class="ui-body">

    {{!-- 1. THE OFFER --}}
    <section class="ui-card pit-stage {{#unless hasOffer}}sel{{/unless}}">
      <div class="ui-card-head"><span class="ui-num">1</span><h3 class="ui-card-name">{{localize "SDE.pitFighting.ui.theOffer"}}</h3></div>

      <div class="pit-line">
        <span class="ui-label">{{localize "SDE.pitFighting.ui.venue"}}</span>
        <div class="pit-pick">
          <button type="button" class="ui-icon" data-action="rollVenue" title="{{localize 'SDE.pitFighting.ui.roll'}}"><i class="fas fa-dice"></i></button>
          <select data-venue-select aria-label="{{localize 'SDE.pitFighting.ui.chooseVenue'}}">
            <option value="">{{localize "SDE.pitFighting.ui.orPick"}}</option>
            {{#each venueOptions as |v|}}<option value="{{v.total}}" {{#if v.selected}}selected{{/if}}>{{v.range}} · {{#if v.text}}{{v.text}}{{else}}{{localize "SDE.pitFighting.ui.row" row=v.row}}{{/if}}</option>{{/each}}
          </select>
          <button type="button" class="ui-icon" data-action="openArena" title="{{localize 'SDE.pitFighting.ui.arenaTip'}}"><i class="fas fa-map"></i></button>
        </div>
        {{#if hasVenue}}<span class="ui-chip gold pit-total" title="2d6">{{bout.venue.total}}</span>{{/if}}
        {{#if venueText}}<p class="pit-drawn">{{venueText}}</p>{{/if}}
      </div>

      <div class="pit-line">
        <span class="ui-label">{{localize "SDE.pitFighting.ui.stakes"}}</span>
        <div class="pit-pick">
          <button type="button" class="ui-icon" data-action="rollStakes" title="{{localize 'SDE.pitFighting.ui.roll'}}"><i class="fas fa-dice"></i></button>
          <select data-stakes-select aria-label="{{localize 'SDE.pitFighting.ui.chooseStakes'}}">
            <option value="">{{localize "SDE.pitFighting.ui.orPick"}}</option>
            {{#each stakesOptions as |s|}}<option value="{{s.total}}" {{#if s.selected}}selected{{/if}}>{{s.label}}</option>{{/each}}
          </select>
        </div>
        {{#if hasStakes}}<span class="ui-chip gold pit-total" title="{{localize 'SDE.pitFighting.ui.stakesTip'}}">{{bout.stakes.total}}</span>{{/if}}
        {{#if bout.stakes.raised}}<p class="pit-drawn"><strong>{{bout.stakes.label}}</strong> <em class="ui-muted">{{localize "SDE.pitFighting.ui.raisedStep"}}</em></p>{{/if}}
      </div>

      {{#if hasOffer}}
      <div class="pit-two">
        <div class="ui-field"><span class="ui-label">{{localize "SDE.pitFighting.ui.size"}}</span>
          <button type="button" class="ui-btn {{#if group}}pit-on{{/if}}" data-action="toggleSize" title="{{localize 'SDE.pitFighting.ui.sizeTip'}}"><i class="fas fa-users"></i> {{sizeLabel}}</button></div>
        <div class="ui-field"><span class="ui-label">{{localize "SDE.pitFighting.ui.danger"}}</span>
          <select data-danger-select aria-label="{{localize 'SDE.pitFighting.ui.dangerLevel'}}">{{#each dangerOptions as |d|}}<option value="{{d.key}}" {{#if d.selected}}selected{{/if}}>{{d.label}}</option>{{/each}}</select>
          {{#if bout.danger.overridden}}<span class="ui-row-sub">{{localize "SDE.pitFighting.ui.yourCall"}}</span>{{/if}}</div>
      </div>

      <div class="pit-line">
        <span class="ui-label">{{localize "SDE.pitFighting.ui.foe"}}</span>
        <div class="pit-pick">
          <p class="pit-drawn grow">{{#if foeText}}{{foeText}}{{else}}<em>{{localize "SDE.pitFighting.ui.notImported" table=bout.encounterTable}}</em>{{/if}}</p>
          <button type="button" class="ui-icon" data-action="drawFoe" title="{{localize 'SDE.pitFighting.ui.draw'}}"><i class="fas fa-rotate"></i></button>
          {{#if canPlaceFoes}}<button type="button" class="ui-icon" data-action="placeFoes" title="{{localize 'SDE.pitFighting.ui.placeTip'}}"><i class="fas fa-bullseye"></i></button>{{/if}}
        </div>
        {{#if foes.length}}
        <div class="ui-inline">
          {{#each foes as |f|}}<span class="ui-chip {{#unless f.uuid}}off{{/unless}}"><i class="fas {{#if f.uuid}}fa-circle-check{{else}}fa-circle-question{{/if}}"></i>{{#unless (eq f.count "1")}}{{f.count}}&times;{{/unless}} {{f.display}}{{#if f.note}} <em>({{f.note}})</em>{{/if}}{{#unless f.uuid}} {{localize "SDE.pitFighting.ui.notInCompendium"}}{{/unless}}</span>{{/each}}
        </div>
        {{/if}}
      </div>
      {{/if}}

      {{#if hasMissing}}
      <div class="ui-note warn">
        <p><i class="fa-solid fa-triangle-exclamation"></i> {{localize "SDE.pitFighting.ui.missingNote"}}</p>
        <ul class="pit-missing">{{#each missing as |m|}}<li>{{m}}</li>{{/each}}</ul>
        <button type="button" class="ui-btn" data-action="openImporter"><i class="fas fa-file-import"></i> {{localize "SDE.pitFighting.ui.openImporter"}}</button>
      </div>
      {{/if}}
    </section>

    {{!-- 2. THE TWIST: secret until revealed --}}
    {{#if hasOffer}}
    <section class="ui-card pit-stage">
      <div class="ui-card-head"><span class="ui-num">2</span><h3 class="ui-card-name">{{localize "SDE.pitFighting.ui.twist"}}</h3>{{#if hasTwist}}<span class="ui-chip gold" title="2d6">{{bout.twist.total}}</span>{{/if}}</div>
      {{#if twistRevealed}}
        <p class="pit-drawn">{{#if twistText}}{{twistText}}{{else}}<em>{{localize "SDE.pitFighting.ui.twistNotImported"}}</em>{{/if}}{{#if twistSub}} <em class="ui-muted">(1d4: {{twistSub}})</em>{{/if}}</p>
      {{else}}
        <div class="pit-pick">
          <button type="button" class="ui-icon" data-action="rollTwist" title="{{localize 'SDE.pitFighting.ui.reroll'}}"><i class="fas fa-dice"></i></button>
          <select data-twist-select aria-label="{{localize 'SDE.pitFighting.ui.chooseTwist'}}">
            <option value="">{{localize "SDE.pitFighting.ui.orPick"}}</option>
            {{#each twistOptions as |t|}}<option value="{{t.total}}" {{#if t.selected}}selected{{/if}}>{{t.range}} · {{#if t.text}}{{t.text}}{{else}}{{t.key}}{{/if}}</option>{{/each}}
          </select>
          <button type="button" class="ui-icon" data-action="revealTwist" title="{{localize 'SDE.pitFighting.ui.reveal'}}"><i class="fas fa-eye"></i></button>
        </div>
        <p class="ui-row-sub"><i class="fas fa-eye-slash"></i> {{#if twistIsNone}}{{localize "SDE.pitFighting.ui.hiddenNone"}}{{else}}{{localize "SDE.pitFighting.ui.hiddenWaiting"}}{{/if}}</p>
      {{/if}}
    </section>

    {{!-- 3. THE ANSWER --}}
    <section class="ui-card pit-stage {{#if undecided}}sel{{/if}}">
      <div class="ui-card-head"><span class="ui-num">3</span><h3 class="ui-card-name">{{localize "SDE.pitFighting.ui.whoStepsUp"}}</h3></div>
      {{#if declined}}<div class="ui-note"><i class="fas fa-hand"></i> {{localize "SDE.pitFighting.ui.declined"}}</div>{{/if}}
      {{#if hasParty}}
      <div class="ui-list">
        {{#each party as |p|}}
        <label class="ui-row">
          <input type="checkbox" data-fighter="{{p.id}}" {{#if p.checked}}checked{{/if}} {{#if ../accepted}}disabled{{/if}}>
          <span class="ui-row-main"><span class="ui-row-name">{{p.name}}</span></span>
          {{#if p.level}}<span class="ui-chip">{{localize "SDE.pitFighting.ui.levelShort" level=p.level}}</span>{{/if}}
          <span class="ui-chip gold" title="{{localize 'SDE.pitFighting.ui.currentRenown'}}"><i class="fas fa-crown"></i> {{p.renown}}</span>
        </label>
        {{/each}}
      </div>
      {{/if}}
    </section>

    {{!-- 4. THE RESULT --}}
    {{#if accepted}}
    <section class="ui-card pit-stage sel">
      <div class="ui-card-head"><span class="ui-num">4</span><h3 class="ui-card-name">{{localize "SDE.pitFighting.ui.result"}}</h3></div>
      <div class="ui-inline">
        <button type="button" class="ui-btn {{#if isWin}}pit-on{{/if}}" data-action="setOutcome" data-outcome="win"><i class="fas fa-trophy"></i> {{localize "SDE.pitFighting.ui.won"}}</button>
        <button type="button" class="ui-btn {{#if isLoss}}pit-on{{/if}}" data-action="setOutcome" data-outcome="loss"><i class="fas fa-skull"></i> {{localize "SDE.pitFighting.ui.lost"}}</button>
        <button type="button" class="ui-btn" data-action="rollPrize"><i class="fas fa-sack-dollar"></i> {{localize "SDE.pitFighting.ui.rollTable" table=bout.stakes.table}}</button>
      </div>
      {{#if prize}}<div class="ui-pair"><span class="ui-label">{{localize "SDE.pitFighting.ui.prize"}}</span><span class="ui-value pit-prize">{{prize}}</span></div>{{/if}}
      {{#if outcome}}
      <div class="ui-field">
        <label class="ui-label" for="pit-renown">{{localize "SDE.pitFighting.ui.renownEach"}}</label>
        <input id="pit-renown" class="ui-num-in" type="number" step="1" value="{{renownDelta}}" data-renown-delta aria-label="{{localize 'SDE.pitFighting.ui.renownEachTip'}}">
        <span class="ui-row-sub">{{localize "SDE.pitFighting.ui.renownNote"}}</span>
      </div>
      {{/if}}
    </section>
    {{/if}}
    {{/if}}
  </div>

  <footer class="ui-footer">
    {{#if hasOffer}}
      <button type="button" class="ui-btn ghost" data-action="clearBout">{{localize "SDE.pitFighting.ui.newOffer"}}</button>
      <div class="ui-right">
        {{#if undecided}}
          <button type="button" class="ui-btn" data-action="decline"><i class="fas fa-xmark"></i> {{localize "SDE.pitFighting.ui.decline"}}</button>
          <button type="button" class="ui-btn primary" data-action="accept" {{#unless fighterCount}}disabled{{/unless}}><i class="fas fa-check"></i> {{localize "SDE.pitFighting.ui.accept"}}</button>
        {{/if}}
        {{#if accepted}}
          <button type="button" class="ui-btn primary" data-action="applyResults" {{#unless canApply}}disabled{{/unless}}><i class="fas fa-check"></i> {{#if applied}}{{localize "SDE.pitFighting.ui.applied"}}{{else}}{{localize "SDE.pitFighting.ui.applyResult"}}{{/if}}</button>
        {{/if}}
      </div>
    {{else}}
      <div class="ui-right"><button type="button" class="ui-btn primary" data-action="rollOffer" {{#unless hasParty}}disabled{{/unless}}><i class="fas fa-dice"></i> {{localize "SDE.pitFighting.ui.rollOffer"}}</button></div>
    {{/if}}
  </footer>
</div>

<div class="sde-hxb">
  <div class="form-group">
    <label>Terrain</label>
    <div class="form-fields">
      <select data-hxb data-hxb-terrain>
        <option value="">(none)</option>
        {{#each terrainOptions as |o|}}<option value="{{o.value}}" {{#if o.selected}}selected{{/if}}>{{o.label}}</option>{{/each}}
        <option value="{{other}}">other…</option>
      </select>
    </div>
  </div>
  <div class="form-group">
    <div class="form-fields">
      <input type="text" data-hxb data-hxb-other placeholder="a word of your own" aria-label="Other terrain" hidden>
    </div>
  </div>
  <div class="form-group">
    <label>On the hex</label>
    <div class="form-fields sde-hxb-overlays">
      {{#each overlays as |o|}}
      <label><input type="checkbox" data-hxb data-hxb-overlay value="{{o.value}}" {{#if o.checked}}checked{{/if}}> {{o.value}}</label>
      {{/each}}
    </div>
  </div>
  <p class="sde-hxb-hint" data-hxb-hint></p>
  <footer class="sde-hxb-foot">
    <button type="button" data-action="hxbUndo" class="sde-import-secondary"><i class="fas fa-rotate-left"></i> Undo last stroke<span data-hxb-undo-count></span></button>
  </footer>
</div>

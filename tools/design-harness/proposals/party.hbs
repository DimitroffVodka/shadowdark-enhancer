<div class="sde-p2">
  <header class="sde-p2-head">
    {{#if isGM}}<button type="button" class="sde-p2-emblem" style="--c:#{{emblem.color}}" data-action="march" data-state="{{emblemState}}" title="{{localize 'SDE.party.proposed.emblem'}}" aria-label="{{localize 'SDE.party.proposed.emblem'}}"><img src="/modules/game-icons-net/whitetransparent/{{emblem.icon}}.svg" alt=""></button>{{else}}<span class="sde-p2-emblem" style="--c:#{{emblem.color}}"><img src="/modules/game-icons-net/whitetransparent/{{emblem.icon}}.svg" alt=""></span>{{/if}}
    <div class="sde-p2-id">
      <h2>{{actor.name}}</h2>
      <div class="sde-p2-stats">
        <span title="{{localize 'SDE.party.sheet.extras.tab.members'}}"><i class="fas fa-users"></i>{{memberCount}}</span>
        <span title="{{localize 'SDE.party.sheet.hp'}}"><i class="fas fa-heart"></i>{{partyStats.totalHp}}<small>/{{partyStats.maxHp}}</small></span>
        <span title="{{localize 'SDE.party.sheet.ac'}}"><i class="fas fa-shield-halved"></i>{{partyStats.avgAc}}</span>
        <span title="{{localize 'SDE.party.sheet.level'}}"><i class="fas fa-star"></i>{{partyStats.avgLevel}}</span>
      </div>
    </div>
    <div class="sde-p2-march">
      <div class="sde-p2-ctl">
        <label class="sde-p2-sw" title="{{localize 'SDE.party.movement.follow'}}"><input type="checkbox" data-movement-setting="followLeader" {{#unless off}}checked{{/unless}} {{#unless isGM}}disabled{{/unless}}><span class="track"></span><span class="t">{{localize "SDE.party.proposed.formation"}}</span></label>
        <div class="sde-p2-status {{#if paused}}warn{{/if}}"><span class="on"><i class="dot"></i>{{#if paused}}{{followStatus}}{{else}}{{leaderName}} {{localize "SDE.party.proposed.leads"}}{{/if}}{{#if paused}}{{#if isGM}} <button type="button" data-action="resumeFollow" class="sde-p2-mini">{{localize "SDE.party.movement.resume"}}</button>{{/if}}{{/if}}</span><span class="off">{{localize "SDE.party.proposed.free"}}</span></div>
      </div>
      <div class="sde-p2-gridwrap">
        <div class="sde-p2-grid" aria-label="{{localize 'SDE.party.proposed.formation'}}">
          {{#each slots}}<button type="button" class="sde-p2-slot{{#if leader}} leader{{/if}}" data-formation-slot data-row="{{row}}" data-col="{{col}}" {{#if img}}data-action="leader" draggable="true"{{/if}} {{#unless canEdit}}disabled{{/unless}} title="{{name}}" aria-label="{{name}}">{{#if img}}<img src="{{img}}" alt="">{{/if}}</button>{{/each}}
        </div>
        {{#if isGM}}<small class="sde-p2-drag">{{localize "SDE.party.proposed.drag"}}<br>{{localize "SDE.party.proposed.lead"}}</small>{{/if}}
      </div>
      {{#if isGM}}<button type="button" class="sde-p2-pin" data-action="placeRecall" title="{{localize 'SDE.party.movement.placeRecall'}}" aria-label="{{localize 'SDE.party.movement.placeRecall'}}"><i class="fas fa-location-dot"></i></button>{{/if}}
    </div>
    {{#if emblemOpen}}
    <div class="sde-p2-pop sde-p2-emblems">
      <h4>{{localize "SDE.party.proposed.emblem"}}</h4>
      <div class="icons">{{#each emblemIcons}}<button type="button" class="{{#if selected}}on{{/if}}" data-action="pick" data-state="{{state}}" title="{{name}}" aria-label="{{name}}"><img src="/modules/game-icons-net/whitetransparent/{{name}}.svg" alt=""></button>{{/each}}</div>
      <div class="colors">{{#each emblemColors}}<button type="button" class="{{#if selected}}on{{/if}}" style="--c:#{{c}}" data-action="pick" data-state="{{state}}" aria-label="#{{c}}"></button>{{/each}}</div>
    </div>
    {{/if}}
  </header>
  <div class="sde-p2-bar">
    {{#each today}}<div><span class="l"><i class="fas {{icon}}"></i>{{label}}</span><span class="v">{{value}}</span></div>{{/each}}
  </div>

  <nav class="sde-p2-tabs">{{#each tabs}}<a class="{{#if active}}active{{/if}}" data-action="partyTab" data-state="{{state}}" role="button" tabindex="0"><i class="{{icon}}"></i>{{label}}</a>{{/each}}</nav>

  <section class="sde-p2-body">
  {{#if membersTab}}
    {{#each groups}}{{#if rows.length}}
    <h3 class="sde-p2-group">{{label}}</h3>
    <div class="sde-p2-cards">
      {{#each rows}}
      <article class="sde-p2-card">
        <img class="sde-p2-face" src="{{img}}" alt="">
        <div class="sde-p2-main">
          <div class="sde-p2-line"><strong>{{name}}</strong><em>{{className}}</em>{{#each effects}}<img class="sde-p2-fx" src="{{img}}" title="{{name}}" alt="">{{/each}}</div>
          <div class="sde-p2-hp"><div class="sde-p2-hpbar" style="width:{{hpPercent}}%"></div><span>{{hp.value}} / {{hp.max}}</span></div>
          <div class="sde-p2-chips"><span><b>AC</b> {{ac}}</span>{{#unless isNPC}}<span><b>LV</b> {{level}}</span><span><b>SLOTS</b> {{slots.used}}/{{slots.max}}</span><span><b>XP</b> {{xp.current}}/{{xp.next}}</span>{{/unless}}</div>
          {{#unless isNPC}}<div class="sde-p2-abil">{{#each abil}}<span>{{k}} <b>{{v}}</b></span>{{/each}}</div>{{/unless}}
        </div>
      </article>
      {{/each}}
    </div>
    {{/if}}{{/each}}
  {{/if}}

  {{#if itemsTab}}
    <div class="sde-p2-two">
      <div class="sde-p2-box">
        <h3 class="sde-p2-boxhead"><span>{{localize "SDE.party.items"}}</span><small>{{localize "SDE.party.sheet.slots"}} {{inventorySlots.used}} / {{inventorySlots.max}}</small>{{#if isGM}}<a data-action="createItem" title="{{localize 'SDE.party.sheet.newItem'}}"><i class="fas fa-plus"></i></a>{{/if}}</h3>
        <ul class="sde-p2-list">
          {{#each items}}<li><img src="{{img}}" alt=""><span class="n">{{name}}</span><span class="q">{{#if ../isGM}}<a data-action="quantity" data-delta="-1"><i class="fas fa-minus"></i></a>{{/if}}{{quantity}}{{#if ../isGM}}<a data-action="quantity" data-delta="1"><i class="fas fa-plus"></i></a>{{/if}}</span><span class="s">{{slots}}</span></li>{{/each}}
        </ul>
      </div>
      <div class="sde-p2-col">
        <div class="sde-p2-box">
          <h3 class="sde-p2-boxhead"><span>{{localize "SDE.party.sheet.treasury"}}</span></h3>
          <div class="sde-p2-coins">{{#each coinList}}<label><span class="coin {{key}}"></span><input type="number" value="{{value}}" min="0" aria-label="{{label}}" {{#unless ../isGM}}disabled{{/unless}}><em>{{key}}</em></label>{{/each}}</div>
        </div>
        <div class="sde-p2-box">
          <h3 class="sde-p2-boxhead"><span>{{localize "SDE.party.proposed.gems"}}</span><small>{{gemTotal}} gp</small></h3>
          <ul class="sde-p2-list sde-p2-gems">
            {{#each gems}}<li><i class="fas fa-gem" style="color:{{color}}"></i><span class="n">{{name}}</span><span class="q">×{{quantity}}</span><span class="s">{{value}} gp</span></li>{{/each}}
          </ul>
        </div>
      </div>
    </div>
  {{/if}}

  {{#if bastionTab}}
    <div class="sde-p2-box sde-p2-bastion">
      <img class="art" src="{{bastion.art}}" alt="">
      <div class="info">
        <h3>{{bastion.name}}</h3>
        <p class="sub">{{bastion.type}}</p>
        <div class="sde-p2-chips"><span><b>AC</b> {{bastion.ac}}</span><span><b>HP</b> {{bastion.hp}}</span><span><b>{{localize "SDE.party.proposed.rooms"}}</b> {{bastion.rooms.length}} / {{bastion.slots}}</span><span><b>{{localize "SDE.party.proposed.treasury"}}</b> {{bastion.treasury}} gp</span></div>
        <div class="sde-p2-rooms">{{#each bastion.rooms}}<span><i class="fas {{icon}}"></i>{{name}}</span>{{/each}}</div>
        <p class="log"><span>{{localize "SDE.party.proposed.lastMonth"}}</span> {{bastion.lastMonth}}</p>
        <button type="button" data-action="openBastion" class="sde-p2-btn"><i class="fas fa-chess-rook"></i> {{#if isGM}}{{localize "SDE.party.proposed.manage"}}{{else}}{{localize "SDE.party.proposed.view"}}{{/if}}</button>
      </div>
    </div>
  {{/if}}

  {{#if otherTab}}<p class="sde-p2-note">{{localize "SDE.party.proposed.unchanged"}}</p>{{/if}}
  </section>
</div>

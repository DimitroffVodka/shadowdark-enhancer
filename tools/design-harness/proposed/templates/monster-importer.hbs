{{!-- Monster Importer, proposed. Same context and data attributes as templates/monster-importer.hbs. Cards are the hub's monster card:
      one row per attack, one row per feature, collapsed unless flagged (or first). --}}
<div class="ui-shell">
  <header class="ui-head">
    <div class="ui-art imp-art"><i class="fas fa-dragon"></i></div>
    <div class="ui-head-text"><h2 class="ui-title">{{localize "SDE.importer.monsterImporter.title"}}</h2><p class="ui-sub">{{localize "SDE.importer.ui.monsterSub"}}</p></div>
    <div class="ui-stats">
      <div class="ui-stat"><span class="ui-label">{{localize "SDE.importer.type.monsters"}}</span><span class="ui-value">{{total}}</span></div>
    </div>
  </header>

  <div class="ui-body">
    <section class="ui-card">
      <label class="ui-field" for="sde-mimport-source"><span class="ui-label">{{localize "SDE.importer.source.label"}}</span>
        <input id="sde-mimport-source" type="text" data-mimport-source list="sde-mimport-sources" value="{{source}}" placeholder="{{localize 'SDE.importer.monsterImporter.sourcePlaceholder'}}" aria-label="{{localize 'SDE.importer.monsterImporter.sourceAria'}}">
        <datalist id="sde-mimport-sources">{{#each sourceSuggestions as |s|}}<option value="{{s}}"></option>{{/each}}</datalist></label>
      <div class="ui-muted">{{localize "SDE.importer.monsterImporter.sourceHint"}}</div>
      <label class="ui-field" for="sde-mimport-text"><span class="ui-label">{{localize "SDE.importer.monsterImporter.pasteLabel"}}</span>
        <textarea id="sde-mimport-text" data-mimport-text rows="{{#if hasParsed}}4{{else}}10{{/if}}" placeholder="{{localize 'SDE.importer.ui.monsterPastePlaceholder'}}">{{text}}</textarea></label>
      <div class="ui-muted"><i class="fas fa-circle-info"></i> {{{localize "SDE.importer.monsterImporter.note"}}}</div>
    </section>

    {{#if skippedCount}}
    <details class="ui-details">
      <summary class="imp-sumlong"><i class="fas fa-filter-circle-xmark"></i> {{localize "SDE.importer.monsterImporter.skippedSummary" n=skippedCount}}</summary>
      <div class="ui-details-body"><ul class="imp-warnlist">{{#each skipped as |s|}}<li><strong>{{s.name}}</strong> {{s.reason}}</li>{{/each}}</ul></div>
    </details>
    {{/if}}

    {{#if hasParsed}}
    <section class="ui-group">
      <h3 class="ui-h"><span>{{localize "SDE.importer.type.monsters"}}</span><small>{{total}}</small></h3>
      {{#each monsters as |m|}}
      <details class="ui-details" data-monster-idx="{{m.idx}}"{{#if m.hasWarnings}} open{{else}}{{#if @first}} open{{/if}}{{/if}}>
        <summary><span class="imp-sumname">{{m.draft.name}}</span>
          <span class="ui-chip">{{localize "SDE.importer.monsters.lv"}} {{m.draft.level}}</span><span class="ui-chip">{{localize "SDE.importer.monsters.ac"}} {{m.draft.ac}}</span><span class="ui-chip">{{localize "SDE.importer.monsters.hp"}} {{m.draft.hp.value}}</span>
          {{#if m.hasWarnings}}<span class="ui-chip warn" title="{{localize 'SDE.importer.monsters.flaggedTip' n=m.warnCount}}"><i class="fas fa-triangle-exclamation"></i> {{m.warnCount}}</span>{{/if}}</summary>
        <div class="ui-details-body">
        <div class="ui-card-head">
          <input type="text" data-mimport-field="name" value="{{m.draft.name}}" class="imp-name" aria-label="{{localize 'SDE.importer.monsters.nameAria'}}" placeholder="{{localize 'SDE.importer.monsters.nameAria'}}">
          <div class="ui-card-actions"><button type="button" class="ui-icon danger" data-action="mimportRemoveMonster" aria-label="{{localize 'SDE.importer.monsters.removeAria'}}" title="{{localize 'SDE.importer.monsters.removeTip'}}"><i class="fas fa-xmark"></i></button></div>
        </div>
        {{#if m.hasWarnings}}<div class="ui-note warn"><ul class="imp-warnlist">{{#each m.warnings as |w|}}<li>{{w}}</li>{{/each}}</ul></div>{{/if}}
        <div class="imp-fields">
          <label class="ui-field"><span class="ui-label">{{localize "SDE.importer.monsters.lv"}}</span><input type="number" data-mimport-field="level" value="{{m.draft.level}}"{{#if m.warn.level}} class="imp-warn"{{/if}}></label>
          <label class="ui-field"><span class="ui-label">{{localize "SDE.importer.monsters.ac"}}</span><input type="number" data-mimport-field="ac" value="{{m.draft.ac}}"{{#if m.warn.ac}} class="imp-warn"{{/if}}></label>
          <label class="ui-field"><span class="ui-label">{{localize "SDE.importer.monsters.hp"}}</span><input type="number" data-mimport-field="hpValue" value="{{m.draft.hp.value}}"{{#if m.warn.hp}} class="imp-warn"{{/if}}></label>
          <label class="ui-field"><span class="ui-label">{{localize "SDE.importer.monsters.hpMaxAria"}}</span><input type="number" data-mimport-field="hpMax" value="{{m.draft.hp.max}}" aria-label="{{localize 'SDE.importer.monsters.hpMaxAria'}}"{{#if m.warn.hp}} class="imp-warn"{{/if}}></label>
          <label class="ui-field"><span class="ui-label">{{localize "SDE.importer.monsters.al"}}</span><select data-mimport-field="alignment"{{#if m.warn.alignment}} class="imp-warn"{{/if}}>{{#each @root.alignments as |a|}}<option value="{{a}}" {{#if (eq a m.draft.alignment)}}selected{{/if}}>{{a}}</option>{{/each}}</select></label>
          <label class="ui-field"><span class="ui-label">{{localize "SDE.importer.monsters.mv"}}</span><select data-mimport-field="move"{{#if m.warn.move}} class="imp-warn"{{/if}}>{{#each @root.moveOptions as |mv|}}<option value="{{mv}}" {{#if (eq mv m.draft.move)}}selected{{/if}}>{{mv}}</option>{{/each}}</select></label>
          <label class="ui-field span2"><span class="ui-label">{{localize "SDE.importer.monsters.moveNoteAria"}}</span><input type="text" data-mimport-field="moveNote" value="{{m.draft.moveNote}}" placeholder="{{localize 'SDE.importer.monsters.moveNote'}}" aria-label="{{localize 'SDE.importer.monsters.moveNoteAria'}}"></label>
        </div>
        <div class="imp-fields abil{{#if m.warn.abilities}} imp-warnrow{{/if}}">
          {{#each @root.abilityKeys as |ab|}}<label class="ui-field"><span class="ui-label">{{ab.label}}</span><input type="number" data-mimport-field="{{ab.key}}" value="{{lookup m.draft.abilities ab.key}}"></label>{{/each}}
        </div>
        <div class="imp-fields{{#if m.warn.spellcasting}} imp-warnrow{{/if}}">
          <label class="ui-field"><span class="ui-label">{{localize "SDE.importer.monsters.spellcasting"}}</span><select data-mimport-field="scAbility">{{#each @root.spellAbilities as |sa|}}<option value="{{sa.value}}" {{#if (eq sa.value m.draft.spellcasting.ability)}}selected{{/if}}>{{sa.label}}</option>{{/each}}</select></label>
          <label class="ui-field"><span class="ui-label">{{localize "SDE.importer.monsters.bonus"}}</span><input type="number" data-mimport-field="scBonus" value="{{m.draft.spellcasting.bonus}}"></label>
          <label class="ui-field"><span class="ui-label">{{localize "SDE.importer.monsters.spellsPerRound"}}</span><input type="number" data-mimport-field="scAttacks" value="{{m.draft.spellcasting.attacks}}"></label>
        </div>
        <div class="imp-rows{{#if m.warn.attacks}} imp-warnrow{{/if}}">
          <div class="imp-sechead"><span class="ui-label">{{localize "SDE.importer.monsters.attacks"}}</span>
            <button type="button" class="ui-icon" data-action="mimportAddAttack" title="{{localize 'SDE.importer.monsters.addAttack'}}" aria-label="{{localize 'SDE.importer.monsters.addAttack'}}"><i class="fas fa-plus"></i></button>
            <button type="button" class="ui-icon" data-action="mimportAddSpecial" title="{{localize 'SDE.importer.monsters.addSpecial'}}" aria-label="{{localize 'SDE.importer.monsters.addSpecial'}}"><i class="fas fa-bolt"></i></button></div>
          {{#if m.draft.actions.length}}
          <div class="imp-attack head"><span class="ui-label">{{localize "SDE.importer.monsters.attackCountTip"}}</span><span class="ui-label">{{localize "SDE.importer.common.nameCap"}}</span><span class="ui-label">{{localize "SDE.importer.monsters.attackTypeAria"}}</span><span class="ui-label">{{localize "SDE.importer.monsters.toHitTip"}}</span><span class="ui-label">{{localize "SDE.importer.monsters.damageAria"}}</span><span class="ui-label">{{localize "SDE.importer.monsters.rangesAria"}}</span><span class="ui-label">{{localize "SDE.importer.monsters.riderAria"}}</span><span></span></div>
          {{/if}}
          {{#each m.draft.actions as |a|}}
          <div class="imp-attack{{#if a.flagged}} imp-warnrow{{/if}}" data-attack-idx="{{@index}}">
            <input type="number" data-mimport-field="aNum" value="{{a.num}}" aria-label="{{localize 'SDE.importer.monsters.attackCountAria'}}" title="{{localize 'SDE.importer.monsters.attackCountTip'}}">
            <input type="text" data-mimport-field="aName" value="{{a.name}}" aria-label="{{localize 'SDE.importer.monsters.attackNameAria'}}" placeholder="{{localize 'SDE.importer.common.name'}}">
            <select data-mimport-field="aType" aria-label="{{localize 'SDE.importer.monsters.attackTypeAria'}}">{{#each @root.attackTypes as |ty|}}<option value="{{ty}}" {{#if (eq ty a.type)}}selected{{/if}}>{{ty}}</option>{{/each}}</select>
            <input type="number" data-mimport-field="aBonus" value="{{a.bonus}}" aria-label="{{localize 'SDE.importer.monsters.toHitAria'}}" title="{{localize 'SDE.importer.monsters.toHitTip'}}">
            <input type="text" data-mimport-field="aDamage" value="{{a.damage}}" aria-label="{{localize 'SDE.importer.monsters.damageAria'}}" placeholder="1d6">
            <input type="text" data-mimport-field="aRanges" value="{{join a.ranges}}" aria-label="{{localize 'SDE.importer.monsters.rangesAria'}}" placeholder="{{localize 'SDE.importer.monsters.rangesPlaceholder'}}">
            <input type="text" data-mimport-field="aDesc" value="{{a.description}}" aria-label="{{localize 'SDE.importer.monsters.riderAria'}}" placeholder="{{localize 'SDE.importer.monsters.riderPlaceholder'}}">
            <button type="button" class="ui-icon danger" data-action="mimportRemoveAttack" aria-label="{{localize 'SDE.importer.monsters.removeAttackAria'}}"><i class="fas fa-xmark"></i></button>
          </div>
          {{/each}}
        </div>
        <div class="imp-rows">
          <div class="imp-sechead"><span class="ui-label">{{localize "SDE.importer.monsters.features"}}</span>
            <button type="button" class="ui-icon" data-action="mimportAddFeature" title="{{localize 'SDE.importer.monsters.addFeature'}}" aria-label="{{localize 'SDE.importer.monsters.addFeature'}}"><i class="fas fa-plus"></i></button></div>
          {{#each m.draft.features as |f|}}
          <div class="imp-feature" data-feature-idx="{{@index}}">
            <input type="text" data-mimport-field="fName" value="{{f.name}}" aria-label="{{localize 'SDE.importer.monsters.featureNameAria'}}" placeholder="{{localize 'SDE.importer.common.name'}}">
            <input type="text" data-mimport-field="fDesc" value="{{f.description}}" aria-label="{{localize 'SDE.importer.monsters.featureTextAria'}}" placeholder="{{localize 'SDE.importer.common.description'}}">
            <button type="button" class="ui-icon danger" data-action="mimportRemoveFeature" aria-label="{{localize 'SDE.importer.monsters.removeFeatureAria'}}"><i class="fas fa-xmark"></i></button>
          </div>
          {{/each}}
        </div>
        </div>
      </details>
      {{/each}}
    </section>
    {{else}}
    <div class="ui-empty"><i class="fas fa-dragon"></i><span>{{{localize "SDE.importer.monsterImporter.empty"}}}</span></div>
    {{/if}}
  </div>

  <footer class="ui-footer">
    <button type="button" class="ui-btn ghost" data-action="mimportClear"><i class="fas fa-eraser"></i> {{localize "SDE.importer.btn.clear"}}</button>
    <button type="button" class="ui-btn ghost" data-action="mimportSpellLibrary" title="{{localize 'SDE.importer.monsterImporter.spellLibraryTip'}}"><i class="fas fa-book-sparkles"></i> {{localize "SDE.importer.monsterImporter.spellLibrary"}}</button>
    <div class="ui-right">
      <button type="button" class="ui-btn{{#unless hasParsed}} primary sde-import-primary{{/unless}}" data-action="mimportParse"><i class="fas fa-wand-magic"></i> {{localize "SDE.importer.btn.parse"}}</button>
      {{#if hasParsed}}<button type="button" class="ui-btn primary sde-import-primary" data-action="mimportCreateAll"><i class="fas fa-dragon"></i> {{localize "SDE.importer.monsterImporter.createAll" n=total}}</button>{{/if}}
    </div>
  </footer>
</div>

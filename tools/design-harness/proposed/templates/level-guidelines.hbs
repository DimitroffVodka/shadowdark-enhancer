{{!-- Level guidelines editor, proposed. Same context (rows), data-level / data-field / data-action as templates/level-guidelines.hbs. --}}
<div class="ui-shell sde-lg">
  <header class="ui-head">
    <div class="ui-art lg-art"><i class="fa-solid fa-scale-balanced"></i></div>
    <div class="ui-head-text"><h2 class="ui-title">{{localize "SDE.settings.levelGuidelines.title"}}</h2></div>
  </header>
  <div class="ui-body">
    <div class="ui-note info">{{localize "SDE.settings.levelGuidelines.intro"}} {{localize "SDE.settings.levelGuidelines.hpNote"}}</div>
    <div class="ui-inline">
      <button type="button" class="ui-btn" data-action="lg-recalc" title="{{localize 'SDE.settings.levelGuidelines.recalcHint'}}"><i class="fa-solid fa-arrows-rotate"></i> {{localize "SDE.settings.levelGuidelines.recalc"}}</button>
      <button type="button" class="ui-btn" data-action="lg-reset"><i class="fa-solid fa-rotate-left"></i> {{localize "SDE.settings.levelGuidelines.reset"}}</button>
      <button type="button" class="ui-btn" data-action="lg-export"><i class="fa-solid fa-file-export"></i> {{localize "SDE.settings.levelGuidelines.export"}}</button>
      <button type="button" class="ui-btn" data-action="lg-import"><i class="fa-solid fa-file-import"></i> {{localize "SDE.settings.levelGuidelines.import"}}</button>
    </div>
    <div class="ui-card sde-lg-list lg-list">
      <table class="ui-table lg-table">
      <colgroup><col><col><col><col><col><col><col><col><col><col></colgroup>
        <thead>
          <tr class="lg-groups">
            <th colspan="3" aria-hidden="true"></th>
            <th colspan="3" class="lg-group">{{localize "SDE.settings.levelGuidelines.col.attack"}}</th>
            <th colspan="3" class="lg-group">{{localize "SDE.settings.levelGuidelines.col.statMod"}}</th>
            <th aria-hidden="true"></th>
          </tr>
          <tr class="lg-cols">
            <th>{{localize "SDE.settings.levelGuidelines.col.level"}}</th><th>{{localize "SDE.settings.levelGuidelines.col.ac"}}</th><th>{{localize "SDE.settings.levelGuidelines.col.hp"}}</th>
            <th>{{localize "SDE.settings.levelGuidelines.col.num"}}</th><th>{{localize "SDE.settings.levelGuidelines.col.bonus"}}</th><th>{{localize "SDE.settings.levelGuidelines.col.damage"}}</th>
            <th>{{localize "SDE.settings.levelGuidelines.col.median"}}</th><th>{{localize "SDE.settings.levelGuidelines.col.low"}}</th><th>{{localize "SDE.settings.levelGuidelines.col.high"}}</th>
            <th>{{localize "SDE.settings.levelGuidelines.col.talentDC"}}</th>
          </tr>
        </thead>
        <tbody>
          {{#each rows}}
          <tr data-level="{{this.level}}">
            <td class="lg-level">{{this.level}}</td>
            <td><input type="number" data-field="ac" value="{{this.ac}}" aria-label="{{localize 'SDE.settings.levelGuidelines.aria.ac' level=this.level}}"></td>
            <td><input type="number" data-field="hp" value="{{this.hp}}" min="1" aria-label="{{localize 'SDE.settings.levelGuidelines.aria.hp' level=this.level}}"></td>
            <td><input type="number" data-field="num" value="{{this.num}}" min="1" aria-label="{{localize 'SDE.settings.levelGuidelines.aria.num' level=this.level}}"></td>
            <td><input type="number" data-field="bonus" value="{{this.bonus}}" aria-label="{{localize 'SDE.settings.levelGuidelines.aria.bonus' level=this.level}}"></td>
            <td><input type="text" class="sde-lg-die" data-field="damage" value="{{this.damage}}" aria-label="{{localize 'SDE.settings.levelGuidelines.aria.damage' level=this.level}}"></td>
            <td><input type="number" data-field="median" value="{{this.median}}" aria-label="{{localize 'SDE.settings.levelGuidelines.aria.median' level=this.level}}"></td>
            <td><input type="number" data-field="low" value="{{this.low}}" aria-label="{{localize 'SDE.settings.levelGuidelines.aria.low' level=this.level}}"></td>
            <td><input type="number" data-field="high" value="{{this.high}}" aria-label="{{localize 'SDE.settings.levelGuidelines.aria.high' level=this.level}}"></td>
            <td><input type="number" data-field="talentDC" value="{{this.talentDC}}" aria-label="{{localize 'SDE.settings.levelGuidelines.aria.talentDC' level=this.level}}"></td>
          </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  </div>
  <footer class="ui-footer">
    <button type="button" class="ui-btn ghost" data-action="lg-cancel"><i class="fa-solid fa-xmark"></i> {{localize "SDE.settings.levelGuidelines.cancel"}}</button>
    <div class="ui-right"><button type="submit" class="ui-btn primary"><i class="fa-solid fa-floppy-disk"></i> {{localize "SDE.settings.levelGuidelines.save"}}</button></div>
  </footer>
</div>

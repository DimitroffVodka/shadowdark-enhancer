<div class="cbu-step split cbu-gear">
  <h2 class="ui-h">{{localize "SDE.charBuilder.step.gear"}} <small>{{localize "SDE.charBuilder.gear.remaining"}}: {{step.remaining}}</small></h2>

  <div class="cbu-split cbu-3col">
    <div class="cbu-gear-left">
      <div class="ui-seg cbu-gear-cats">
        {{#each step.categories}}<button type="button" class="ui-btn ghost{{#if active}} on{{/if}}" data-cb-gear-cat="{{key}}">{{label}}</button>{{/each}}
      </div>
      {{> sde-cb-list step.list}}
    </div>

    <div class="sde-cb-col-detail cbu-main">
      {{#if step.hasSelection}}
      <section class="ui-card">
        <div class="ui-card-head">
          <img class="cbu-banner-img" src="{{step.detail.img}}" alt="">
          <h3 class="ui-card-name">{{step.detail.name}}</h3>
          <button type="button" class="ui-btn" data-cb-add-gear><i class="fa-solid fa-plus"></i> {{localize "SDE.charBuilder.gear.add"}}{{#if step.detail.inCart}} ({{step.detail.inCart}}){{/if}}</button>
        </div>
        <div class="ui-inline">
          <span class="ui-chip">{{localize "SDE.charBuilder.gear.type"}}: {{step.detail.type}}</span>
          <span class="ui-chip">{{localize "SDE.charBuilder.gear.cost"}}: {{step.detail.cost}}</span>
          <span class="ui-chip">{{localize "SDE.charBuilder.gear.slots"}}: {{step.detail.slots}}</span>
          {{#each step.detail.stats}}<span class="ui-chip">{{label}}: {{value}}</span>{{/each}}
          {{#if step.detail.magic}}<span class="ui-chip gold">{{localize "SDE.charBuilder.gear.magic"}}</span>{{/if}}
        </div>
        <div class="cbu-desc">{{{step.detail.description}}}</div>
      </section>
      {{else}}
      <div class="ui-empty"><i class="fa-solid fa-hand-pointer"></i><span>{{localize "SDE.charBuilder.gear.browse"}}</span></div>
      {{/if}}
    </div>

    <aside class="cbu-col-aside cbu-main">
      <section class="ui-card">
        <div class="ui-card-head"><h3 class="ui-card-name">{{localize "SDE.charBuilder.gear.pack"}}</h3></div>
        <div class="ui-pairs cbu-gear-budget">
          <div class="ui-pair"><span class="ui-label">{{localize "SDE.charBuilder.gear.remaining"}}</span><span class="ui-value{{#if step.overBudget}} is-damaged{{/if}}">{{step.remaining}}</span></div>
          <div class="ui-pair"><span class="ui-label">{{localize "SDE.charBuilder.gear.carry"}}</span><span class="ui-value{{#if step.overSlots}} is-damaged{{/if}}">{{step.slotsUsed}} / {{step.slotLimit}}</span></div>
        </div>
        {{#if step.cartEmpty}}
        <div class="ui-empty"><i class="fa-solid fa-bag-shopping"></i><span>{{localize "SDE.charBuilder.gear.empty"}}</span></div>
        {{else}}
        <div class="ui-list cbu-cart">
          {{#each step.cart}}
          <div class="ui-row cbu-cart-row">
            <span class="ui-chip">{{qty}}&times;</span>
            <span class="ui-row-main"><span class="ui-row-name">{{name}}{{#if magic}} <i class="fa-solid fa-wand-sparkles" title="{{localize 'SDE.charBuilder.gear.magicTip'}}"></i>{{/if}}</span></span>
            <button type="button" class="ui-icon" data-cb-add-one="{{key}}" title="{{localize 'SDE.charBuilder.gear.addTip'}}"><i class="fa-solid fa-plus"></i></button>
            <button type="button" class="ui-icon" data-cb-remove-gear="{{key}}" title="{{localize 'SDE.charBuilder.gear.removeTip'}}"><i class="fa-solid fa-minus"></i></button>
          </div>
          {{/each}}
        </div>
        {{/if}}
      </section>
    </aside>
  </div>
</div>

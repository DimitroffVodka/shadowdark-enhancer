<div class="cbu-step split cbu-anc is-class">
  <h2 class="ui-h">{{localize "SDE.charBuilder.step.class"}} <small>{{#if step.hasSelection}}{{step.detail.name}}{{/if}}</small></h2>

  <div class="cbu-split">
    {{> sde-cb-list step.list}}

    <div class="sde-cb-anc-main cbu-main">
      {{#if step.readOnly}}<div class="ui-note"><i class="fa-solid fa-lock"></i> {{localize "SDE.charBuilder.existing.classHint"}}</div>{{/if}}
      {{#if step.hasSelection}}
      <div class="ui-cols-2 cbu-class-cols">

        {{!-- Left: what the class is --}}
        <div class="ui-stack">
          <section class="ui-card">
            <div class="cbu-detail{{#if step.detail.hasPortrait}} with-portrait{{/if}}">
              <div class="cbu-desc">{{{step.detail.description}}}</div>
              {{#if step.detail.hasPortrait}}<img class="cbu-portrait" src="{{step.detail.img}}" alt="{{step.detail.name}}">{{/if}}
            </div>
            <div class="ui-pairs">
              {{#each step.infoLines}}<div class="ui-pair"><span class="ui-label">{{label}}</span><span class="ui-value">{{value}}</span></div>{{/each}}
            </div>
          </section>
          {{#if step.traits.length}}
          <section class="ui-card">
            <div class="ui-card-head"><h3 class="ui-card-name">{{localize "SDE.charBuilder.preview.features"}}</h3></div>
            <div class="ui-list">
              {{#each step.traits}}
              <div class="ui-row cbu-anc-trait"><div class="ui-row-main"><span class="ui-row-name">{{name}}{{#if asksOnCreate}} <span class="ui-chip gold" title="{{localize 'SDE.charBuilder.class.asksOnCreateHint'}}"><i class="fa-solid fa-circle-question"></i> {{localize "SDE.charBuilder.class.asksOnCreate"}}</span>{{/if}}</span><span class="ui-row-sub">{{{descInline}}}</span></div></div>
              {{/each}}
            </div>
          </section>
          {{/if}}
        </div>

        {{!-- Right: what you choose, folded; sections that need an answer are open --}}
        <div class="ui-stack">
          {{#if step.choices.length}}
          <details class="ui-details cbu-subpanel" open>
            <summary>{{localize "SDE.charBuilder.class.talentChoices"}}</summary>
            <div class="ui-details-body">
              {{#each step.choices}}
              <div class="ui-field cbu-talent-choice{{#unless chosen}} pending{{/unless}}">
                <span class="ui-label">{{talentName}} {{#unless chosen}}<i class="fa-solid fa-triangle-exclamation" title="{{localize 'SDE.charBuilder.class.choiceNeeded'}}"></i>{{/unless}}</span>
                <select data-cb-talent-choice="{{key}}"><option value="">{{localize "SDE.charBuilder.chooseOption"}}</option>{{#each options}}<option value="{{slug}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
              </div>
              {{/each}}
            </div>
          </details>
          {{/if}}

          {{#if step.bonusRolls.length}}
          <details class="ui-details cbu-subpanel">
            <summary>{{localize "SDE.charBuilder.class.bonusRolls"}}</summary>
            <div class="ui-details-body">
              {{#each step.bonusRolls}}
              <div class="ui-card raised cbu-bonus-roll">
                <div class="ui-card-head">
                  <span class="ui-card-name">{{label}}{{#if tableName}} <small class="ui-muted">({{tableName}})</small>{{/if}}</span>
                  {{#if rolled}}{{#if canReroll}}<button type="button" class="ui-btn" data-cb-roll-bonus="{{key}}"><i class="fa-solid fa-dice"></i> {{localize "SDE.charBuilder.class.rerollTalent"}}</button>{{/if}}
                  {{else}}<button type="button" class="ui-btn" data-cb-roll-bonus="{{key}}"><i class="fa-solid fa-dice"></i> {{localize "SDE.charBuilder.class.bonusRollBtn"}}</button>{{/if}}
                </div>
                {{#if rolled}}
                  {{#if needsChoice}}
                  <div class="ui-note warn">{{localize "SDE.charBuilder.class.chooseOne"}}</div>
                  <div class="ui-inline">{{#each options}}<span class="ui-chip{{#if selected}} sel{{/if}}" data-cb-bonus-opt="{{uuid}}" data-cb-bonus-key="{{../key}}">{{name}}</span>{{/each}}</div>
                  {{else}}
                    {{#if chosenName}}<div class="cbu-talent-result"><i class="fa-solid fa-star"></i> <b>{{chosenName}}</b></div>{{#if chosenDesc}}<div class="cbu-talent-desc">{{{chosenDesc}}}</div>{{/if}}
                    {{else}}{{#if textResult}}<div class="cbu-talent-result"><i class="fa-solid fa-star"></i> <b>{{textResult}}</b></div><span class="ui-muted">{{localize "SDE.charBuilder.class.talentManual"}}</span>{{/if}}{{/if}}
                  {{/if}}
                  {{#if duplicate}}<div class="ui-note warn">{{localize "SDE.charBuilder.class.duplicateReroll"}}</div>{{else}}{{#unless canReroll}}<span class="ui-muted">{{localize "SDE.charBuilder.class.bonusLocked"}}</span>{{/unless}}{{/if}}
                {{else}}<span class="ui-muted">{{localize "SDE.charBuilder.class.bonusRollPrompt"}}</span>{{/if}}
              </div>
              {{/each}}
            </div>
          </details>
          {{/if}}

          {{#if step.talent.hasTable}}
          <details class="ui-details cbu-subpanel">
            <summary>{{localize "SDE.charBuilder.class.talent"}} {{#if step.talent.rolled}}<span class="ui-chip">2d6 = {{step.talent.total}}</span>{{/if}}</summary>
            <div class="ui-details-body">
              <div class="ui-inline">
                {{#if step.talent.canRoll}}<button type="button" class="ui-btn" data-cb-roll-talent><i class="fa-solid fa-dice"></i> {{#if step.talent.rolled}}{{localize "SDE.charBuilder.class.rerollTalent"}}{{else}}{{localize "SDE.charBuilder.class.rollTalent"}}{{/if}}</button>
                {{else}}<span class="ui-muted"><i class="fa-solid fa-lock"></i> {{localize "SDE.charBuilder.lockedRoll"}}</span>{{/if}}
              </div>
              {{#if step.talent.table}}
              <table class="ui-table cbu-talent-table"><thead><tr><th>2d6</th><th>{{localize "SDE.charBuilder.class.tableEffect"}}</th></tr></thead><tbody>{{#each step.talent.table}}<tr><td class="rng">{{range}}</td><td>{{outcome}}</td></tr>{{/each}}</tbody></table>
              {{/if}}
              {{#if step.talent.rolled}}
                {{#if step.talent.needsChoice}}
                <div class="ui-note warn">{{localize "SDE.charBuilder.class.chooseOne"}}</div>
                <div class="ui-inline">{{#each step.talent.options}}<span class="ui-chip{{#if selected}} sel{{/if}}" data-cb-talent-opt="{{uuid}}">{{name}}</span>{{/each}}</div>
                {{else}}
                  {{#if step.talent.chosenName}}<div class="cbu-talent-result"><i class="fa-solid fa-star"></i> <b>{{step.talent.chosenName}}</b></div>
                  {{else}}{{#if step.talent.textResult}}<div class="cbu-talent-result"><i class="fa-solid fa-star"></i> <b>{{step.talent.textResult}}</b></div><span class="ui-muted">{{localize "SDE.charBuilder.class.talentManual"}}</span>
                  {{else}}<div class="ui-note warn">{{localize "SDE.charBuilder.class.noTalentRolled"}}</div>{{/if}}{{/if}}
                {{/if}}
              {{else}}<span class="ui-muted">{{localize "SDE.charBuilder.class.rollPrompt"}}</span>{{/if}}
            </div>
          </details>
          {{/if}}

          {{#if step.spells.caster}}
          <details class="ui-details cbu-subpanel" open>
            <summary>{{localize "SDE.charBuilder.class.spells"}} <span class="ui-muted">({{step.spells.ability}})</span></summary>
            <div class="ui-details-body">
              {{#each step.spells.tiers}}
              <div class="ui-group cbu-spell-tier">
                <span class="ui-label">{{localize "SDE.charBuilder.class.tier"}} {{tier}} &mdash; {{localize "SDE.charBuilder.class.choose"}} {{count}} <span class="ui-chip {{#if full}}ok{{else}}warn{{/if}}">{{chosen}}/{{count}}</span></span>
                <div class="ui-inline cbu-spell-list">
                  {{#each options}}
                  <span class="cbu-spell-row{{#if expanded}} expanded{{/if}}">
                    <span class="ui-chip{{#if selected}} sel{{/if}}" data-cb-spell="{{uuid}}">{{name}}</span><button type="button" class="ui-icon cbu-spell-expand" data-cb-spell-expand="{{uuid}}" title="{{localize 'SDE.charBuilder.class.spellPreview'}}"><i class="fa-solid fa-chevron-{{#if expanded}}up{{else}}down{{/if}}"></i></button>
                  </span>
                  {{/each}}
                </div>
                {{#each options}}{{#if expanded}}{{#if detail}}
                <div class="ui-note info cbu-spell-detail"><b>{{name}}</b> &middot; {{localize "SDE.charBuilder.class.tier"}} {{detail.tier}} &middot; {{localize "SDE.charBuilder.class.spellRange"}}: {{detail.range}} &middot; {{localize "SDE.charBuilder.class.spellDuration"}}: {{detail.duration}}<div class="cbu-desc">{{{detail.description}}}</div></div>
                {{/if}}{{/if}}{{/each}}
              </div>
              {{/each}}
            </div>
          </details>
          {{/if}}

          {{#if step.patron.required}}
          <details class="ui-details cbu-subpanel">
            <summary>{{localize "SDE.charBuilder.class.patron"}} {{#if step.patron.chosenName}}<span class="ui-chip sel">{{step.patron.chosenName}}</span>{{/if}}</summary>
            <div class="ui-details-body">
              <span class="ui-muted">{{localize "SDE.charBuilder.class.patronPrompt"}} {{#if step.patron.startingBoons}}({{step.patron.startingBoons}} {{localize "SDE.charBuilder.class.boons"}}){{/if}}</span>
              <div class="ui-inline">{{#each step.patron.options}}<span class="ui-chip{{#if selected}} sel{{/if}}" data-cb-patron="{{uuid}}">{{name}}</span>{{/each}}</div>
            </div>
          </details>
          {{/if}}

          <details class="ui-details cbu-subpanel" data-cb-class-langs open>
            <summary>{{localize "SDE.charBuilder.step.languages"}}</summary>
            <div class="ui-details-body">{{> sde-cb-languages step=step.languages}}</div>
          </details>
        </div>
      </div>
      {{else}}
      {{#unless step.readOnly}}<div class="ui-empty"><i class="fa-solid fa-hand-pointer"></i><span>{{localize "SDE.charBuilder.selectPrompt"}}</span></div>{{/unless}}
      {{/if}}
    </div>
  </div>
</div>

{{!-- Roll Tables, proposed. Same context, tabs (data-thtab) and data attributes as templates/table-hub.hbs. --}}
<div class="ui-shell sde-thub">
  <header class="ui-head">
    <div class="ui-art imp-art"><i class="fas fa-table-list"></i></div>
    <div class="ui-head-text"><h2 class="ui-title">{{localize "SDE.importer.tableHub.title"}}</h2><p class="ui-sub">{{localize "SDE.importer.ui.tableSub"}}</p></div>
    <div class="ui-stats">
      <div class="ui-stat"><span class="ui-label">{{localize "SDE.importer.manage.showAll"}}</span><span class="ui-value">{{summary.total}}</span></div>
      <div class="ui-stat"><span class="ui-label">{{localize "SDE.importer.manage.imported"}}</span><span class="ui-value">{{summary.imported}}</span></div>
      <div class="ui-stat"><span class="ui-label">{{localize "SDE.importer.tableHub.missing"}}</span><span class="ui-value">{{summary.missing}}</span></div>
    </div>
  </header>

  <nav class="ui-tabs sde-thub-tabs">
    <button type="button" class="ui-tab item{{#if tabDashboard}} active{{/if}}" data-thtab="dashboard">{{localize "SDE.importer.tableHub.tabDashboard"}}</button>
    <button type="button" class="ui-tab item{{#if tabImport}} active{{/if}}" data-thtab="import">{{localize "SDE.importer.btn.import"}}</button>
  </nav>

  {{!-- ═══ Dashboard tab ═══ --}}
  <div class="ui-body sde-thub-tab"{{#unless tabDashboard}} hidden{{/unless}}>
    <div class="imp-toolbar">
      <div class="ui-search imp-search"><i class="fas fa-magnifying-glass"></i><input type="text" name="thubSearch" placeholder="{{localize 'SDE.importer.tableHub.searchPlaceholder'}}" value="{{search}}"></div>
      <button type="button" class="ui-icon" data-action="refresh" title="{{localize 'SDE.importer.tableHub.recheckTip'}}" aria-label="{{localize 'SDE.importer.tableHub.recheck'}}"><i class="fas fa-rotate"></i></button>
    </div>
    <div class="ui-inline">
      <button type="button" class="ui-chip{{#if fAll}} sel{{/if}}" data-action="filter" data-state="all" title="{{localize 'SDE.importer.tableHub.showAllTip'}}"><i class="fas fa-table-list"></i> {{localize "SDE.importer.tableHub.statTotal" n=summary.total}}</button>
      <button type="button" class="ui-chip{{#if fSystem}} sel{{/if}}" data-action="filter" data-state="system" title="{{localize 'SDE.importer.tableHub.showSystemTip'}}"><i class="fas fa-box-archive imp-ok"></i> {{localize "SDE.importer.tableHub.statSystem" n=summary.system}}</button>
      <button type="button" class="ui-chip{{#if fImported}} sel{{/if}}" data-action="filter" data-state="imported" title="{{localize 'SDE.importer.tableHub.showImportedTip'}}"><i class="fas fa-file-import"></i> {{localize "SDE.importer.tableHub.statImported" n=summary.imported}}</button>
      {{#if summary.partial}}<button type="button" class="ui-chip{{#if fPartial}} sel{{/if}}" data-action="filter" data-state="partial" title="{{localize 'SDE.importer.tableHub.showPartialTip'}}"><i class="fas fa-circle-half-stroke imp-warnic"></i> {{localize "SDE.importer.tableHub.statPartial" n=summary.partial}}</button>{{/if}}
      <button type="button" class="ui-chip{{#if fMissing}} sel{{/if}}" data-action="filter" data-state="missing" title="{{localize 'SDE.importer.tableHub.showMissingTip'}}"><i class="fas fa-circle-exclamation imp-warnic"></i> {{localize "SDE.importer.tableHub.statMissing" n=summary.missing}}</button>
    </div>
    <div class="ui-inline">
      <span class="ui-label">{{localize "SDE.importer.source.label"}}</span>
      <button type="button" class="ui-chip{{#if sourceAll}} sel{{/if}}" data-action="filterSource" data-source="all">{{localize "SDE.importer.manage.showAll"}}</button>
      {{#each sources as |s|}}
      <button type="button" class="ui-chip{{#if s.active}} sel{{/if}}{{#unless s.count}} off{{/unless}}" data-action="filterSource" data-source="{{s.id}}" title="{{localize 'SDE.importer.tableHub.filterSourceTip' label=s.label}}">{{s.label}} <span class="ui-muted">{{s.count}}</span></button>
      {{/each}}
    </div>

    {{#each groups as |g|}}
    <details class="ui-details sde-thub-cat" open>
      <summary>{{g.category}} <span class="ui-count imp-count">{{g.count}}</span></summary>
      <div class="ui-details-body">
        {{#each g.subgroups as |sg|}}
        <div class="ui-group sde-thub-sub">
          <h4 class="ui-h plain"><span>{{sg.sub}}</span><small>{{sg.rows.length}}</small></h4>
          <div class="ui-list">
            {{#each sg.rows as |r|}}
            <div class="ui-row sde-thub-row state-{{r.state}}{{#if r.uuid}} sde-thub-openable{{/if}}" data-search="{{r.searchKey}}"{{#if r.uuid}} data-uuid="{{r.uuid}}" title="{{localize 'SDE.importer.tableHub.openTip'}}"{{/if}}>
              <div class="ui-row-main"><span class="ui-row-name">{{r.name}}</span>
                <span class="ui-row-sub">{{localize "SDE.importer.tableHub.page" page=r.page}} &middot; {{r.die}}{{#if r.sourceShort}} &middot; {{r.sourceShort}}{{/if}}{{#if r.worldName}} &middot; &rarr; {{r.worldName}}{{/if}}</span></div>
              {{#if r.isMatrix}}
                <span class="ui-tag" title="{{localize 'SDE.importer.tableHub.matrixTip' n=r.columnsTotal}}">{{r.splitLabel}}</span>
                {{#if r.isImported}}<span class="ui-chip ok"><i class="fas fa-check"></i> {{localize "SDE.importer.tableHub.allImported" n=r.columnsTotal}}</span>{{/if}}
                {{#if r.isPartial}}<span class="ui-chip warn"><i class="fas fa-circle-half-stroke"></i> {{localize "SDE.importer.tableHub.partialImported" present=r.columnsPresent total=r.columnsTotal}}</span>
                  <button type="button" class="ui-btn" data-action="importMissing" data-id="{{r.id}}" title="{{localize 'SDE.importer.tableHub.repasteTip'}}"><i class="fas fa-file-import"></i> {{localize "SDE.importer.btn.import"}}</button>{{/if}}
                {{#if r.isMissing}}<span class="ui-chip warn"><i class="fas fa-circle-exclamation"></i> {{localize "SDE.importer.tableHub.missing"}}</span>
                  <button type="button" class="ui-btn" data-action="importMissing" data-id="{{r.id}}" title="{{localize 'SDE.importer.tableHub.pasteGridTip' n=r.columnsTotal}}"><i class="fas fa-file-import"></i> {{localize "SDE.importer.tableHub.importAllN" n=r.columnsTotal}}</button>{{/if}}
              {{else}}
                {{#if r.isSystem}}<span class="ui-chip ok"><i class="fas fa-box-archive"></i> {{localize "SDE.importer.tableHub.inSystem"}}</span>{{/if}}
                {{#if r.isImported}}<span class="ui-chip"><i class="fas fa-check"></i> {{localize "SDE.importer.manage.imported"}}</span>
                  {{#if r.rowsExpected}}<span class="ui-tag{{#unless r.verifyOk}} imp-warnic{{/unless}}" title="{{localize 'SDE.importer.tableHub.rowsTip' actual=r.rowsActual expected=r.rowsExpected}}">{{localize "SDE.importer.tableHub.rowsCount" actual=r.rowsActual expected=r.rowsExpected}}</span>
                  {{#unless r.verifyOk}}<button type="button" class="ui-icon" data-action="importMissing" data-id="{{r.id}}" title="{{localize 'SDE.importer.tableHub.reimportTip'}}" aria-label="{{localize 'SDE.importer.tableHub.reimport'}}"><i class="fas fa-rotate"></i></button>{{/unless}}{{/if}}{{/if}}
                {{#if r.isMissing}}<span class="ui-chip warn"><i class="fas fa-circle-exclamation"></i> {{localize "SDE.importer.tableHub.missing"}}</span>
                  <button type="button" class="ui-icon" data-action="importMissing" data-id="{{r.id}}" title="{{localize 'SDE.importer.tableHub.importTip'}}" aria-label="{{localize 'SDE.importer.btn.import'}}"><i class="fas fa-file-import"></i></button>{{/if}}
              {{/if}}
            </div>
            {{/each}}
          </div>
        </div>
        {{/each}}
      </div>
    </details>
    {{/each}}
  </div>

  {{!-- ═══ Import tab ═══ --}}
  <div class="ui-body sde-thub-tab"{{#unless tabImport}} hidden{{/unless}}>
    {{#if importData.seed}}
    <div class="ui-note info"><i class="fas fa-bullseye"></i> {{localize "SDE.importer.type.importing"}} <strong>{{importData.seed.name}}</strong>
      {{#if importData.seed.die}}<span class="ui-chip">{{importData.seed.die}}</span>{{/if}}{{#if importData.seed.page}}<span class="ui-chip">{{localize "SDE.importer.tableHub.page" page=importData.seed.page}}</span>{{/if}}
      {{localize "SDE.importer.tableHub.seedRest"}}</div>
    {{/if}}
    <label class="ui-field" for="sde-thub-import-text"><span class="ui-label">{{localize "SDE.importer.tableHub.pasteLabel"}}</span>
      <textarea id="sde-thub-import-text" data-import-text rows="{{#if importData.parsed.length}}4{{else}}9{{/if}}" placeholder="{{localize 'SDE.importer.tableHub.pastePlaceholder'}}">{{importData.text}}</textarea></label>
    <div class="ui-note"><i class="fas fa-link"></i> {{localize "SDE.importer.tableHub.autoLinkNote"}}</div>

    {{#if importData.parsed.length}}
    {{#each importData.parsed as |tbl|}}
    <div class="ui-card sde-import-table" data-table-idx="{{@index}}">
      <div class="imp-tablehead">
        <input type="text" data-import-field="name" value="{{tbl.name}}" aria-label="{{localize 'SDE.importer.tables.nameAria'}}" placeholder="{{localize 'SDE.importer.tables.nameAria'}}">
        <input type="text" data-import-field="formula" value="{{tbl.formula}}" aria-label="{{localize 'SDE.importer.tables.formulaAria'}}">
        <select data-import-field="category" aria-label="{{localize 'SDE.importer.tableHub.tableTypeAria'}}" data-tooltip="{{localize 'SDE.importer.tableHub.folderTip'}}" data-tooltip-direction="UP">{{#each @root.importData.categoryOptions as |opt|}}<option value="{{opt.id}}" {{#if (eq opt.id tbl.category)}}selected{{/if}}>{{opt.label}}</option>{{/each}}</select>
        {{#if (eq tbl.category "custom")}}<input type="text" data-import-field="customLabel" value="{{tbl.customLabel}}" aria-label="{{localize 'SDE.importer.tables.customAria'}}" placeholder="{{localize 'SDE.importer.tables.customPlaceholder'}}">{{/if}}
        <label class="ui-check" data-tooltip="{{localize 'SDE.importer.tableHub.replacementTip'}}" data-tooltip-direction="UP"><input type="checkbox" data-import-field="replacement" {{#if tbl.replacement}}checked{{/if}}> {{localize "SDE.importer.tables.replacement"}}</label>
        <button type="button" class="ui-btn" data-action="importCreate"><i class="fas fa-plus"></i> {{localize "SDE.importer.btn.create"}}</button>
      </div>
      {{#if tbl.bestEffort}}<div class="ui-note warn"><i class="fas fa-triangle-exclamation"></i> {{localize "SDE.importer.tables.bestEffort"}}</div>{{/if}}
      {{#if tbl.warnings.length}}<div class="ui-note warn"><ul class="imp-warnlist">{{#each tbl.warnings as |w|}}<li>{{w}}</li>{{/each}}</ul></div>{{/if}}
      <div class="imp-rows imp-scroll">
        {{#each tbl.rows as |row|}}
        <div class="imp-trow" data-row-idx="{{@index}}">
          <input type="number" data-import-field="min" value="{{row.min}}" aria-label="{{localize 'SDE.importer.tables.minAria'}}">
          <span class="ui-muted">&ndash;</span>
          <input type="number" data-import-field="max" value="{{row.max}}" aria-label="{{localize 'SDE.importer.tables.maxAria'}}">
          <input type="text" data-import-field="text" value="{{row.text}}" aria-label="{{localize 'SDE.importer.tables.resultAria'}}">
          {{#if row.link}}<span class="ui-chip gold" data-tooltip="{{localize 'SDE.importer.tables.linkTip'}}"><i class="fas fa-link"></i> {{row.link.name}}</span>
          <button type="button" class="ui-icon" data-action="importUnlinkRow" aria-label="{{localize 'SDE.importer.tables.unlinkAria'}}"><i class="fas fa-link-slash"></i></button>{{else}}<span></span><span></span>{{/if}}
          <button type="button" class="ui-icon danger" data-action="importDeleteRow" aria-label="{{localize 'SDE.importer.tables.delRowAria'}}"><i class="fas fa-xmark"></i></button>
        </div>
        {{/each}}
      </div>
      <div><button type="button" class="ui-btn" data-action="importAddRow"><i class="fas fa-plus"></i> {{localize "SDE.importer.tables.addRow"}}</button></div>
    </div>
    {{/each}}
    {{else}}
    <div class="ui-empty"><i class="fas fa-table-list"></i><span>{{{localize "SDE.importer.tableHub.empty"}}}</span></div>
    {{/if}}
  </div>

  {{#if tabImport}}
  <footer class="ui-footer">
    <button type="button" class="ui-btn ghost" data-action="importClear"><i class="fas fa-eraser"></i> {{localize "SDE.importer.btn.clear"}}</button>
    <div class="ui-right">
      <button type="button" class="ui-btn{{#unless importData.parsed.length}} primary sde-import-primary{{/unless}}" data-action="importParse"><i class="fas fa-wand-magic"></i> {{localize "SDE.importer.btn.parse"}}</button>
      {{#if importData.parsed.length}}<button type="button" class="ui-btn primary sde-import-primary" data-action="importCreateAll"><i class="fas fa-table-list"></i> {{localize "SDE.importer.tableHub.createAll" n=importData.parsed.length}}</button>{{/if}}
    </div>
  </footer>
  {{/if}}
</div>
